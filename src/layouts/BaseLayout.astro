---
const { title = "J 的世界 Research", description = "Facts First · Evidence-Based Research" } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0b1220" />
  <link rel="icon" href="/favicon.svg" />
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a class="brand" href="/">
        <span class="brand-mark">J</span>
        <span><strong>J 的世界</strong><small>RESEARCH</small></span>
      </a>
      <nav>
        <a href="/">首頁</a>
        <a href="/research">Research</a>
        <a href="/maps">Industry Maps</a>
        <a href="/posters">Posters</a>
        <a href="/downloads">Downloads</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div>
      <div class="footer-brand">J 的世界 Research</div>
      <p>Facts First · Evidence-Based Research</p>
    </div>
    <div class="footer-note">
      本網站內容僅供資訊分享與學習，不構成任何投資建議或投資進出場依據。
    </div>
    <div class="copyright">© 2026 J 的世界 Research. All Rights Reserved.</div>
  </footer>
</body>
</html>

<style is:global>
:root {
  --navy:#0b1220; --navy2:#111c2e; --paper:#f5f1e8; --white:#fff;
  --gold:#d7b56d; --muted:#718096; --line:#dfe3e8; --ink:#172033;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,"Noto Sans TC","Microsoft JhengHei",sans-serif;line-height:1.7}
a{color:inherit;text-decoration:none}
.site-header{position:sticky;top:0;z-index:10;background:rgba(11,18,32,.96);backdrop-filter:blur(12px);color:#fff}
.nav-wrap{max-width:1180px;margin:auto;padding:15px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:11px}
.brand-mark{width:38px;height:38px;border:1px solid var(--gold);display:grid;place-items:center;color:var(--gold);font-weight:800;font-size:20px}
.brand strong{display:block;font-size:16px;letter-spacing:.08em}
.brand small{display:block;font-size:9px;letter-spacing:.22em;color:#aab4c5}
nav{display:flex;gap:22px;font-size:13px;color:#dbe2ec}
nav a:hover{color:var(--gold)}
.hero{background:var(--navy);color:#fff}
.hero-inner{max-width:1180px;margin:auto;padding:88px 24px 96px;display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center}
.kicker{color:var(--gold);font-size:12px;letter-spacing:.2em;text-transform:uppercase}
.hero h1{font-size:clamp(42px,6vw,76px);line-height:1.08;margin:16px 0 18px;letter-spacing:-.04em}
.hero h1 span{color:var(--gold)}
.hero p{max-width:650px;color:#c6cfdd;font-size:18px}
.hero-card{min-height:330px;border:1px solid rgba(215,181,109,.55);padding:28px;background:linear-gradient(145deg,#17253b,#0b1220);position:relative}
.hero-card:before{content:"VOL.01";position:absolute;right:24px;top:20px;color:#68758a;font-size:11px;letter-spacing:.2em}
.hero-card h2{font-size:31px;line-height:1.25;margin:62px 0 14px}
.hero-card p{font-size:14px}
.section{max-width:1180px;margin:auto;padding:70px 24px}
.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px;gap:20px}
.section-head h2{font-size:30px;margin:0}
.section-head p{margin:0;color:var(--muted);font-size:14px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:#fff;border:1px solid var(--line);padding:25px;transition:.2s}
.card:hover{transform:translateY(-3px);border-color:#c8b07b}
.tag{display:inline-block;font-size:10px;letter-spacing:.14em;color:#80662d;background:#f1e7d0;padding:4px 8px}
.card h3{font-size:21px;line-height:1.35;margin:18px 0 8px}
.card p{color:#687386;font-size:14px;margin:0}
.number{font-size:12px;color:#9b8a62}
.feature{background:#111c2e;color:#fff}
.feature .section-head p{color:#aeb9c9}
.map-card{min-height:180px;background:linear-gradient(135deg,#16243a,#0c1423);border:1px solid #29384e;color:#fff;padding:26px}
.map-card h3{margin:35px 0 5px;color:#fff}
.map-card p{color:#aeb9c9;font-size:13px}
.poster-placeholder{aspect-ratio:16/10;background:linear-gradient(135deg,#d8d0bf,#f8f5ee);border:1px solid #d1c8b6;display:grid;place-items:center;color:#665d50;font-size:12px;letter-spacing:.15em}
.cta{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.cta-inner{max-width:1180px;margin:auto;padding:58px 24px;display:flex;justify-content:space-between;align-items:center;gap:30px}
.button{display:inline-block;background:var(--navy);color:#fff;padding:11px 18px;font-size:13px}
.site-footer{background:#080e18;color:#aeb8c7;padding:42px 24px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:30px;max-width:none}
.footer-brand{color:#fff;font-size:18px;font-weight:700}
.footer-note{font-size:12px}
.copyright{text-align:right;font-size:11px}
.page-hero{background:var(--navy);color:#fff;padding:70px 24px}
.page-hero-inner{max-width:1180px;margin:auto}
.page-hero h1{font-size:52px;margin:8px 0}
.page-hero p{color:#b8c2d0}
.article{max-width:850px;margin:auto;padding:70px 24px;background:#fff}
.article h2{font-size:28px;margin-top:40px}
.article .lead{font-size:20px;color:#4e5b6d}
@media(max-width:800px){
  nav{display:none}.hero-inner{grid-template-columns:1fr;gap:35px;padding-top:60px}
  .grid{grid-template-columns:1fr}.site-footer{grid-template-columns:1fr}.copyright{text-align:left}
  .cta-inner{display:block}.cta-inner .button{margin-top:18px}.page-hero h1{font-size:40px}
}
</style>