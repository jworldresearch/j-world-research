---
import "../styles/global.css";

const { title = "J 的世界 Research" } = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
  { label: "Research", href: "/research" },
  { label: "Industry Maps", href: "/maps" },
  { label: "Downloads", href: "/downloads" },
  { label: "Posters", href: "/posters" },
  { label: "About", href: "/about" },
];

const isActive = (href: string) => {
  if (href === "/research") {
    return pathname === "/research" || pathname.startsWith("/research/");
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="J 的世界 Research｜Facts First · Evidence-Based Research"
  />

  <meta
    name="theme-color"
    content="#0b1017"
  />

  <title>{title}</title>
</head>

<body>

  <!-- =========================================
       GLOBAL NAVIGATION
       ========================================= -->

  <nav class="nav">

    <div class="nav-inner">

      <a
        class="brand"
        href="/"
        aria-label="J 的世界 Research 首頁"
      >
        <span>J 的世界 Research</span>
        <small>
          FACTS FIRST · EVIDENCE-BASED RESEARCH
        </small>
      </a>


      <div
        class="nav-links"
        aria-label="主要導覽"
      >

        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={{
                active: isActive(item.href),
              }}
              aria-current={
                isActive(item.href) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          ))
        }

      </div>

    </div>

  </nav>


  <!-- =========================================
       PAGE CONTENT
       ========================================= -->

  <main>
    <slot />
  </main>


  <!-- =========================================
       FOOTER
       ========================================= -->

  <footer>

    <div class="footer-inner">

      <div class="footer-brand">
        <strong>J 的世界 Research</strong>

        <span>
          Facts First · Evidence-Based Research
        </span>
      </div>


      <div class="footer-links">

        {
          navItems.map((item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ))
        }

      </div>


      <div class="footer-note">

        <span>
          © 2026 J 的世界 Research
        </span>

        <span>
          資訊分享與研究學習用途，不作為投資進出場依據。
        </span>

      </div>

    </div>

  </footer>


  <!-- =========================================
       GLOBAL LAYOUT STYLE
       V1.1-09
       ========================================= -->

  <style is:global>

    :root {
      font-family:
        Arial,
        "Noto Sans TC",
        "Microsoft JhengHei",
        sans-serif;

      color: #eef2f7;

      background: #0b1017;

      line-height: 1.7;

      font-synthesis: none;

      text-rendering: optimizeLegibility;
    }


    * {
      box-sizing: border-box;
    }


    html {
      margin: 0;
      padding: 0;
      background: #0b1017;
      scroll-behavior: smooth;
    }


    body {
      margin: 0;
      min-width: 320px;

      background:
        linear-gradient(
          180deg,
          #0b1017 0%,
          #101823 55%,
          #0b1017 100%
        );

      color: #eef2f7;
    }


    img {
      max-width: 100%;
      height: auto;
      display: block;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }


    /* =========================================
       NAVIGATION
       ========================================= */

    .nav {
      position: sticky;
      top: 0;
      z-index: 100;

      width: 100%;

      background:
        rgba(11, 16, 23, 0.94);

      border-bottom: 1px solid #263242;

      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }


    .nav-inner {
      width: 100%;
      max-width: 1180px;

      margin: 0 auto;

      padding:
        15px 24px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 28px;
    }


    /* =========================================
       BRAND
       ========================================= */

    .brand {
      flex: 0 0 auto;

      display: inline-flex;

      flex-direction: column;

      justify-content: center;

      min-width: max-content;

      line-height: 1.2;
    }


    .brand > span {
      font-size: 17px;

      font-weight: 800;

      letter-spacing: 0.04em;

      color: #f1f4f7;
    }


    .brand small {
      display: block;

      margin-top: 5px;

      color: #7f8c9c;

      font-size: 9px;

      font-weight: 600;

      letter-spacing: 0.13em;

      white-space: nowrap;
    }


    /* =========================================
       DESKTOP NAV
       ========================================= */

    .nav-links {
      flex: 1 1 auto;

      display: flex;

      align-items: center;

      justify-content: flex-end;

      gap: 4px;

      overflow-x: auto;

      scrollbar-width: none;

      -ms-overflow-style: none;
    }


    .nav-links::-webkit-scrollbar {
      display: none;
    }


    .nav-links a {
      flex: 0 0 auto;

      position: relative;

      padding:
        9px 11px;

      border-radius: 8px;

      color: #9faab8;

      font-size: 13px;

      font-weight: 600;

      letter-spacing: 0.01em;

      white-space: nowrap;

      transition:
        color 0.2s ease,
        background 0.2s ease;
    }


    .nav-links a:hover {
      color: #ffffff;

      background: rgba(255,255,255,0.04);
    }


    .nav-links a.active {
      color: #f4f7fa;

      background: rgba(255,255,255,0.07);
    }


    .nav-links a.active::after {
      content: "";

      position: absolute;

      left: 11px;
      right: 11px;
      bottom: 4px;

      height: 2px;

      border-radius: 2px;

      background: #9db4ca;
    }


    /* =========================================
       MAIN
       ========================================= */

    main {
      min-height: calc(100vh - 180px);
    }


    /* =========================================
       HERO
       ========================================= */

    .hero {
      border-bottom: 1px solid #263242;

      background:
        radial-gradient(
          circle at 80% 20%,
          #263b53 0,
          transparent 35%
        );
    }


    .hero-inner {
      width: 100%;
      max-width: 1180px;

      margin: auto;

      padding:
        90px 24px 84px;

      display: grid;

      grid-template-columns:
        1.25fr 0.75fr;

      gap: 56px;

      align-items: center;
    }


    .kicker,
    .tag {
      font-size: 12px;

      letter-spacing: 0.14em;

      color: #8fa6bf;

      font-weight: 800;
    }


    .hero h1 {
      font-size:
        clamp(44px, 7vw, 78px);

      line-height: 1.08;

      margin:
        14px 0 22px;

      letter-spacing: -0.04em;
    }


    .hero h1 span {
      color: #b8c8d9;
    }


    .hero p,
    .card p,
    .hero-card p {
      color: #aeb9c6;
    }


    /* =========================================
       CARDS
       ========================================= */

    .hero-card,
    .card,
    .map-card {
      border:
        1px solid #2b394a;

      background:
        rgba(18, 27, 38, 0.82);

      border-radius: 18px;

      padding: 28px;
    }


    .hero-card h2 {
      font-size: 32px;

      margin:
        12px 0;
    }


    /* =========================================
       BUTTON
       ========================================= */

    .button {
      display: inline-block;

      background: #e9eef4;

      color: #0b1017;

      padding:
        10px 16px;

      border-radius: 9px;

      font-weight: 800;

      font-size: 14px;

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }


    .button:hover {
      opacity: 0.9;

      transform: translateY(-1px);
    }


    .button-secondary {
      display: inline-block;

      border:
        1px solid #3a4a5e;

      background:
        rgba(18, 28, 40, 0.8);

      color: #c4cfda;

      padding:
        9px 14px;

      border-radius: 8px;

      font-size: 13px;

      font-weight: 700;

      transition:
        border-color 0.2s ease,
        color 0.2s ease,
        background 0.2s ease;
    }


    .button-secondary:hover {
      color: #ffffff;

      border-color: #60748a;

      background:
        rgba(28, 42, 58, 0.9);
    }


    /* =========================================
       SECTIONS
       ========================================= */

    .section {
      width: 100%;
      max-width: 1180px;

      margin: auto;

      padding:
        72px 24px;
    }


    .section-head {
      display: flex;

      justify-content: space-between;

      align-items: end;

      gap: 25px;

      margin-bottom: 30px;
    }


    .section h2 {
      font-size: 34px;

      margin:
        6px 0;
    }


    .section-head p {
      color: #8491a1;
    }


    /* =========================================
       GRID
       ========================================= */

    .grid {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 18px;
    }


    .card h3,
    .map-card h3 {
      margin:
        10px 0 5px;

      font-size: 20px;
    }


    .feature {
      background: #0e151e;

      border-top:
        1px solid #263242;

      border-bottom:
        1px solid #263242;
    }


    .number {
      font-size: 13px;

      color: #7f9bb7;

      font-weight: 800;

      letter-spacing: 0.12em;
    }


    /* =========================================
       CTA
       ========================================= */

    .cta {
      border-top:
        1px solid #263242;
    }


    .cta-inner {
      width: 100%;
      max-width: 1180px;

      margin: auto;

      padding:
        70px 24px;

      display: flex;

      justify-content: space-between;

      align-items: center;

      gap: 30px;
    }


    .cta h2 {
      font-size: 38px;

      margin:
        8px 0;
    }


    /* =========================================
       PAGE HERO
       ========================================= */

    .page-hero {
      border-bottom:
        1px solid #263242;
    }


    .page-hero-inner {
      width: 100%;
      max-width: 1180px;

      margin: auto;

      padding:
        72px 24px;
    }


    .page-hero h1 {
      font-size: 56px;

      line-height: 1.15;

      margin:
        8px 0;
    }


    .page-hero p {
      color: #aeb9c6;

      max-width: 850px;
    }


    /* =========================================
       FOOTER
       ========================================= */

    footer {
      border-top:
        1px solid #263242;

      background:
        rgba(7, 11, 16, 0.7);

      color: #7f8b99;

      font-size: 12px;
    }


    .footer-inner {
      width: 100%;
      max-width: 1180px;

      margin: auto;

      padding:
        30px 24px;

      display: grid;

      grid-template-columns:
        1fr auto;

      gap:
        22px 40px;

      align-items: center;
    }


    .footer-brand {
      display: flex;

      flex-direction: column;

      gap: 3px;
    }


    .footer-brand strong {
      color: #b9c4cf;

      font-size: 13px;
    }


    .footer-brand span {
      color: #6f7b89;

      font-size: 10px;

      letter-spacing: 0.08em;
    }


    .footer-links {
      display: flex;

      flex-wrap: wrap;

      justify-content: flex-end;

      gap:
        8px 18px;
    }


    .footer-links a {
      color: #8995a3;

      transition:
        color 0.2s ease;
    }


    .footer-links a:hover {
      color: #ffffff;
    }


    .footer-note {
      grid-column:
        1 / -1;

      padding-top:
        15px;

      border-top:
        1px solid #202b39;

      display: flex;

      justify-content: space-between;

      gap: 20px;

      color: #687584;

      font-size: 11px;
    }


    /* =========================================
       TABLET
       ========================================= */

    @media (max-width: 900px) {

      .nav-inner {
        gap: 18px;
      }


      .brand > span {
        font-size: 16px;
      }


      .nav-links {
        justify-content: flex-start;

        gap: 2px;
      }


      .nav-links a {
        padding:
          9px 10px;
      }


      .hero-inner {
        grid-template-columns: 1fr;

        padding-top:
          65px;
      }


      .grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }


      .footer-inner {
        grid-template-columns: 1fr;
      }


      .footer-links {
        justify-content: flex-start;
      }


      .footer-note {
        grid-column: auto;

        flex-direction: column;

        gap: 6px;
      }

    }


    /* =========================================
       MOBILE
       ========================================= */

    @media (max-width: 800px) {

      .nav {
        position: sticky;
      }


      .nav-inner {
        display: block;

        padding:
          13px 16px 10px;
      }


      .brand {
        display: flex;

        width: 100%;

        align-items: flex-start;

        margin-bottom: 10px;
      }


      .brand > span {
        font-size: 16px;
      }


      .brand small {
        font-size: 8px;

        letter-spacing: 0.1em;
      }


      /*
       * 重要：
       * 手機不再 display:none。
       * 改成可左右滑動的完整導覽列。
       */

      .nav-links {
        width: 100%;

        display: flex;

        justify-content: flex-start;

        gap: 4px;

        overflow-x: auto;

        overflow-y: hidden;

        padding-bottom: 2px;

        scrollbar-width: none;
      }


      .nav-links::-webkit-scrollbar {
        display: none;
      }


      .nav-links a {
        flex: 0 0 auto;

        padding:
          7px 10px;

        font-size: 12px;

        border:
          1px solid transparent;

        border-radius: 7px;
      }


      .nav-links a.active {
        border-color:
          #354457;

        background:
          rgba(255,255,255,0.06);
      }


      .nav-links a.active::after {
        left: 10px;
        right: 10px;
        bottom: 3px;
      }


      .hero-inner {
        padding:
          58px 18px 60px;
      }


      .hero h1 {
        font-size:
          clamp(40px, 12vw, 60px);
      }


      .section {
        padding:
          56px 18px;
      }


      .section-head {
        display: block;

        margin-bottom: 24px;
      }


      .section-head > p {
        margin-top: 10px;
      }


      .section h2 {
        font-size: 29px;
      }


      .grid {
        grid-template-columns: 1fr;

        gap: 15px;
      }


      .card,
      .map-card,
      .hero-card {
        padding: 23px;
      }


      .page-hero-inner {
        padding:
          52px 18px;
      }


      .page-hero h1 {
        font-size:
          clamp(38px, 11vw, 48px);
      }


      .cta-inner {
        display: block;

        padding:
          56px 18px;
      }


      .cta h2 {
        font-size:
          30px;
      }


      .cta .button {
        margin-top:
          20px;
      }


      .footer-inner {
        padding:
          25px 18px;
      }


      .footer-links {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap:
          8px 15px;
      }


      .footer-note {
        font-size: 10px;
      }

    }


    /* =========================================
       SMALL MOBILE
       ========================================= */

    @media (max-width: 420px) {

      .nav-inner {
        padding-left: 13px;
        padding-right: 13px;
      }


      .brand > span {
        font-size: 15px;
      }


      .brand small {
        font-size: 7px;
      }


      .nav-links a {
        padding:
          7px 9px;

        font-size: 11px;
      }


      .page-hero h1 {
        font-size: 38px;
      }


      .section h2 {
        font-size: 27px;
      }

    }

  </style>

</body>
</html>
