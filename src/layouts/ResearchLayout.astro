x 0}.lead-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:22px;align-items:stretch}.lead-visual{min-height:330px;border:1px solid #2c3d49;background:linear-gradient(145deg,#102330,#071118);position:relative;overflow:hidden}.lead-visual:before{content:"";position:absolute;inset:12%;border:1px solid rgba(220,176,90,.22);transform:rotate(-8deg)}.lead-visual:after{content:"";position:absolute;width:420px;height:420px;border-radius:50%;border:1px solid rgba(102,175,210,.22);right:-130px;bottom:-160px;box-shadow:0 0 0 55px rgba(100,170,205,.04),0 0 0 110px rgba(100,170,205,.025)}.visual-label{position:absolute;left:24px;top:22px;font-size:10px;letter-spacing:.18em;color:#dcb05a}.visual-big{position:absolute;left:24px;bottom:22px;font-size:clamp(2.8rem,6vw,6rem);font-weight:850;line-height:.8;color:#eef3f5;letter-spacing:-.05em}.visual-big em{color:#dcb05a;font-style:normal}.visual-lines{position:absolute;right:22%;top:25%;width:45%;height:1px;background:#547587;transform:rotate(-27deg);box-shadow:0 42px #314f60,0 84px #273f4e}.lead-note{border:1px solid #2c3d49;background:#0b151e;padding:26px;display:flex;flex-direction:column;justify-content:center}.lead-note .tag{font-size:10px;letter-spacing:.18em;color:#dcb05a}.lead-note h2{font-size:28px;line-height:1.2;margin:10px 0 12px}.lead-note p{color:#aeb9c1;margin:0}.quote{margin:24px 0 0;padding:22px 26px;border-left:3px solid #dcb05a;background:#0c1720;font-size:20px;line-height:1.55;color:#e6ebee}.quote strong{color:#dcb05a}.section{margin-top:42px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.section-head .eyebrow{font-size:10px;letter-spacing:.18em;color:#7f8f9b}.section-head h2{margin:4px 0 0;font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.08}.section-head p{max-width:560px;margin:0;color:#8e9ca5;font-size:13px}.editorial-grid{display:grid;gap:14px}.editorial-grid.two{grid-template-columns:repeat(2,1fr)}.editorial-grid.three{grid-template-columns:repeat(3,1fr)}.editorial-grid.four{grid-template-columns:repeat(4,1fr)}.editorial-card{border:1px solid #2a3a46;background:linear-gradient(180deg,#0d1922,#09131b);padding:22px;min-height:170px;position:relative}.editorial-card .num{font-size:34px;color:#dcb05a;font-weight:800;line-height:1}.editorial-card h3{font-size:18px;margin:12px 0 8px}.editorial-card p{margin:0;color:#9eabb4;font-size:13px}.editorial-card .bottom-line{margin-top:16px;padding-top:10px;border-top:1px solid #293944;font-size:10px;letter-spacing:.12em;color:#d6dde1}.flow{display:flex;align-items:stretch;justify-content:center;gap:0;margin:22px 0}.flow-node{flex:1;border:1px solid #30424e;background:#0c1821;padding:20px 12px;text-align:center;position:relative}.flow-node:not(:last-child):after{content:"→";position:absolute;right:-15px;top:50%;transform:translateY(-50%);z-index:2;color:#dcb05a;font-size:18px;background:#071018;padding:0 4px}.flow-node b{display:block;font-size:12px;color:#e9edf0}.flow-node span{display:block;margin-top:7px;font-size:10px;color:#7f8e98}.matrix{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #30414c;border-left:1px solid #30414c}.matrix .cell{min-height:150px;border-right:1px solid #30414c;border-bottom:1px solid #30414c;padding:22px;background:#0a151e}.matrix .cell b{display:block;color:#dcb05a;font-size:10px;letter-spacing:.13em}.matrix .cell h3{margin:8px 0 7px;font-size:17px}.matrix .cell p{margin:0;color:#98a6af;font-size:12px}.watch-line{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin:25px 0 8px}.watch-step{padding:16px;border-top:2px solid #334854;position:relative}.watch-step:before{content:"";position:absolute;top:-6px;left:16px;width:9px;height:9px;border-radius:50%;background:#dcb05a}.watch-step b{display:block;color:#dcb05a;font-size:10px;letter-spacing:.14em}.watch-step h3{margin:8px 0;font-size:17px}.watch-step p{margin:0;color:#98a6af;font-size:12px}.method-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.method-card{border:1px solid #2b3b46;padding:24px;background:#0b161f}.method-card h3{margin:0 0 9px;font-size:19px}.method-card p{margin:0;color:#9ca9b2;font-size:13px}.method-card.gold{border-color:#6e572c;background:linear-gradient(135deg,#17170f,#0b151d)}.disclaimer{margin-top:18px;border-left:3px solid #667680;padding:18px 20px;background:#09131b;color:#8f9da6;font-size:12px}.research-footer-nav{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:26px 0 38px;border-top:1px solid #2a3946}.footer-path{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:9px;letter-spacing:.12em;color:#71818c}.footer-path span{color:#dcb05a;margin-right:8px}.footer-path i{color:#4e626f;font-style:normal}.footer-links{display:flex;gap:18px;margin-top:20px;flex-wrap:wrap}.footer-links a{font-size:11px;color:#aab5bc}.footer-links a:hover{color:#dcb05a}.footer-brand{margin-top:22px;color:#5e6c76;font-size:9px;letter-spacing:.14em}.cta-editorial{margin-top:42px;padding:28px;border:1px solid #6b552e;background:linear-gradient(120deg,#15160f,#0b141b);display:flex;justify-content:space-between;align-items:center;gap:20px}.cta-editorial h2{margin:4px 0 0;font-size:26px}.cta-editorial p{margin:0;color:#929fa7;font-size:12px}.button{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;border:1px solid #dcb05a;color:#e9c97e;font-size:11px;letter-spacing:.08em}.button:hover{background:#dcb05a;color:#081018}

/* V1.5 · EDITORIAL MAGAZINE SYSTEM */
.research-content{max-width:1120px!important;padding-bottom:48px!important}
.editorial-page{max-width:1000px;margin:0 auto;padding-top:34px}
.page-title{font-size:clamp(2.15rem,4.2vw,4.15rem)!important;line-height:1.04!important;letter-spacing:-.035em!important;max-width:900px;margin:12px auto 16px!important}
.page-subtitle{font-size:clamp(1rem,1.35vw,1.18rem)!important;line-height:1.65!important;max-width:820px!important;margin:0 auto!important;color:#c0cad1!important}
.page-meta{justify-content:center;font-size:10px!important}
.lead-grid{grid-template-columns:minmax(0,1.28fr) minmax(300px,.72fr);gap:18px;margin-top:24px}
.lead-visual{min-height:360px;border-radius:2px;background:linear-gradient(135deg,#101f2b,#071118 68%,#0c1922)!important;box-shadow:inset 0 0 0 1px rgba(255,255,255,.025)}
.lead-note{padding:30px!important;border-radius:2px}
.lead-note h2{font-size:clamp(1.25rem,1.8vw,1.7rem)!important;line-height:1.42!important}
.lead-note p,.editorial-card p,.matrix .cell p,.watch-step p,.method-card p{font-size:clamp(.94rem,1.05vw,1.02rem)!important;line-height:1.82!important}
.section{margin-top:48px!important}
.section-head{justify-content:center!important;text-align:center!important;margin-bottom:20px!important}
.section-head h2{font-size:clamp(1.35rem,2vw,1.95rem)!important;line-height:1.3!important}
.section-head .eyebrow{font-size:10px!important}
.quote{font-size:clamp(1.03rem,1.45vw,1.28rem)!important;line-height:1.8!important;padding:22px 28px!important}
.editorial-card{padding:24px!important;min-height:190px!important}
.editorial-card h3{font-size:clamp(1.05rem,1.35vw,1.22rem)!important;line-height:1.4!important}
.editorial-card .num{font-size:30px!important}
.flow-node{padding:22px 12px!important;min-height:100px}
.flow-node b{font-size:12px!important}.flow-node span{font-size:11px!important}
.matrix .cell{padding:24px!important}.matrix .cell h3{font-size:1.15rem!important}.matrix .cell p{font-size:.95rem!important}
.watch-step h3{font-size:1.12rem!important}.watch-step p{font-size:.94rem!important}
/* explanatory reading block */
.j-insight{margin:28px auto 0;max-width:920px;border:1px solid #5f4d2e;background:linear-gradient(135deg,rgba(220,176,90,.09),rgba(9,19,27,.94));padding:24px 28px;text-align:left}
.j-insight .insight-label{display:inline-block;color:#e4bd6c;font-size:10px;font-weight:800;letter-spacing:.18em;margin-bottom:9px}
.j-insight h3{margin:0 0 8px;font-size:1.18rem;line-height:1.45;color:#f0d28d}
.j-insight p{margin:0;color:#c0cbd2;font-size:clamp(.96rem,1.1vw,1.04rem);line-height:1.9}
.j-insight small{display:block;margin-top:12px;color:#71818c;font-size:.78rem;line-height:1.6}
/* page-turn */
.page-turn{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:stretch;margin:6px 0 30px;padding:18px 0 22px;border-bottom:1px solid #2a3946}
.turn{border:1px solid #2b3c48;background:#0b151e;padding:14px 18px;min-height:68px;display:flex;flex-direction:column;justify-content:center;transition:.2s}
.turn:hover{border-color:#dcb05a;background:#101d27}.turn span{font-size:9px;letter-spacing:.16em;color:#dcb05a}.turn strong{font-size:12px;margin-top:4px;color:#dce4e8}.turn-prev{text-align:left}.turn-next{text-align:right}.turn-library{display:flex;align-items:center;justify-content:center;padding:0 18px;color:#9caab3;font-size:10px;letter-spacing:.12em;border:1px solid #293a45}.turn-library:hover{color:#dcb05a;border-color:#6c5831}.turn-empty{visibility:hidden;border:0;background:transparent}
/* visual icon language */
.visual-label{z-index:4}.visual-icon-grid{position:absolute;inset:58px 34px 34px;display:grid;gap:10px;z-index:2}.visual-icon-grid.four{grid-template-columns:repeat(2,1fr)}.visual-icon-grid.six{grid-template-columns:repeat(3,1fr)}
.vicon{border:1px solid rgba(220,176,90,.32);background:rgba(8,18,25,.58);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px;text-align:center}.vicon .symbol{font-size:24px;font-weight:850;color:#e7edf0;line-height:1}.vicon b{font-size:9px;letter-spacing:.1em;color:#dcb05a}.vicon small{font-size:8px;color:#71828e}
.visual-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:4;text-align:center}.visual-center .core{width:128px;height:128px;border-radius:50%;border:1px solid rgba(220,176,90,.6);display:flex;align-items:center;justify-content:center;background:rgba(7,16,24,.88);box-shadow:0 0 0 18px rgba(220,176,90,.04),0 0 0 38px rgba(90,150,180,.035)}.visual-center b{font-size:14px;letter-spacing:.08em}.visual-center small{display:block;margin-top:6px;color:#dcb05a;font-size:8px;letter-spacing:.14em}
.visual-stack{position:absolute;inset:58px 46px 38px;display:flex;flex-direction:column;justify-content:center;gap:9px;z-index:2}.visual-stack .bar{height:44px;border:1px solid rgba(220,176,90,.35);display:flex;align-items:center;justify-content:center;letter-spacing:.12em;font-size:10px;background:rgba(10,24,33,.72)}.visual-stack .bar:nth-child(2){margin:0 18px}.visual-stack .bar:nth-child(3){margin:0 36px}.visual-stack .bar:nth-child(4){margin:0 54px;background:rgba(220,176,90,.08)}
.visual-road{position:absolute;left:38px;right:38px;top:50%;height:2px;background:#526f7e;z-index:2}.visual-road .dot{position:absolute;top:50%;transform:translate(-50%,-50%);width:18px;height:18px;border-radius:50%;border:2px solid #dcb05a;background:#071018}.visual-road .label{position:absolute;top:24px;transform:translateX(-50%);font-size:8px;letter-spacing:.1em;color:#aebbc2;white-space:nowrap}
.visual-rings{position:absolute;inset:55px;display:flex;align-items:center;justify-content:center;z-index:2}.visual-rings .ring{position:absolute;border:1px solid rgba(220,176,90,.34);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;letter-spacing:.12em}.visual-rings .r1{width:95px;height:95px}.visual-rings .r2{width:175px;height:175px;border-color:rgba(98,165,200,.3)}.visual-rings .r3{width:255px;height:255px;border-color:rgba(220,176,90,.18)}.visual-rings .center{width:48px;height:48px;border-radius:50%;background:#dcb05a;color:#071018;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:11px;z-index:2}
@media(max-width:850px){
  .editorial-page{max-width:100%;padding-top:26px}.lead-grid{grid-template-columns:1fr}.lead-visual{min-height:310px}.lead-note{min-height:230px}.page-title{font-size:clamp(2rem,8vw,3.2rem)!important}.editorial-grid.four,.editorial-grid.three,.editorial-grid.two{grid-template-columns:1fr 1fr}.matrix{grid-template-columns:1fr 1fr}.watch-line{grid-template-columns:1fr 1fr}.page-turn{grid-template-columns:1fr 1fr}.turn-library{grid-column:1 / -1;grid-row:2;min-height:48px}.turn-next{text-align:right}.turn-prev{text-align:left}
}
@media(max-width:560px){.editorial-grid.four,.editorial-grid.three,.editorial-grid.two,.matrix,.watch-line{grid-template-columns:1fr}.page-meta{gap:9px;line-height:1.5}.j-insight{padding:20px}.visual-icon-grid.six{grid-template-columns:repeat(2,1fr)}.page-turn{gap:8px}.turn{padding:12px}.turn strong{font-size:11px}}

@media(max-width:850px){.research-header{grid-template-columns:1fr;gap:7px}.header-right{text-align:left}.chapter-nav{grid-template-columns:repeat(4,1fr)}.chapter-nav a:nth-child(n+5){border-top:1px solid #263541}.lead-grid,.method-grid{grid-template-columns:1fr}.editorial-grid.three{grid-template-columns:1fr}.editorial-grid.four{grid-template-columns:repeat(2,1fr)}.matrix{grid-template-columns:repeat(2,1fr)}.flow{overflow-x:auto;justify-content:flex-start}.flow-node{min-width:180px}.watch-line{grid-template-columns:repeat(2,1fr);gap:0 8px}.cta-editorial{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.research-header,.chapter-nav,.research-content,.research-footer-nav{width:min(100% - 24px,1180px)}.chapter-nav a strong{font-size:10px}.page-title{font-size:clamp(2.4rem,13vw,4rem)}.lead-visual{min-height:250px}.editorial-grid.four,.matrix,.watch-line{grid-template-columns:1fr}.quote{font-size:17px}.flow-node{min-width:155px}}
</style>
