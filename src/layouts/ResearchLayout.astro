---
interface Props {
  title?: string;
  page?: string;
  signal?: string;
  evidence?: string;
  focus?: string;
}

const {
  title = "AI Platform Evolution",
  page = "",
  signal = "",
  evidence = "",
  focus = ""
} = Astro.props;

const researchPages = [
  { id: "P1", title: "Story", href: "/research/p1/", theme: "EVENT" },
  { id: "P2", title: "Evidence", href: "/research/p2/", theme: "EVIDENCE" },
  { id: "P3", title: "AI Platform", href: "/research/p3/", theme: "EVOLUTION" },
  { id: "P4", title: "Technology", href: "/research/p4/", theme: "TECHNOLOGY" },
  { id: "P5", title: "Glass Core", href: "/research/p5/", theme: "SUPPLY CHAIN" },
  { id: "P6", title: "Investment Matrix", href: "/research/p6/", theme: "VALIDATION" },
  { id: "P7", title: "Future Watch", href: "/research/p7/", theme: "FUTURE" },
  { id: "P8", title: "Reference", href: "/research/p8/", theme: "METHODOLOGY" }
];

const currentIndex = researchPages.findIndex((item) => item.id === page);
const previousPage = currentIndex > 0 ? researchPages[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < researchPages.length - 1
  ? researchPages[currentIndex + 1]
  : null;
---

<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}｜J 的世界 Research</title>
  <meta name="description" content="J 的世界 Research｜Facts First · Evidence-Based Research" />

  <style is:global>
    * { box-sizing: border-box; }
    html { margin: 0; padding: 0; background: #0b1017; }
    body {
      margin: 0; padding: 0; color: #e8edf2;
      background: radial-gradient(circle at 50% -10%, rgba(75,95,115,.12), transparent 42%), #0b1017;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
      line-height: 1.6;
    }
    a { color: inherit; }

    .research-header { position: sticky; top: 0; z-index: 100; border-bottom: 1px solid rgba(255,255,255,.08); background: rgba(11,16,23,.94); backdrop-filter: blur(14px); }
    .header-inner { max-width: 1180px; min-height: 76px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
    .brand { display: flex; flex-direction: column; gap: 2px; text-decoration: none; white-space: nowrap; }
    .brand strong { font-size: .98rem; letter-spacing: -.02em; }
    .brand span { color: #687482; font-size: .52rem; font-weight: 700; letter-spacing: .13em; }
    .main-nav { display: flex; align-items: center; gap: 22px; }
    .main-nav a { color: #8995a3; font-size: .72rem; font-weight: 650; text-decoration: none; }
    .main-nav a:hover { color: #e7ecf0; }

    .page-navigation { border-bottom: 1px solid rgba(255,255,255,.07); }
    .page-navigation-inner { max-width: 1180px; margin: 0 auto; padding: 10px 24px; display: grid; grid-template-columns: repeat(8, 1fr); gap: 5px; }
    .page-link { min-height: 66px; padding: 9px 10px; border-radius: 7px; color: #697582; text-decoration: none; }
    .page-link:hover { background: rgba(255,255,255,.03); color: #c4cdd5; }
    .page-link.active { background: rgba(255,255,255,.06); color: #e5eaf0; }
    .page-id { display: block; font-size: .58rem; font-weight: 800; }
    .page-title { display: block; margin-top: 4px; font-size: .7rem; }
    .page-link small { display: block; margin-top: 5px; color: #596572; font-size: .5rem; letter-spacing: .08em; }

    /* =========================
       PAGE CONTENT COMPATIBILITY
       Keeps P4-P8's existing research markup
       visually aligned with the Research frame.
    ========================= */
    .research-content { max-width: 1180px; margin: 0 auto; padding: 55px 24px 75px; }
    .research-content { text-align: left; }
    .research-content > .page-hero { width: 100%; max-width: 900px; margin: 0 auto 34px; padding: 0; border: 0; background: transparent; }
    .research-content .page-hero-inner { width: 100%; max-width: 900px; margin: 0 auto; padding: 0; }
    .research-content .section { width: 100%; max-width: 900px; margin: 0 auto 58px; }
    /* V1.2-13: one 900px content rail for every research section. */
    .research-content .feature { width: 100%; max-width: 900px; margin: 0 auto 58px; padding: 0; background: rgba(255,255,255,.012); border: 1px solid rgba(255,255,255,.045); }
    .research-content .feature > .section { width: 100%; max-width: none; padding: 48px 24px; margin: 0; }
    .research-content .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 25px; margin-bottom: 24px; }
    .research-content .section-head > p { margin: 0; color: #65717e; font-size: .68rem; text-align: right; }
    .research-content .kicker { color: #7188a0; font-size: .62rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .research-content h1, .research-content h2, .research-content h3 { color: #e8edf2; }
    .research-content h2 { margin: 8px 0 0; font-size: clamp(1.45rem, 2.2vw, 2rem); line-height: 1.12; letter-spacing: -.035em; }
    .research-content h3 { line-height: 1.25; }
    .research-content p { color: #9ba8b5; font-size: .84rem; line-height: 1.85; }
    .research-content .page-hero p { max-width: 760px; margin: 0; color: #8f9cab; font-size: .92rem; }
    .research-content .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .research-content .card, .research-content .map-card { padding: 24px; border: 1px solid #2b394a; border-radius: 14px; background: #0d151f; }
    .research-content .map-card { min-height: 190px; }
    .research-content .card h3, .research-content .map-card h3 { margin: 10px 0 8px; font-size: 1.05rem; }
    .research-content .card p, .research-content .map-card p { margin: 8px 0 0; }
    .research-content .tag { display: inline-block; color: #7188a0; font-size: .58rem; font-weight: 800; letter-spacing: .1em; }
    .research-content .cta { max-width: 900px; margin: 10px auto 0; padding: 0; }
    .research-content .cta-inner { padding: 30px; border: 1px solid #354457; border-radius: 16px; background: linear-gradient(135deg, rgba(255,255,255,.035), rgba(255,255,255,.012)); display: flex; align-items: center; justify-content: space-between; gap: 30px; }
    .research-content .cta h2 { margin: 8px 0; }
    .research-content .cta p { margin: 0; }
    .research-content .button, .research-content .button-secondary { text-decoration: none; }
    .research-content .button { display: inline-block; flex: 0 0 auto; padding: 11px 17px; border: 1px solid #53677d; border-radius: 9px; color: #dbe2e8; font-size: .68rem; font-weight: 800; letter-spacing: .06em; background: #121c28; }
    .research-content .button:hover, .research-content .button-secondary:hover { border-color: #8a9caf; color: #fff; }

    .database-connection { border-top: 1px solid rgba(255,255,255,.09); }
    .connection-inner { max-width: 1180px; margin: 0 auto; padding: 55px 24px; }
    .connection-heading h2 { margin: 10px 0 15px; font-size: clamp(2rem, 5vw, 3.8rem); line-height: .98; letter-spacing: -.05em; }
    .connection-heading p { max-width: 680px; margin: 0; color: #8b97a4; font-size: .82rem; line-height: 1.85; }
    .connection-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 28px; }
    .connection-card { display: flex; flex-direction: column; min-height: 165px; padding: 20px; border: 1px solid rgba(255,255,255,.09); border-radius: 12px; background: rgba(255,255,255,.025); text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
    .connection-card:hover { border-color: rgba(255,255,255,.25); transform: translateY(-2px); }
    .connection-card .number { color: #5e6a77; font-size: .6rem; }
    .connection-card strong { margin-top: auto; font-size: .95rem; }
    .connection-card > span:not(.number) { margin-top: 5px; color: #788492; font-size: .68rem; }
    .connection-card small { margin-top: 18px; color: #626e7a; font-size: .56rem; letter-spacing: .06em; }

    .research-navigation { border-top: 1px solid rgba(255,255,255,.09); }
    .research-navigation-inner { max-width: 1180px; margin: 0 auto; padding: 25px 24px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; }
    .research-navigation a { text-decoration: none; }
    .previous { justify-self: start; } .next { justify-self: end; text-align: right; }
    .research-navigation a span { display: block; color: #65717e; font-size: .56rem; font-weight: 800; letter-spacing: .1em; }
    .research-navigation strong { display: block; margin-top: 5px; color: #aab4be; font-size: .7rem; }
    .library { padding: 9px 14px; border: 1px solid rgba(255,255,255,.1); border-radius: 999px; color: #8b97a4; font-size: .58rem; font-weight: 800; letter-spacing: .08em; }
    .library:hover { color: #e3e8ed; }

    .research-path { border-top: 1px solid rgba(255,255,255,.08); }
    .path-inner { max-width: 1180px; margin: 0 auto; padding: 35px 24px 45px; }
    .path { display: flex; align-items: center; gap: 9px; margin-top: 15px; overflow-x: auto; white-space: nowrap; }
    .path span { color: #707c89; font-size: .56rem; font-weight: 700; letter-spacing: .07em; }
    .path b { color: #4f5b67; font-size: .62rem; }
    .research-footer { border-top: 1px solid rgba(255,255,255,.08); }
    .footer-inner { max-width: 1180px; margin: 0 auto; padding: 26px 24px; display: flex; align-items: center; justify-content: space-between; gap: 25px; }
    .footer-inner > div:first-child { display: flex; flex-direction: column; gap: 3px; }
    .footer-inner strong { font-size: .72rem; } .footer-inner span { color: #626e7b; font-size: .58rem; }
    .footer-links { display: flex; gap: 18px; } .footer-links a { color: #687481; font-size: .62rem; text-decoration: none; }

    /* =========================
       V1.2-09 · CENTERED RESEARCH SYSTEM
       P1-P8 content uses one consistent centered alignment.
    ========================= */
    .research-content,
    .research-content * {
      text-align: center;
    }

    .research-content .page-hero-inner,
    .research-content .section,
    .research-content .cta,
    .research-content .cta-inner {
      margin-left: auto;
      margin-right: auto;
    }

    .research-content .page-hero-inner {
      max-width: 900px;
    }

    .research-content .page-hero h1,
    .research-content .page-hero p {
      margin-left: auto;
      margin-right: auto;
    }

    .research-content .page-hero p {
      max-width: 760px;
    }

    .research-content .section-head {
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 8px;
    }

    .research-content .section-head > p {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .research-content .grid {
      justify-items: stretch;
    }

    .research-content .card,
    .research-content .map-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
    }

    .research-content .card p,
    .research-content .map-card p {
      margin-left: auto;
      margin-right: auto;
    }

    .research-content .technology-flow,
    .research-content .glass-flow,
    .research-content .evidence-chain,
    .research-content .signal-flow,
    .research-content .scale-flow,
    .research-content .timeline {
      justify-content: center;
      margin-left: auto;
      margin-right: auto;
    }

    .research-content .technology-flow .node,
    .research-content .glass-flow .glass-node,
    .research-content .timeline > div {
      text-align: center;
    }

    .research-content .cta-inner {
      justify-content: center;
      align-items: center;
      flex-direction: column;
    }

    .research-content .cta-inner > div {
      width: 100%;
    }

    .research-content .button,
    .research-content .button-secondary {
      margin-left: auto;
      margin-right: auto;
    }

    @media (max-width: 900px) {
      .page-navigation-inner { grid-template-columns: repeat(4, 1fr); }
      .connection-grid { grid-template-columns: 1fr 1fr; }
      .research-content .grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 700px) {
      .main-nav { display: none; }
      .page-navigation-inner { grid-template-columns: repeat(2, 1fr); padding: 8px 18px; }
      .research-content { padding: 42px 18px 55px; }
      .research-content .feature { width: 100%; margin-left: auto; margin-right: auto; padding-left: 0; padding-right: 0; }
      .research-content .feature > .section { padding-left: 18px; padding-right: 18px; }
      .research-content .section-head { align-items: flex-start; flex-direction: column; }
      .research-content .section-head > p { text-align: left; }
      .research-content .grid { grid-template-columns: 1fr; }
      .research-content .cta-inner { align-items: flex-start; flex-direction: column; }
      .connection-inner, .path-inner { padding-left: 18px; padding-right: 18px; }
      .connection-grid { grid-template-columns: 1fr; }
      .research-navigation-inner { padding: 20px 18px; }
      .footer-inner { padding: 24px 18px; align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>

<body>
  <header class="research-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <strong>J 的世界 Research</strong>
        <span>FACTS FIRST · EVIDENCE-BASED RESEARCH</span>
      </a>
      <nav class="main-nav">
        <a href="/research/">Research</a>
        <a href="/companies/">Companies</a>
        <a href="/maps/">Industry Maps</a>
        <a href="/downloads/">Downloads</a>
        <a href="/posters/">Posters</a>
        <a href="/about/">About</a>
      </nav>
    </div>
  </header>

  <section class="page-navigation">
    <div class="page-navigation-inner">
      {researchPages.map((item) => (
        <a href={item.href} class:list={["page-link", { active: item.id === page }]}>
          <span class="page-id">{item.id}</span>
          <span class="page-title">{item.title}</span>
          <small>{item.theme}</small>
        </a>
      ))}
    </div>
  </section>

  <main class="research-content">
    <slot />
  </main>

  <section class="database-connection">
    <div class="connection-inner">
      <div class="connection-heading">
        <span class="label">RESEARCH DATABASE</span>
        <h2>From Research<br />to Intelligence</h2>
        <p>本研究不只記錄事件與技術，同時將研究內容連接至企業與產業鏈，建立可持續更新的 Research Database。</p>
      </div>
      <div class="connection-grid">
        <a href="/companies/" class="connection-card"><span class="number">01</span><strong>Companies</strong><span>企業資料庫</span><small>Research → Company →</small></a>
        <a href="/maps/" class="connection-card"><span class="number">02</span><strong>Industry Maps</strong><span>產業鏈地圖</span><small>Company → Supply Chain →</small></a>
        <a href="/posters/" class="connection-card"><span class="number">03</span><strong>Posters</strong><span>視覺研究</span><small>Research → Visual →</small></a>
        <a href="/downloads/" class="connection-card"><span class="number">04</span><strong>First Printing</strong><span>出版級研究</span><small>Research → PDF →</small></a>
      </div>
    </div>
  </section>

  <section class="research-navigation">
    <div class="research-navigation-inner">
      {previousPage ? <a href={previousPage.href} class="previous"><span>← PREVIOUS</span><strong>{previousPage.id} · {previousPage.title}</strong></a> : <div></div>}
      <a href="/research/" class="library">RESEARCH LIBRARY</a>
      {nextPage ? <a href={nextPage.href} class="next"><span>NEXT →</span><strong>{nextPage.id} · {nextPage.title}</strong></a> : <div></div>}
    </div>
  </section>

  <section class="research-path">
    <div class="path-inner">
      <span class="label">RESEARCH PATH</span>
      <div class="path">
        <span>EVENT</span><b>→</b><span>EVIDENCE</span><b>→</b><span>TECHNOLOGY</span><b>→</b><span>COMPANY</span><b>→</b><span>SUPPLY CHAIN</span><b>→</b><span>VALIDATION</span><b>→</b><span>PRODUCTION</span><b>→</b><span>FUTURE WATCH</span>
      </div>
    </div>
  </section>

  <footer class="research-footer">
    <div class="footer-inner">
      <div><strong>J 的世界 Research</strong><span>Facts First · Evidence-Based Research</span></div>
      <div class="footer-links"><a href="/research/">Research</a><a href="/companies/">Companies</a><a href="/maps/">Industry Maps</a></div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  /* V1.2-11 · FINAL CENTER + RESPONSIVE TYPOGRAPHY LOCK
     This block is intentionally placed LAST so page-level styles and
     responsive rules cannot move P1-P8 content back to left alignment. */
  .research-content,
  .research-content * {
    text-align: center !important;
  }

  .research-content {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .research-content .page-hero,
  .research-content .page-hero-inner,
  .research-content .section,
  .research-content .feature,
  .research-content .cta,
  .research-content .cta-inner,
  .research-content .card,
  .research-content .map-card {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .research-content .page-hero-inner,
  .research-content .section,
  .research-content .feature,
  .research-content .cta {
    width: 100% !important;
    max-width: 900px !important;
  }

  .research-content .card,
  .research-content .map-card {
    width: 100% !important;
    max-width: 100% !important;
  }

  .research-content .feature > .section {
    width: 100% !important;
    max-width: none !important;
  }

  .research-content .page-hero-inner {
    max-width: 900px !important;
  }

  .research-content .page-hero h1,
  .research-content .page-hero p,
  .research-content .section-head,
  .research-content .section-head > div,
  .research-content .section-head > p,
  .research-content .card,
  .research-content .map-card,
  .research-content .card h3,
  .research-content .map-card h3,
  .research-content .card p,
  .research-content .map-card p,
  .research-content li,
  .research-content ul,
  .research-content ol,
  .research-content blockquote,
  .research-content table,
  .research-content th,
  .research-content td {
    text-align: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .research-content .section-head {
    align-items: center !important;
    justify-content: center !important;
    flex-direction: column !important;
    width: 100% !important;
    gap: 8px !important;
  }

  .research-content .section-head > div {
    width: 100% !important;
  }

  .research-content .section-head > p {
    width: 100% !important;
    max-width: 760px !important;
  }

  .research-content .page-hero p {
    max-width: 760px !important;
  }

  /* V1.2-11 · RESPONSIVE TYPOGRAPHY LOCK
     Prevent desktop headings from becoming oversized while mobile headings
     become disproportionately small. Keep the same visual hierarchy at all widths. */
  .research-content .page-hero h1 {
    font-size: clamp(2rem, 5vw, 4.2rem) !important;
    line-height: 1.02 !important;
  }

  .research-content h2 {
    font-size: clamp(1.45rem, 2.2vw, 2rem) !important;
    line-height: 1.18 !important;
  }

  .research-content h3 {
    font-size: clamp(1rem, 1.35vw, 1.2rem) !important;
    line-height: 1.3 !important;
  }

  .research-content p {
    font-size: clamp(.82rem, .95vw, .92rem) !important;
    line-height: 1.85 !important;
  }


  .research-content .grid {
    justify-items: center !important;
    align-items: stretch !important;
  }

  .research-content .card,
  .research-content .map-card {
    align-items: center !important;
    justify-content: flex-start !important;
  }

  .research-content .card > *,
  .research-content .map-card > * {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .research-content .technology-flow,
  .research-content .glass-flow,
  .research-content .evidence-chain,
  .research-content .signal-flow,
  .research-content .matrix-flow,
  .research-content .scale-flow,
  .research-content .timeline,
  .research-content .evidence-grid,
  .research-content .watch-grid {
    justify-content: center !important;
    justify-items: center !important;
    align-items: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .research-content .technology-flow > *,
  .research-content .glass-flow > *,
  .research-content .evidence-chain > *,
  .research-content .signal-flow > *,
  .research-content .matrix-flow > *,
  .research-content .scale-flow > *,
  .research-content .timeline > *,
  .research-content .evidence-grid > *,
  .research-content .watch-grid > * {
    text-align: center !important;
  }

  .research-content .cta-inner {
    justify-content: center !important;
    align-items: center !important;
    flex-direction: column !important;
    text-align: center !important;
  }

  .research-content .cta-inner > div {
    width: 100% !important;
  }

  .research-content .button,
  .research-content .button-secondary {
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
  }

  /* V1.2-12 · HEADING WRAP FIX
     Keep section headings comfortably readable at desktop widths without
     the counter-intuitive "wrap on large / fit on small" behavior. */
  .research-content h1 {
    font-size: clamp(2rem, 4vw, 3.4rem) !important;
    line-height: 1.08 !important;
    max-width: 100% !important;
    overflow-wrap: normal !important;
    word-break: normal !important;
  }

  .research-content h2 {
    font-size: clamp(1.35rem, 1.8vw, 1.8rem) !important;
    line-height: 1.25 !important;
    max-width: 100% !important;
    overflow-wrap: normal !important;
    word-break: normal !important;
    text-wrap: balance;
  }

  .research-content .section-head > div {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* V1.2-13 · UNIFIED CONTENT RAIL
     Feature sections and cards must never shrink to their text content. */
  .research-content .section,
  .research-content .feature,
  .research-content .page-hero,
  .research-content .cta {
    width: 100% !important;
    max-width: 900px !important;
    box-sizing: border-box !important;
  }

  .research-content .feature > .section {
    width: 100% !important;
    max-width: none !important;
    box-sizing: border-box !important;
  }

  .research-content .card,
  .research-content .map-card {
    display: block !important;
