---
export interface Props {
  title?: string;
  page?: string;
  signal?: string;
  evidence?: string;
  focus?: string;
}
const { title = 'Research Vol.01 · AI Platform Evolution', page = '', signal = '', evidence = '', focus = '' } = Astro.props;
const pages = [
  ['P1','Story','/research/p1/'],['P2','Evidence','/research/p2/'],['P3','AI Platform','/research/p3/'],
  ['P4','Technology','/research/p4/'],['P5','Glass Core','/research/p5/'],['P6','Investment','/research/p6/'],
  ['P7','Future Watch','/research/p7/'],['P8','Methodology','/research/p8/']
];
---
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="J 的世界 Research · Vol.01 · AI Platform Evolution" />
</head>
<body>
  <div class="site-shell">
    <header class="research-header">
      <a class="brand" href="/">J 的世界 <span>Research</span></a>
      <div class="edition">VOL.01 <b>AI PLATFORM EVOLUTION</b></div>
      <div class="header-right">FACTS FIRST · EVIDENCE BEFORE CONCLUSION</div>
    </header>

    <nav class="chapter-nav" aria-label="Research Vol.01 chapters">
      {pages.map(([id,label,href]) => <a class:list-active={page===id} href={href}><span>{id}</span><strong>{label}</strong></a>)}
    </nav>

    <main class="research-content">
      <slot />
    </main>

    <section class="research-footer-nav">
      {(() => {
        const idx = pages.findIndex(([id]) => id === page);
        const prev = idx > 0 ? pages[idx - 1] : null;
        const next = idx >= 0 && idx < pages.length - 1 ? pages[idx + 1] : null;
        return (
          <div class="page-turn">
            {prev ? <a class="turn turn-prev" href={prev[2]}><span>← PREVIOUS</span><strong>{prev[0]} · {prev[1]}</strong></a> : <div class="turn turn-empty"></div>}
            <a class="turn-library" href="/research/">RESEARCH LIBRARY</a>
            {next ? <a class="turn turn-next" href={next[2]}><span>NEXT →</span><strong>{next[0]} · {next[1]}</strong></a> : <div class="turn turn-empty"></div>}
          </div>
        );
      })()}
      <div class="footer-path">
        <span>RESEARCH PATH</span>
        <strong>EVENT</strong><i>→</i><strong>EVIDENCE</strong><i>→</i><strong>TECHNOLOGY</strong><i>→</i><strong>SUPPLY CHAIN</strong><i>→</i><strong>VALIDATION</strong><i>→</i><strong>PRODUCTION</strong><i>→</i><strong>FUTURE WATCH</strong>
      </div>
      <div class="footer-links">
        <a href="/research/">Research Library</a><a href="/maps/">Industry Maps</a><a href="/posters/">Posters</a><a href="/downloads/">Downloads</a>
      </div>
      <div class="footer-brand">J 的世界 Research · Vol.01 · AI Platform Evolution</div>
    </section>
  </div>
</body>
</html>

<style is:global>
:root{font-family:Inter,"Noto Sans TC","Microsoft JhengHei",system-ui,sans-serif;color:#eef2f6;background:#071018;font-synthesis:none}
