---
export interface Props {
  title?: string;
  page?: string;
  signal?: string;
  evidence?: string;
  focus?: string;
}
const { title = 'Research Vol.01 · AI Platform Evolution', page = '', signal = '', evidence = '', focus = '' } = Astro.props;
const pages = [
  ['P1','Story','/research/p1/'],['P2','Evidence','/research/p2/'],['P3','AI Platform','/research/p3/'],
  ['P4','Technology','/research/p4/'],['P5','Glass Core','/research/p5/'],['P6','Investment','/research/p6/'],
  ['P7','Future Watch','/research/p7/'],['P8','Methodology','/research/p8/']
];
---
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="J 的世界 Research · Vol.01 · AI Platform Evolution" />
</head>
<body>
  <div class="site-shell">
    <header class="research-header">
      <a class="brand" href="/">J 的世界 <span>Research</span></a>
      <div class="edition">VOL.01 <b>AI PLATFORM EVOLUTION</b></div>
      <div class="header-right">FACTS FIRST · EVIDENCE BEFORE CONCLUSION</div>
    </header>

    <nav class="chapter-nav" aria-label="Research Vol.01 chapters">
      {pages.map(([id,label,href]) => <a class:list-active={page===id} href={href}><span>{id}</span><strong>{label}</strong></a>)}
    </nav>

    <main class="research-content">
      <slot />
    </main>

    <section class="research-footer-nav">
      <div class="footer-path">
        <span>RESEARCH PATH</span>
        <strong>EVENT</strong><i>→</i><strong>EVIDENCE</strong><i>→</i><strong>TECHNOLOGY</strong><i>→</i><strong>SUPPLY CHAIN</strong><i>→</i><strong>VALIDATION</strong><i>→</i><strong>PRODUCTION</strong><i>→</i><strong>FUTURE WATCH</strong>
      </div>
      <div class="footer-links">
        <a href="/research/">Research Library</a><a href="/maps/">Industry Maps</a><a href="/posters/">Posters</a><a href="/downloads/">Downloads</a>
      </div>
      <div class="footer-brand">J 的世界 Research · Vol.01 · AI Platform Evolution</div>
    </section>
  </div>
</body>
</html>

<style is:global>
:root{font-family:Inter,"Noto Sans TC","Microsoft JhengHei",system-ui,sans-serif;color:#eef2f6;background:#071018;font-synthesis:none}
*{box-sizing:border-box} html{background:#071018;scroll-behavior:smooth} body{margin:0;background:radial-gradient(circle at 50% 0%,#132535 0,#071018 34%,#050b10 100%);color:#eef2f6;line-height:1.65} a{color:inherit;text-decoration:none}.site-shell{min-height:100vh}.research-header{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:26px 0 18px;display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:end;border-bottom:1px solid #2a3946}.brand{font-size:22px;font-weight:800;letter-spacing:.02em}.brand span{font-weight:500;color:#9caab5}.edition{font-size:11px;letter-spacing:.16em;color:#b9c5cd}.edition b{color:#e7b85d;font-weight:700}.header-right{text-align:right;font-size:9px;letter-spacing:.14em;color:#7e8d98}.chapter-nav{width:min(1180px,calc(100% - 40px));margin:0 auto;display:grid;grid-template-columns:repeat(8,1fr);border-bottom:1px solid #263541}.chapter-nav a{padding:13px 8px 12px;border-right:1px solid #263541;color:#71808b;text-align:center;transition:.2s}.chapter-nav a:first-child{border-left:1px solid #263541}.chapter-nav a span{display:block;font-size:9px;letter-spacing:.15em;color:#667580}.chapter-nav a strong{display:block;margin-top:2px;font-size:11px;font-weight:650}.chapter-nav a:hover,.chapter-nav a.list-active{background:#101d28;color:#fff}.chapter-nav a.list-active span{color:#dcb05a}.research-content{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:0 0 70px}.editorial-page{padding-top:42px}.page-kicker{font-size:10px;letter-spacing:.2em;color:#dcb05a;font-weight:800}.page-meta{display:flex;gap:22px;flex-wrap:wrap;margin-top:10px;font-size:10px;color:#7f8d97;letter-spacing:.12em;text-transform:uppercase}.page-meta b{color:#d5dde2;font-weight:600}.page-title{font-size:clamp(2.5rem,6vw,6rem);line-height:.95;letter-spacing:-.045em;margin:12px 0 18px;font-weight:850}.page-subtitle{max-width:760px;font-size:18px;color:#aeb9c1;margin:0}.editorial-rule{height:1px;background:linear-gradient(90deg,#d9ad56,transparent);margin:28px 0}.lead-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:22px;align-items:stretch}.lead-visual{min-height:330px;border:1px solid #2c3d49;background:linear-gradient(145deg,#102330,#071118);position:relative;overflow:hidden}.lead-visual:before{content:"";position:absolute;inset:12%;border:1px solid rgba(220,176,90,.22);transform:rotate(-8deg)}.lead-visual:after{content:"";position:absolute;width:420px;height:420px;border-radius:50%;border:1px solid rgba(102,175,210,.22);right:-130px;bottom:-160px;box-shadow:0 0 0 55px rgba(100,170,205,.04),0 0 0 110px rgba(100,170,205,.025)}.visual-label{position:absolute;left:24px;top:22px;font-size:10px;letter-spacing:.18em;color:#dcb05a}.visual-big{position:absolute;left:24px;bottom:22px;font-size:clamp(2.8rem,6vw,6rem);font-weight:850;line-height:.8;color:#eef3f5;letter-spacing:-.05em}.visual-big em{color:#dcb05a;font-style:normal}.visual-lines{position:absolute;right:22%;top:25%;width:45%;height:1px;background:#547587;transform:rotate(-27deg);box-shadow:0 42px #314f60,0 84px #273f4e}.lead-note{border:1px solid #2c3d49;background:#0b151e;padding:26px;display:flex;flex-direction:column;justify-content:center}.lead-note .tag{font-size:10px;letter-spacing:.18em;color:#dcb05a}.lead-note h2{font-size:28px;line-height:1.2;margin:10px 0 12px}.lead-note p{color:#aeb9c1;margin:0}.quote{margin:24px 0 0;padding:22px 26px;border-left:3px solid #dcb05a;background:#0c1720;font-size:20px;line-height:1.55;color:#e6ebee}.quote strong{color:#dcb05a}.section{margin-top:42px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.section-head .eyebrow{font-size:10px;letter-spacing:.18em;color:#7f8f9b}.section-head h2{margin:4px 0 0;font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.08}.section-head p{max-width:560px;margin:0;color:#8e9ca5;font-size:13px}.editorial-grid{display:grid;gap:14px}.editorial-grid.two{grid-template-columns:repeat(2,1fr)}.editorial-grid.three{grid-template-columns:repeat(3,1fr)}.editorial-grid.four{grid-template-columns:repeat(4,1fr)}.editorial-card{border:1px solid #2a3a46;background:linear-gradient(180deg,#0d1922,#09131b);padding:22px;min-height:170px;position:relative}.editorial-card .num{font-size:34px;color:#dcb05a;font-weight:800;line-height:1}.editorial-card h3{font-size:18px;margin:12px 0 8px}.editorial-card p{margin:0;color:#9eabb4;font-size:13px}.editorial-card .bottom-line{margin-top:16px;padding-top:10px;border-top:1px solid #293944;font-size:10px;letter-spacing:.12em;color:#d6dde1}.flow{display:flex;align-items:stretch;justify-content:center;gap:0;margin:22px 0}.flow-node{flex:1;border:1px solid #30424e;background:#0c1821;padding:20px 12px;text-align:center;position:relative}.flow-node:not(:last-child):after{content:"→";position:absolute;right:-15px;top:50%;transform:translateY(-50%);z-index:2;color:#dcb05a;font-size:18px;background:#071018;padding:0 4px}.flow-node b{display:block;font-size:12px;color:#e9edf0}.flow-node span{display:block;margin-top:7px;font-size:10px;color:#7f8e98}.matrix{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #30414c;border-left:1px solid #30414c}.matrix .cell{min-height:150px;border-right:1px solid #30414c;border-bottom:1px solid #30414c;padding:22px;background:#0a151e}.matrix .cell b{display:block;color:#dcb05a;font-size:10px;letter-spacing:.13em}.matrix .cell h3{margin:8px 0 7px;font-size:17px}.matrix .cell p{margin:0;color:#98a6af;font-size:12px}.watch-line{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin:25px 0 8px}.watch-step{padding:16px;border-top:2px solid #334854;position:relative}.watch-step:before{content:"";position:absolute;top:-6px;left:16px;width:9px;height:9px;border-radius:50%;background:#dcb05a}.watch-step b{display:block;color:#dcb05a;font-size:10px;letter-spacing:.14em}.watch-step h3{margin:8px 0;font-size:17px}.watch-step p{margin:0;color:#98a6af;font-size:12px}.method-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.method-card{border:1px solid #2b3b46;padding:24px;background:#0b161f}.method-card h3{margin:0 0 9px;font-size:19px}.method-card p{margin:0;color:#9ca9b2;font-size:13px}.method-card.gold{border-color:#6e572c;background:linear-gradient(135deg,#17170f,#0b151d)}.disclaimer{margin-top:18px;border-left:3px solid #667680;padding:18px 20px;background:#09131b;color:#8f9da6;font-size:12px}.research-footer-nav{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:26px 0 38px;border-top:1px solid #2a3946}.footer-path{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:9px;letter-spacing:.12em;color:#71818c}.footer-path span{color:#dcb05a;margin-right:8px}.footer-path i{color:#4e626f;font-style:normal}.footer-links{display:flex;gap:18px;margin-top:20px;flex-wrap:wrap}.footer-links a{font-size:11px;color:#aab5bc}.footer-links a:hover{color:#dcb05a}.footer-brand{margin-top:22px;color:#5e6c76;font-size:9px;letter-spacing:.14em}.cta-editorial{margin-top:42px;padding:28px;border:1px solid #6b552e;background:linear-gradient(120deg,#15160f,#0b141b);display:flex;justify-content:space-between;align-items:center;gap:20px}.cta-editorial h2{margin:4px 0 0;font-size:26px}.cta-editorial p{margin:0;color:#929fa7;font-size:12px}.button{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;border:1px solid #dcb05a;color:#e9c97e;font-size:11px;letter-spacing:.08em}.button:hover{background:#dcb05a;color:#081018}
@media(max-width:850px){.research-header{grid-template-columns:1fr;gap:7px}.header-right{text-align:left}.chapter-nav{grid-template-columns:repeat(4,1fr)}.chapter-nav a:nth-child(n+5){border-top:1px solid #263541}.lead-grid,.method-grid{grid-template-columns:1fr}.editorial-grid.three{grid-template-columns:1fr}.editorial-grid.four{grid-template-columns:repeat(2,1fr)}.matrix{grid-template-columns:repeat(2,1fr)}.flow{overflow-x:auto;justify-content:flex-start}.flow-node{min-width:180px}.watch-line{grid-template-columns:repeat(2,1fr);gap:0 8px}.cta-editorial{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.research-header,.chapter-nav,.research-content,.research-footer-nav{width:min(100% - 24px,1180px)}.chapter-nav a strong{font-size:10px}.page-title{font-size:clamp(2.4rem,13vw,4rem)}.lead-visual{min-height:250px}.editorial-grid.four,.matrix,.watch-line{grid-template-columns:1fr}.quote{font-size:17px}.flow-node{min-width:155px}}
</style>
