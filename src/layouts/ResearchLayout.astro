---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  page: string;
  eyebrow?: string;
}

const { title, page, eyebrow = "RESEARCH · VOL.01" } = Astro.props;

const pages = [
  { id: "p1", label: "P1", title: "Story", href: "/research/vol01/p1" },
  { id: "p2", label: "P2", title: "Evidence", href: "/research/vol01/p2" },
  { id: "p3", label: "P3", title: "AI Platform", href: "/research/vol01/p3" },
  { id: "p4", label: "P4", title: "Technology", href: "/research/vol01/p4" },
  { id: "p5", label: "P5", title: "Glass Core", href: "/research/vol01/p5" },
  { id: "p6", label: "P6", title: "Investment Matrix", href: "/research/vol01/p6" },
  { id: "p7", label: "P7", title: "Future Watch", href: "/research/vol01/p7" },
  { id: "p8", label: "P8", title: "Methodology", href: "/research/vol01/p8" },
];

const currentIndex = pages.findIndex((item) => item.id === page);
const current = pages[currentIndex];

const previous = currentIndex > 0 ? pages[currentIndex - 1] : null;
const next = currentIndex < pages.length - 1 ? pages[currentIndex + 1] : null;
---

<BaseLayout title={`${title}｜J 的世界 Research`}>

  <section class="research-hero">

    <div class="research-hero-inner">

      <div class="kicker">{eyebrow}</div>

      <div class="hero-top">

        <div>
          <h1>{title}</h1>

          <p>
            AI Platform Evolution · Facts First ·
            Evidence-Based Research
          </p>
        </div>

        <a class="back-link" href="/research">
          ← Vol.01 研究目錄
        </a>

      </div>

    </div>

  </section>


  <section class="research-nav">

    <div class="research-nav-inner">

      <div class="page-progress">

        {pages.map((item) => (
          <a
            href={item.href}
            class:list={{ active: item.id === page }}
            title={item.title}
          >
            {item.label}
          </a>
        ))}

      </div>

      <div class="page-caption">
        {current?.label} · {current?.title}
      </div>

    </div>

  </section>


  <main class="research-content">

    <slot />

  </main>


  <section class="related-section">

    <div class="related-inner">

      <div class="kicker">RESEARCH CONNECTIONS</div>

      <h2>繼續探索</h2>

      <div class="related-grid">

        <a class="related-card" href="/maps">

          <span class="tag">INDUSTRY MAPS</span>

          <h3>查看產業地圖 →</h3>

          <p>
            從技術節點、供應鏈位置與 Evidence Level
            重新理解 AI 產業鏈。
          </p>

        </a>


        <a class="related-card" href="/posters">

          <span class="tag">POSTERS</span>

          <h3>查看研究海報 →</h3>

          <p>
            將 Research Vol.01 的核心內容
            濃縮成一頁式視覺研究。
          </p>

        </a>


        <a
          class="related-card"
          href="/downloads"
        >

          <span class="tag">PDF LIBRARY</span>

          <h3>下載 First Printing →</h3>

          <p>
            閱讀 Research Vol.01
            印刷級完整 PDF。
          </p>

        </a>

      </div>

    </div>

  </section>


  <nav class="page-navigation">

    <div class="page-navigation-inner">

      {previous ? (
        <a class="page-nav previous" href={previous.href}>

          <span class="nav-label">← PREVIOUS</span>

          <strong>
            {previous.label} · {previous.title}
          </strong>

        </a>
      ) : (
        <a class="page-nav previous" href="/research">
          <span class="nav-label">← BACK</span>
          <strong>Vol.01 Research Index</strong>
        </a>
      )}


      {next ? (
        <a class="page-nav next" href={next.href}>

          <span class="nav-label">NEXT →</span>

          <strong>
            {next.label} · {next.title}
          </strong>

        </a>
      ) : (
        <a class="page-nav next" href="/research">
          <span class="nav-label">FINISH →</span>
          <strong>Vol.01 Research Index</strong>
        </a>
      )}

    </div>

  </nav>


  <section class="research-footer-cta">

    <div class="research-footer-inner">

      <div>

        <div class="kicker">VOL.01 · AI PLATFORM EVOLUTION</div>

        <h2>從 Research，走向產業地圖。</h2>

        <p>
          Research 解釋「發生什麼」，
          Maps 解釋「技術如何連接」，
          Posters 則將研究濃縮成可以快速閱讀的視覺版本。
        </p>

      </div>

      <div class="footer-actions">

        <a class="button" href="/maps">
          Industry Maps →
        </a>

        <a class="button-secondary" href="/posters">
          Posters
        </a>

      </div>

    </div>

  </section>


  <style>

    .research-hero {
      padding: 72px 24px 52px;
      border-bottom: 1px solid #263342;
      background:
        radial-gradient(
          circle at 80% 20%,
          rgba(68, 96, 125, .16),
          transparent 38%
        );
    }

    .research-hero-inner {
      max-width: 1180px;
      margin: 0 auto;
    }

    .hero-top {
      margin-top: 18px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 30px;
    }

    .hero-top h1 {
      margin: 0;
      font-size: clamp(36px, 5vw, 62px);
      line-height: 1.05;
      letter-spacing: -.035em;
    }

    .hero-top p {
      margin: 18px 0 0;
      color: #9eabb9;
      font-size: 15px;
    }

    .back-link {
      color: #aebdcc;
      text-decoration: none;
      white-space: nowrap;
      border-bottom: 1px solid #46576b;
      padding-bottom: 5px;
    }

    .research-nav {
      position: sticky;
      top: 0;
      z-index: 20;
      border-bottom: 1px solid #263342;
      background: rgba(10, 15, 21, .94);
      backdrop-filter: blur(12px);
    }

    .research-nav-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .page-progress {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .page-progress a {
      min-width: 38px;
      padding: 7px 9px;
      text-align: center;
      border: 1px solid #334354;
      border-radius: 6px;
      color: #8291a2;
      text-decoration: none;
      font-size: 11px;
      letter-spacing: .08em;
    }

    .page-progress a:hover,
    .page-progress a.active {
      color: #eef2f7;
      border-color: #7d91a7;
      background: #182330;
    }

    .page-caption {
      color: #718093;
      font-size: 12px;
      letter-spacing: .08em;
    }

    .research-content {
      max-width: 1180px;
      margin: 0 auto;
      padding: 54px 24px 30px;
    }

    .related-section {
      border-top: 1px solid #263342;
      background: #0d141d;
      padding: 64px 24px;
    }

    .related-inner {
      max-width: 1180px;
      margin: 0 auto;
    }

    .related-inner h2 {
      margin: 8px 0 28px;
      font-size: 32px;
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .related-card {
      display: block;
      padding: 25px;
      border: 1px solid #2f3e4e;
      border-radius: 14px;
      background: #111a24;
      color: #eef2f7;
      text-decoration: none;
      transition: transform .2s ease, border-color .2s ease;
    }

    .related-card:hover {
      transform: translateY(-3px);
      border-color: #687d93;
    }

    .related-card h3 {
      margin: 12px 0 8px;
      font-size: 21px;
    }

    .related-card p {
      color: #9daab8;
      line-height: 1.7;
      margin-bottom: 0;
    }

    .page-navigation {
      border-top: 1px solid #263342;
      border-bottom: 1px solid #263342;
      background: #0a1017;
    }

    .page-navigation-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .page-nav {
      padding: 20px 22px;
      border: 1px solid #2d3c4c;
      border-radius: 12px;
      color: #e8edf3;
      text-decoration: none;
      background: #101821;
    }

    .page-nav.next {
      text-align: right;
    }

    .page-nav:hover {
      border-color: #72869c;
    }

    .nav-label {
      display: block;
      color: #718296;
      font-size: 10px;
      letter-spacing: .15em;
      margin-bottom: 7px;
    }

    .research-footer-cta {
      padding: 70px 24px;
    }

    .research-footer-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 35px;
    }

    .research-footer-inner h2 {
      margin: 8px 0 12px;
      font-size: clamp(28px, 4vw, 42px);
    }

    .research-footer-inner p {
      max-width: 720px;
      color: #98a6b5;
      line-height: 1.8;
    }

    .footer-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      white-space: nowrap;
    }

    @media(max-width: 800px) {

      .research-hero {
        padding-top: 50px;
      }

      .hero-top {
        display: block;
      }

      .back-link {
        display: inline-block;
        margin-top: 24px;
      }

      .research-nav-inner {
        display: block;
      }

      .page-caption {
        margin-top: 9px;
      }

      .related-grid {
        grid-template-columns: 1fr;
      }

      .page-navigation-inner {
        grid-template-columns: 1fr;
      }

      .page-nav.next {
        text-align: left;
      }

      .research-footer-inner {
        display: block;
      }

      .footer-actions {
        margin-top: 25px;
      }

    }

  </style>

</BaseLayout>
