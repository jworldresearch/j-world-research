---
interface Props {
  title?: string;
  page?: string;
  signal?: string;
  evidence?: string;
  focus?: string;
}

const {
  title = "AI Platform Evolution",
  page = "",
  signal = "",
  evidence = "",
  focus = ""
} = Astro.props;

const researchPages = [
  { id: "P1", title: "Story", href: "/research/p1/", theme: "EVENT" },
  { id: "P2", title: "Evidence", href: "/research/p2/", theme: "EVIDENCE" },
  { id: "P3", title: "AI Platform", href: "/research/p3/", theme: "EVOLUTION" },
  { id: "P4", title: "Technology", href: "/research/p4/", theme: "TECHNOLOGY" },
  { id: "P5", title: "Glass Core", href: "/research/p5/", theme: "SUPPLY CHAIN" },
  { id: "P6", title: "Investment Matrix", href: "/research/p6/", theme: "VALIDATION" },
  { id: "P7", title: "Future Watch", href: "/research/p7/", theme: "FUTURE" },
  { id: "P8", title: "Reference", href: "/research/p8/", theme: "METHODOLOGY" }
];

const currentIndex = researchPages.findIndex(
  (item) => item.id === page
);

const previousPage =
  currentIndex > 0 ? researchPages[currentIndex - 1] : null;

const nextPage =
  currentIndex >= 0 && currentIndex < researchPages.length - 1
    ? researchPages[currentIndex + 1]
    : null;
---

<!doctype html>
<html lang="zh-Hant">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{title}｜J 的世界 Research</title>

  <meta
    name="description"
    content="J 的世界 Research｜Facts First · Evidence-Based Research"
  />

  <!-- IMPORTANT:
       Global styles must be inside the document.
  -->
  <style is:global>

    * {
      box-sizing: border-box;
    }

    html {
      margin: 0;
      padding: 0;
      background: #0b1017;
    }

    body {
      margin: 0;
      padding: 0;
      color: #e8edf2;
      background:
        radial-gradient(
          circle at 50% -10%,
          rgba(75,95,115,.12),
          transparent 42%
        ),
        #0b1017;

      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "Noto Sans TC",
        "Microsoft JhengHei",
        sans-serif;

      line-height: 1.6;
    }

    a {
      color: inherit;
    }

    /* =========================
       RESEARCH HEADER
    ========================= */

    .research-header {
      position: sticky;
      top: 0;
      z-index: 100;

      border-bottom:
        1px solid rgba(255,255,255,.08);

      background:
        rgba(11,16,23,.94);

      backdrop-filter:
        blur(14px);
    }

    .header-inner {
      max-width: 1180px;
      min-height: 76px;

      margin: 0 auto;
      padding: 0 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .brand {
      display: flex;
      flex-direction: column;
      gap: 2px;

      text-decoration: none;
      white-space: nowrap;
    }

    .brand strong {
      font-size: .98rem;
      letter-spacing: -.02em;
    }

    .brand span {
      color: #687482;
      font-size: .52rem;
      font-weight: 700;
      letter-spacing: .13em;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .main-nav a {
      color: #8995a3;
      font-size: .72rem;
      font-weight: 650;
      text-decoration: none;
    }

    .main-nav a:hover {
      color: #e7ecf0;
    }

    /* =========================
       HERO
    ========================= */

    .research-hero {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .hero-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 60px 24px 48px;
    }

    .eyebrow,
    .label {
      color: #75818f;
      font-size: .66rem;
      font-weight: 800;
      letter-spacing: .16em;
    }

    .hero-inner h1 {
      margin: 14px 0 30px;

      font-size:
        clamp(2.7rem, 7vw, 5.8rem);

      line-height: .96;
      letter-spacing: -.055em;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .hero-meta > div {
      min-width: 170px;

      padding: 12px 15px;

      border:
        1px solid rgba(255,255,255,.08);

      border-radius: 9px;

      background:
        rgba(255,255,255,.02);
    }

    .hero-meta span {
      display: block;
      margin-bottom: 4px;

      color: #65717e;

      font-size: .55rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .hero-meta strong {
      color: #bac4ce;
      font-size: .72rem;
      font-weight: 600;
    }

    /* =========================
       PAGE NAVIGATION
    ========================= */

    .page-navigation {
      border-bottom:
        1px solid rgba(255,255,255,.07);
    }

    .page-navigation-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 10px 24px;

      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 5px;
    }

    .page-link {
      min-height: 66px;
      padding: 9px 10px;

      border-radius: 7px;

      color: #697582;
      text-decoration: none;
    }

    .page-link:hover {
      background:
        rgba(255,255,255,.03);

      color: #c4cdd5;
    }

    .page-link.active {
      background:
        rgba(255,255,255,.06);

      color: #e5eaf0;
    }

    .page-id {
      display: block;

      font-size: .58rem;
      font-weight: 800;
    }

    .page-title {
      display: block;
      margin-top: 4px;

      font-size: .7rem;
    }

    .page-link small {
      display: block;
      margin-top: 5px;

      color: #596572;
      font-size: .5rem;
      letter-spacing: .08em;
    }

    /* =========================
       CONTENT
    ========================= */

    .research-content {
      max-width: 900px;
      margin: 0 auto;

      padding:
        65px 24px 75px;
    }

    /* =========================
       DATABASE CONNECTION
    ========================= */

    .database-connection {
      border-top:
        1px solid rgba(255,255,255,.09);
    }

    .connection-inner {
      max-width: 1180px;
      margin: 0 auto;

      padding:
        55px 24px;
    }

    .connection-heading h2 {
      margin: 10px 0 15px;

      font-size:
        clamp(2rem, 5vw, 3.8rem);

      line-height: .98;
      letter-spacing: -.05em;
    }

    .connection-heading p {
      max-width: 680px;
      margin: 0;

      color: #8b97a4;
      font-size: .82rem;
      line-height: 1.85;
    }

    .connection-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;

      margin-top: 28px;
    }

    .connection-card {
      display: flex;
      flex-direction: column;

      min-height: 165px;
      padding: 20px;

      border:
        1px solid rgba(255,255,255,.09);

      border-radius: 12px;

      background:
        rgba(255,255,255,.025);

      text-decoration: none;

      transition:
        transform .2s ease,
        border-color .2s ease;
    }

    .connection-card:hover {
      border-color:
        rgba(255,255,255,.25);

      transform:
        translateY(-2px);
    }

    .connection-card .number {
      color: #5e6a77;
      font-size: .6rem;
    }

    .connection-card strong {
      margin-top: auto;
      font-size: .95rem;
    }

    .connection-card > span:not(.number) {
      margin-top: 5px;

      color: #788492;
      font-size: .68rem;
    }

    .connection-card small {
      margin-top: 18px;

      color: #626e7a;
      font-size: .56rem;
      letter-spacing: .06em;
    }

    /* =========================
       PREVIOUS / NEXT
    ========================= */

    .research-navigation {
      border-top:
        1px solid rgba(255,255,255,.09);
    }

    .research-navigation-inner {
      max-width: 1180px;
      margin: 0 auto;

      padding:
        25px 24px;

      display: grid;
      grid-template-columns: 1fr auto 1fr;

      align-items: center;
      gap: 20px;
    }

    .research-navigation a {
      text-decoration: none;
    }

    .previous {
      justify-self: start;
    }

    .next {
      justify-self: end;
      text-align: right;
    }

    .research-navigation a span {
      display: block;

      color: #65717e;

      font-size: .56rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .research-navigation strong {
      display: block;
      margin-top: 5px;

      color: #aab4be;
      font-size: .7rem;
    }

    .library {
      padding: 9px 14px;

      border:
        1px solid rgba(255,255,255,.1);

      border-radius: 999px;

      color: #8b97a4;

      font-size: .58rem;
      font-weight: 800;
      letter-spacing: .08em;
    }

    .library:hover {
      color: #e3e8ed;
    }

    /* =========================
       RESEARCH PATH
    ========================= */

    .research-path {
      border-top:
        1px solid rgba(255,255,255,.08);
    }

    .path-inner {
      max-width: 1180px;
      margin: 0 auto;

      padding:
        35px 24px 45px;
    }

    .path {
      display: flex;
      align-items: center;
      gap: 9px;

      margin-top: 15px;

      overflow-x: auto;
      white-space: nowrap;
    }

    .path span {
      color: #707c89;

      font-size: .56rem;
      font-weight: 700;
      letter-spacing: .07em;
    }

    .path b {
      color: #4f5b67;
      font-size: .62rem;
    }

    /* =========================
       FOOTER
    ========================= */

    .research-footer {
      border-top:
        1px solid rgba(255,255,255,.08);
    }

    .footer-inner {
      max-width: 1180px;
      margin: 0 auto;

      padding:
        26px 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .footer-inner > div:first-child {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .footer-inner strong {
      font-size: .72rem;
    }

    .footer-inner span {
      color: #626e7b;
      font-size: .58rem;
    }

    .footer-links {
      display: flex;
      gap: 18px;
    }

    .footer-links a {
      color: #687481;
      font-size: .62rem;
      text-decoration: none;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 900px) {

      .page-navigation-inner {
        grid-template-columns:
          repeat(4, 1fr);
      }

      .connection-grid {
        grid-template-columns:
          1fr 1fr;
      }

    }

    @media (max-width: 700px) {

      .main-nav {
        display: none;
      }

      .hero-inner {
        padding:
          45px 18px 35px;
      }

      .page-navigation-inner {
        grid-template-columns:
          repeat(2, 1fr);

        padding:
          8px 18px;
      }

      .research-content {
        padding:
          45px 18px 55px;
      }

      .connection-inner,
      .path-inner {
        padding-left: 18px;
        padding-right: 18px;
      }

      .connection-grid {
        grid-template-columns:
          1fr;
      }

      .research-navigation-inner {
        padding:
          20px 18px;
      }

      .footer-inner {
        padding:
          24px 18px;

        align-items: flex-start;
        flex-direction: column;
      }

    }

  </style>
</head>


<body>

  <!-- =========================
       HEADER
  ========================= -->

  <header class="research-header">

    <div class="header-inner">

      <a href="/" class="brand">

        <strong>
          J 的世界 Research
        </strong>

        <span>
          FACTS FIRST · EVIDENCE-BASED RESEARCH
        </span>

      </a>


      <nav class="main-nav">

        <a href="/research/">
          Research
        </a>

        <a href="/companies/">
          Companies
        </a>

        <a href="/maps/">
          Industry Maps
        </a>

        <a href="/downloads/">
          Downloads
        </a>

        <a href="/posters/">
          Posters
        </a>

        <a href="/about/">
          About
        </a>

      </nav>

    </div>

  </header>


  <!-- =========================
       HERO
  ========================= -->

  <section class="research-hero">

    <div class="hero-inner">

      <div class="eyebrow">
        RESEARCH · VOL.01
      </div>

      <h1>
        {title}
      </h1>

      <div class="hero-meta">

        {signal && (
          <div>
            <span>SIGNAL</span>
            <strong>{signal}</strong>
          </div>
        )}

        {evidence && (
          <div>
            <span>EVIDENCE</span>
            <strong>{evidence}</strong>
          </div>
        )}

        {focus && (
          <div>
            <span>FOCUS</span>
            <strong>{focus}</strong>
          </div>
        )}

      </div>

    </div>

  </section>


  <!-- =========================
       P1–P8
  ========================= -->

  <section class="page-navigation">

    <div class="page-navigation-inner">

      {researchPages.map((item) => (

        <a
          href={item.href}
          class:list={[
            "page-link",
            {
              active: item.id === page
            }
          ]}
        >

          <span class="page-id">
            {item.id}
          </span>

          <span class="page-title">
            {item.title}
          </span>

          <small>
            {item.theme}
          </small>

        </a>

      ))}

    </div>

  </section>


  <!-- =========================
       PAGE CONTENT
  ========================= -->

  <section class="research-content">

    <slot />

  </section>


  <!-- =========================
       DATABASE CONNECTION
  ========================= -->

  <section class="database-connection">

    <div class="connection-inner">

      <div class="connection-heading">

        <span class="label">
          RESEARCH DATABASE
        </span>

        <h2>
          From Research<br />
          to Intelligence
        </h2>

        <p>
          本研究不只記錄事件與技術，
          同時將研究內容連接至企業與產業鏈，
          建立可持續更新的 Research Database。
        </p>

      </div>


      <div class="connection-grid">

        <a href="/companies/" class="connection-card">

          <span class="number">01</span>

          <strong>
            Companies
          </strong>

          <span>
            企業資料庫
          </span>

          <small>
            Research → Company →
          </small>

        </a>


        <a href="/maps/" class="connection-card">

          <span class="number">02</span>

          <strong>
            Industry Maps
          </strong>

          <span>
            產業鏈地圖
          </span>

          <small>
            Company → Supply Chain →
          </small>

        </a>


        <a href="/posters/" class="connection-card">

          <span class="number">03</span>

          <strong>
            Posters
          </strong>

          <span>
            視覺研究
          </span>

          <small>
            Research → Visual →
          </small>

        </a>


        <a href="/downloads/" class="connection-card">

          <span class="number">04</span>

          <strong>
            First Printing
          </strong>

          <span>
            出版級研究
          </span>

          <small>
            Research → PDF →
          </small>

        </a>

      </div>

    </div>

  </section>


  <!-- =========================
       PREVIOUS / NEXT
  ========================= -->

  <section class="research-navigation">

    <div class="research-navigation-inner">

      {previousPage ? (

        <a
          href={previousPage.href}
          class="previous"
        >

          <span>
            ← PREVIOUS
          </span>

          <strong>
            {previousPage.id} · {previousPage.title}
          </strong>

        </a>

      ) : (

        <div></div>

      )}


      <a
        href="/research/"
        class="library"
      >
        RESEARCH LIBRARY
      </a>


      {nextPage ? (

        <a
          href={nextPage.href}
          class="next"
        >

          <span>
            NEXT →
          </span>

          <strong>
            {nextPage.id} · {nextPage.title}
          </strong>

        </a>

      ) : (

        <div></div>

      )}

    </div>

  </section>


  <!-- =========================
       RESEARCH PATH
  ========================= -->

  <section class="research-path">

    <div class="path-inner">

      <span class="label">
        RESEARCH PATH
      </span>

      <div class="path">

        <span>EVENT</span>
        <b>→</b>

        <span>EVIDENCE</span>
        <b>→</b>

        <span>TECHNOLOGY</span>
        <b>→</b>

        <span>COMPANY</span>
        <b>→</b>

        <span>SUPPLY CHAIN</span>
        <b>→</b>

        <span>VALIDATION</span>
        <b>→</b>

        <span>PRODUCTION</span>
        <b>→</b>

        <span>FUTURE WATCH</span>

      </div>

    </div>

  </section>


  <!-- =========================
       FOOTER
  ========================= -->

  <footer class="research-footer">

    <div class="footer-inner">

      <div>

        <strong>
          J 的世界 Research
        </strong>

        <span>
          Facts First · Evidence-Based Research
        </span>

      </div>


      <div class="footer-links">

        <a href="/research/">
          Research
        </a>

        <a href="/companies/">
          Companies
        </a>

        <a href="/maps/">
          Industry Maps
        </a>

      </div>

    </div>

  </footer>

</body>

</html>
