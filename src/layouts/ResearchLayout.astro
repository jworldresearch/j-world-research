---
interface Props { title?: string; page: string; section: string; }
const { title = "J 的世界 Research", page, section } = Astro.props;
const pages = [
  { id:"P1", label:"Cover", href:"/research/p1" },
  { id:"P2", label:"Editor's Note", href:"/research/p2" },
  { id:"P3", label:"Four Signals", href:"/research/p3" },
  { id:"P4", label:"AI Platform", href:"/research/p4" },
  { id:"P5", label:"Bottleneck", href:"/research/p5" },
  { id:"P6", label:"Glass Core", href:"/research/p6" },
  { id:"P7", label:"Investment Matrix", href:"/research/p7" },
  { id:"P8", label:"Future Watch", href:"/research/p8" },
  { id:"P9", label:"Methodology", href:"/research/p9" },
];
const index = pages.findIndex((p) => p.id === page);
const prev = index > 0 ? pages[index - 1] : null;
const next = index < pages.length - 1 ? pages[index + 1] : null;
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<style is:global>
:root{--navy:#071a33;--gold:#b98932;--ink:#17263a;--muted:#687789;--paper:#fbfaf7;--line:#d7dce2;--soft:#eef2f6}
*{box-sizing:border-box}body{margin:0;background:#081426;color:var(--ink);font-family:Arial,"Noto Sans TC","Microsoft JhengHei",sans-serif;line-height:1.75}a{color:inherit}
.topbar{position:sticky;top:0;z-index:20;background:rgba(7,26,51,.97);color:#fff;border-bottom:1px solid rgba(213,170,85,.35)}
.topbar-inner{max-width:1180px;margin:auto;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand-link{display:block;text-decoration:none;color:#fff}.brand{font-weight:700;letter-spacing:.03em}.brand small{display:block;color:#d5aa55;font-size:10px;letter-spacing:.15em}.brand-link:hover .brand{color:#d6a84e}
.chapter-nav{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.chapter-nav a{text-decoration:none;color:#dbe4ee;border:1px solid transparent;border-radius:999px;padding:5px 9px;font-size:11px}.chapter-nav a:hover,.chapter-nav a.active{border-color:rgba(213,170,85,.7);color:#fff;background:rgba(185,137,50,.12)}
.page{width:min(1180px,calc(100% - 32px));margin:30px auto 60px;background:var(--paper);box-shadow:0 20px 70px rgba(0,0,0,.32);border-radius:4px;overflow:hidden}
.page-head{padding:18px 42px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#4c5b6c}.page-head strong{color:var(--navy)}.page-head .vol{color:var(--gold);font-weight:700}
.content{padding:42px 58px 46px}.kicker{color:var(--gold);font-weight:700;letter-spacing:.16em;font-size:12px;margin-bottom:8px}
h1{margin:0;color:var(--navy);font-family:Georgia,"Times New Roman",serif;font-size:clamp(2rem,4vw,3.45rem);line-height:1.08;font-weight:700;letter-spacing:-.02em}
.subtitle{margin:12px 0 0;color:#9a6c22;font-size:clamp(1.05rem,1.8vw,1.35rem);font-weight:700;line-height:1.45}.lead{margin:18px 0 0;max-width:820px;font-size:1.08rem;color:#344357}
.note{margin:26px 0;padding:18px 22px;background:#f2eee6;border-left:4px solid var(--gold);font-size:1rem}.note strong{display:block;color:var(--navy);margin-bottom:4px}
.section{margin-top:38px}.section-title{display:flex;align-items:baseline;gap:12px;border-bottom:1px solid var(--line);padding-bottom:10px;margin-bottom:18px}.section-title span{font-size:12px;color:var(--gold);font-weight:700;letter-spacing:.1em}.section-title h2{margin:0;color:var(--navy);font-size:1.45rem;line-height:1.3}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.card{border:1px solid #ccd3dc;background:#fff;padding:20px;border-radius:3px}.card h3{margin:0 0 8px;color:var(--navy);font-size:1.1rem;line-height:1.35}.card p{margin:0;font-size:.98rem;color:#3d4c5d}.tag{display:inline-block;font-size:11px;letter-spacing:.1em;color:var(--gold);font-weight:700;margin-bottom:8px}
.icon{width:46px;height:46px;border:2px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--navy);font-weight:800;margin-bottom:12px;font-size:18px}
.matrix{width:100%;border-collapse:collapse;background:#fff;font-size:.9rem}.matrix th,.matrix td{border:1px solid #cfd5dc;padding:12px 10px;vertical-align:top}.matrix th{background:var(--navy);color:#fff;text-align:left;font-size:.78rem}.matrix td:first-child{font-weight:700;color:var(--navy);white-space:nowrap}
.watch{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.watch-item{border:1px solid #ccd3dc;background:#fff;padding:18px}.watch-item .year{color:var(--gold);font-weight:700;font-size:12px}.watch-item h3{margin:6px 0;color:var(--navy);font-size:1.05rem}.watch-item p{margin:0;font-size:.92rem}
.method{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.method .card{min-height:180px}.disclaimer{font-size:.84rem;color:#6b7785}
/* New vector/editorial poster system: text stays HTML/SVG, never rasterized. */
.poster{position:relative;width:100%;overflow:hidden;border:1px solid #cbd3dd;background:#f8f7f3;box-shadow:0 12px 35px rgba(7,26,51,.10);isolation:isolate}
.poster-inner{position:relative;min-height:620px;padding:42px 46px;display:flex;flex-direction:column;justify-content:space-between}
.poster-kicker{font-size:11px;letter-spacing:.18em;color:var(--gold);font-weight:800}.poster-title{margin:8px 0 0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.4rem,5vw,5rem);line-height:.96;color:var(--navy);letter-spacing:-.03em}.poster-sub{margin-top:12px;color:#8e672b;font-size:1.1rem;font-weight:700}.poster-copy{max-width:650px;color:#35465a;font-size:1rem;line-height:1.8}.poster-top{position:relative;z-index:2}.poster-footer{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:end;border-top:1px solid #cfd5dc;padding-top:14px;color:#667586;font-size:11px}.poster-footer strong{color:var(--navy);letter-spacing:.12em}.poster-rule{height:4px;width:100%;background:var(--gold);margin:18px 0 0}
.poster-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative;z-index:2}.poster-grid.three{grid-template-columns:repeat(3,1fr)}.poster-tile{min-height:165px;padding:20px;background:#fff;border:1px solid #cdd4dc;position:relative}.poster-tile.dark{background:var(--navy);color:#fff;border-color:var(--navy)}.poster-tile .num{font-size:30px;font-weight:800;color:var(--gold);line-height:1}.poster-tile h3{margin:12px 0 7px;font-size:1rem;color:inherit}.poster-tile p{margin:0;font-size:.86rem;line-height:1.65;color:inherit;opacity:.82}
.poster-split{display:grid;grid-template-columns:1.05fr .95fr;gap:28px;align-items:stretch;position:relative;z-index:2}.poster-panel{border:1px solid #cbd3dd;background:#fff;padding:22px}.poster-panel.dark{background:var(--navy);color:#fff;border-color:var(--navy)}
.flow-v{display:flex;align-items:stretch;gap:0;margin-top:22px}.flow-v .step{flex:1;min-height:104px;padding:16px 12px;background:#fff;border:1px solid #ccd3dc;position:relative}.flow-v .step:not(:last-child)::after{content:"→";position:absolute;right:-13px;top:50%;transform:translateY(-50%);z-index:3;color:var(--gold);font-size:24px;font-weight:800}.flow-v .step b{display:block;color:var(--navy);font-size:.92rem}.flow-v .step span{display:block;color:#697789;font-size:.76rem;margin-top:5px}
.bottleneck{display:grid;grid-template-columns:1fr 110px 1fr;align-items:center;gap:18px;margin-top:20px}.pressure{display:grid;gap:8px}.pressure div{padding:14px 16px;border:1px solid #cbd3dd;background:#fff;font-weight:700;color:var(--navy)}.wall{height:100%;min-height:250px;border-left:8px solid var(--gold);display:flex;align-items:center;justify-content:center;background:repeating-linear-gradient(135deg,#eef1f4 0,#eef1f4 9px,#e2e6eb 9px,#e2e6eb 18px);text-align:center}.wall b{font-size:1rem;color:var(--navy);writing-mode:vertical-rl;letter-spacing:.08em}.solution-list{display:grid;gap:10px}.solution{padding:14px 16px;border-left:3px solid var(--gold);background:#f7f8fa}.solution b{display:block;color:var(--navy)}.solution span{font-size:.82rem;color:#687789}
.glass-figure{position:relative;min-height:270px;margin-top:20px;padding:24px;background:linear-gradient(135deg,#f1f4f7,#ffffff);border:1px solid #cbd3dd;display:flex;align-items:center;justify-content:center}.glass-stack{width:min(650px,100%);display:grid;gap:7px}.glass-layer{height:44px;border:1px solid #aebbc9;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:rgba(255,255,255,.88);font-weight:700;color:var(--navy)}.glass-layer.glass{height:62px;border:2px solid #74a9bd;background:linear-gradient(90deg,rgba(167,221,236,.55),rgba(235,250,255,.82));box-shadow:inset 0 0 25px rgba(90,150,170,.12)}.glass-layer small{font-weight:400;color:#607284}
.matrix-poster{display:grid;grid-template-columns:1fr 1.3fr;gap:24px;position:relative;z-index:2}.matrix-poster .left{display:grid;gap:10px}.matrix-poster .lane{padding:18px;background:#fff;border:1px solid #ccd3dc}.matrix-poster .lane b{color:var(--navy)}.matrix-poster .lane span{display:block;font-size:.8rem;color:#687789;margin-top:4px}.matrix-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.matrix-cell{padding:16px 12px;min-height:100px;background:#fff;border:1px solid #ccd3dc}.matrix-cell strong{display:block;color:var(--navy);font-size:.88rem}.matrix-cell small{display:block;color:#687789;margin-top:5px;line-height:1.5}
.timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:30px;position:relative}.timeline::before{content:"";position:absolute;top:31px;left:7%;right:7%;height:2px;background:#c7ced7}.timeline-item{position:relative;padding:0 12px;text-align:center}.timeline-dot{width:18px;height:18px;border:4px solid var(--paper);background:var(--gold);border-radius:50%;margin:22px auto 14px;box-shadow:0 0 0 1px var(--gold)}.timeline-year{font-weight:800;color:var(--navy);font-size:1rem}.timeline-item h3{margin:7px 0;color:var(--navy);font-size:.96rem}.timeline-item p{margin:0;color:#687789;font-size:.78rem;line-height:1.55}
.poster-orbit{position:absolute;right:-120px;top:-120px;width:520px;height:520px;border:1px solid rgba(185,137,50,.45);border-radius:50%;z-index:0}.poster-orbit::before,.poster-orbit::after{content:"";position:absolute;border:1px solid rgba(7,26,51,.12);border-radius:50%}.poster-orbit::before{inset:60px}.poster-orbit::after{inset:130px}.poster-vertical-label{position:absolute;right:24px;top:36px;writing-mode:vertical-rl;letter-spacing:.2em;color:#9aa5b0;font-size:10px;z-index:1}
.bottom-nav{border-top:1px solid #cbd2da;background:#f2f3f4;display:grid;grid-template-columns:1fr 1fr 1fr}.bottom-nav a{text-decoration:none;padding:18px 22px;display:flex;flex-direction:column;justify-content:center;min-height:86px;border-right:1px solid #d7dce1}.bottom-nav a:last-child{border-right:0;text-align:right;align-items:flex-end}.bottom-nav .center{text-align:center;align-items:center}.bottom-nav small{color:var(--gold);font-weight:700;letter-spacing:.08em}.bottom-nav strong{color:var(--navy);font-size:1rem}
.footer{max-width:1180px;margin:0 auto 50px;color:#9eabb9;font-size:12px;display:flex;justify-content:space-between;gap:20px;padding:0 8px}
@media(max-width:900px){.chapter-nav a{display:none}.chapter-nav a.active{display:block}.page{width:min(100% - 16px,760px);margin-top:12px}.page-head{padding:13px 18px}.content{padding:30px 22px 34px}.grid,.grid.three,.method{grid-template-columns:1fr}.watch{grid-template-columns:1fr 1fr}.matrix{font-size:.8rem}.matrix th,.matrix td{padding:8px 7px}.poster-inner{min-height:560px;padding:30px 28px}.poster-grid,.poster-grid.three{grid-template-columns:1fr 1fr}.poster-split,.matrix-poster,.bottleneck{grid-template-columns:1fr}.bottleneck{gap:10px}.wall{min-height:90px;border-left:0;border-top:8px solid var(--gold)}.wall b{writing-mode:horizontal-tb}.flow-v{display:grid}.flow-v .step:not(:last-child)::after{content:"↓";right:auto;left:50%;top:auto;bottom:-16px;transform:translateX(-50%)}.timeline{grid-template-columns:1fr 1fr;gap:20px}.timeline::before{display:none}.matrix-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.topbar-inner{padding:11px 14px}.brand{font-size:14px}.content{padding:24px 16px 28px}h1{font-size:2rem}.lead{font-size:1rem}.watch{grid-template-columns:1fr}.bottom-nav{grid-template-columns:1fr}.bottom-nav a,.bottom-nav a:last-child{border-right:0;border-bottom:1px solid #d7dce1;text-align:center;align-items:center}.bottom-nav a:last-child{border-bottom:0}.footer{display:block;padding:0 16px}.poster-inner{min-height:600px;padding:26px 20px}.poster-grid,.poster-grid.three,.matrix-grid{grid-template-columns:1fr}.poster-title{font-size:2.6rem}.poster-vertical-label{display:none}.poster-orbit{right:-220px;top:-150px}}
</style>
</head>
<body>
<header class="topbar"><div class="topbar-inner">
  <a class="brand-link" href="/" aria-label="回到 J 的世界首頁"><div class="brand">J 的世界 Research<small>VOL.01 · AI PLATFORM EVOLUTION</small></div></a>
  <nav class="chapter-nav" aria-label="Research chapters">{pages.map((p)=><a class:list={{active:p.id===page}} href={p.href}>{p.id} · {p.label}</a>)}</nav>
</div></header>
<main class="page">
  <div class="page-head"><strong>{section}</strong><span>Vol.1 · 創刊號</span><span class="vol">{page}</span></div>
  <div class="content"><slot /></div>
  <nav class="bottom-nav" aria-label="Page navigation">
    {prev ? <a href={prev.href}><small>← PREVIOUS</small><strong>{prev.id} · {prev.label}</strong></a> : <a href="/research"><small>← LIBRARY</small><strong>Research Library</strong></a>}
    <a class="center" href="/research"><small>VOL.01</small><strong>Research Library</strong></a>
    {next ? <a href={next.href}><small>NEXT →</small><strong>{next.id} · {next.label}</strong></a> : <a href="/downloads"><small>COMPLETE →</small><strong>First Printing / Downloads</strong></a>}
  </nav>
</main>
<footer class="footer"><span>Facts First · Evidence Before Conclusion</span><span>J 的世界 Research · Research · Technology · Industry · Future</span></footer>
</body>
</html>
