---
interface Props {
  page: number;
  title: string;
  section: string;
  prev?: string;
  next?: string;
  nextLabel?: string;
}

const { page, title, section, prev, next, nextLabel } = Astro.props;

const progress = Math.round((page / 8) * 100);
---

<div class="reader-shell">

  <div class="reader-top">

    <a href="/research" class="back-link">
      ← Vol.01 研究目錄
    </a>

    <div class="reader-progress">
      <span>P{page} / P8</span>
      <div class="progress-track">
        <div class="progress-bar" style={`width:${progress}%`}></div>
      </div>
      <span>{progress}%</span>
    </div>

  </div>


  <header class="reader-header">

    <div class="kicker">
      RESEARCH · VOL.01 · {section}
    </div>

    <div class="page-number">
      P{String(page).padStart(2, "0")}
    </div>

    <h1>{title}</h1>

  </header>


  <main class="reader-content">
    <slot />
  </main>


  <nav class="reader-nav">

    {
      prev ? (
        <a href={prev} class="reader-nav-card">
          <span>← PREVIOUS</span>
          <strong>上一頁</strong>
        </a>
      ) : (
        <div class="reader-nav-card disabled">
          <span>FIRST PAGE</span>
          <strong>P1</strong>
        </div>
      )
    }


    <a href="/research" class="reader-index">
      <span>VOL.01</span>
      <strong>研究目錄</strong>
    </a>


    {
      next ? (
        <a href={next} class="reader-nav-card next">
          <span>NEXT →</span>
          <strong>{nextLabel ?? `P${page + 1}`}</strong>
        </a>
      ) : (
        <div class="reader-nav-card disabled">
          <span>LAST PAGE</span>
          <strong>P8</strong>
        </div>
      )
    }

  </nav>


  <div class="reader-links">

    <a href="/research">Research</a>
    <a href="/maps">Industry Maps</a>
    <a href="/posters">Posters</a>
    <a href="/downloads">PDF Library</a>

  </div>

</div>


<style>

.reader-shell {
  max-width: 1080px;
  margin: 0 auto;
  padding: 34px 24px 80px;
}

.reader-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  margin-bottom: 58px;
}

.back-link {
  color: #9eacbb;
  font-size: 13px;
  transition: color .2s ease;
}

.back-link:hover {
  color: #fff;
}

.reader-progress {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #7f8d9d;
  font-size: 11px;
  letter-spacing: .08em;
  white-space: nowrap;
}

.progress-track {
  width: 150px;
  height: 3px;
  background: #263242;
  border-radius: 99px;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #b8c8d9;
  transition: width .3s ease;
}

.reader-header {
  position: relative;
  padding: 0 0 46px;
  border-bottom: 1px solid #2b394a;
}

.reader-header .kicker {
  color: #8fa6bf;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .14em;
}

.page-number {
  position: absolute;
  right: 0;
  top: -12px;
  font-size: clamp(60px, 10vw, 120px);
  line-height: 1;
  font-weight: 900;
  color: rgba(255,255,255,.035);
  letter-spacing: -.08em;
  pointer-events: none;
}

.reader-header h1 {
  position: relative;
  z-index: 1;
  max-width: 780px;
  margin: 14px 0 0;
  font-size: clamp(38px, 6vw, 66px);
  line-height: 1.12;
  letter-spacing: -.04em;
}

.reader-content {
  padding: 54px 0 70px;
  color: #c5ced8;
  font-size: 17px;
  line-height: 1.9;
}

.reader-content h2 {
  color: #eef2f7;
  font-size: 30px;
  line-height: 1.3;
  margin: 0 0 22px;
}

.reader-content h3 {
  color: #eef2f7;
  font-size: 21px;
  margin: 32px 0 10px;
}

.reader-content p {
  max-width: 820px;
  margin: 0 0 24px;
}

.reader-content strong {
  color: #eef2f7;
}

.reader-content .reader-highlight {
  border-left: 3px solid #667b91;
  padding: 20px 24px;
  margin: 34px 0;
  background: rgba(20,30,42,.7);
  border-radius: 0 12px 12px 0;
}

.reader-content .reader-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin: 34px 0;
}

.reader-content .reader-card {
  padding: 24px;
  border: 1px solid #2b394a;
  border-radius: 15px;
  background: rgba(18,27,38,.78);
}

.reader-content .reader-card p {
  font-size: 15px;
  margin-bottom: 0;
}

.reader-nav {
  display: grid;
  grid-template-columns: 1fr 150px 1fr;
  gap: 14px;
  align-items: stretch;
}

.reader-nav-card,
.reader-index {
  min-height: 82px;
  padding: 18px 20px;
  border: 1px solid #2b394a;
  border-radius: 14px;
  background: rgba(18,27,38,.8);
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: border-color .2s ease, background .2s ease;
}

.reader-nav-card:hover,
.reader-index:hover {
  border-color: #53677d;
  background: rgba(28,40,54,.9);
}

.reader-nav-card.next {
  text-align: right;
}

.reader-nav-card span,
.reader-index span {
  color: #71869d;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .13em;
}

.reader-nav-card strong,
.reader-index strong {
  color: #e8edf3;
  margin-top: 5px;
  font-size: 16px;
}

.reader-nav-card.disabled {
  opacity: .35;
}

.reader-index {
  text-align: center;
  align-items: center;
}

.reader-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 42px;
  padding-top: 24px;
  border-top: 1px solid #263242;
}

.reader-links a {
  color: #7f8d9d;
  font-size: 12px;
}

.reader-links a:hover {
  color: #fff;
}

@media(max-width:800px) {

  .reader-shell {
    padding: 24px 18px 60px;
  }

  .reader-top {
    display: block;
    margin-bottom: 42px;
  }

  .reader-progress {
    margin-top: 18px;
  }

  .progress-track {
    flex: 1;
    max-width: 180px;
  }

  .reader-header {
    padding-bottom: 34px;
  }

  .page-number {
    font-size: 72px;
    top: -8px;
  }

  .reader-content {
    padding: 38px 0 50px;
    font-size: 16px;
  }

  .reader-content h2 {
    font-size: 26px;
  }

  .reader-content .reader-grid {
    grid-template-columns: 1fr;
  }

  .reader-nav {
    grid-template-columns: 1fr 1fr;
  }

  .reader-index {
    grid-column: 1 / -1;
    grid-row: 2;
    min-height: 64px;
  }

  .reader-nav-card {
    min-height: 72px;
  }

  .reader-links {
    gap: 14px;
  }
}

</style>
