---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  companies,
  getCompany
} from "../../data/companies";

const mapLinks: Record<string, string> = {
  "AI Ecosystem": "/maps/#ai-ecosystem",
  "Glass Core Ecosystem": "/maps/#glass-core-ecosystem",
  "CPO Ecosystem": "/maps/#cpo-ecosystem"
};

export function getStaticPaths() {
  return companies.map((company) => ({
    params: {
      slug: company.slug
    },
    props: {
      company
    }
  }));
}

const companyFromProps = Astro.props.company;

const slug = Astro.params.slug || "";

const company =
  companyFromProps || getCompany(slug);

if (!company) {
  throw new Error(`Company not found: ${slug}`);
}
---

<BaseLayout
  title={`${company.name}｜Companies`}
  description={company.description}
>

  <main class="company-page">

    <!-- HERO -->

    <section class="company-hero">

      <div class="hero-inner">

        <div class="hero-top">

          <span class={`status ${company.status.toLowerCase()}`}>
            {company.status}
          </span>

          {company.ticker && (
            <span class="ticker">
              {company.ticker}
            </span>
          )}

        </div>

        <span class="category">
          {company.category}
        </span>

        <h1>
          {company.name}
        </h1>

        <h2>
          {company.title}
        </h2>

        <p>
          {company.description}
        </p>

      </div>

    </section>


    <!-- POSITION -->

    <section class="section">

      <div class="section-inner">

        <span class="label">
          RESEARCH POSITION
        </span>

        <div class="role-box">

          <span>
            SUPPLY CHAIN ROLE
          </span>

          <strong>
            {company.role}
          </strong>

        </div>

      </div>

    </section>


    <!-- TECHNOLOGY -->

    <section class="section">

      <div class="section-inner">

        <span class="label">
          TECHNOLOGY
        </span>

        <h2>
          Technology Layer
        </h2>

        <div class="technology-grid">

          {company.technologies.map((technology, index) => (

            <div class="technology-card">

              <span>
                {String(index + 1).padStart(2, "0")}
              </span>

              <strong>
                {technology}
              </strong>

            </div>

          ))}

        </div>

      </div>

    </section>


    <!-- RESEARCH -->

    <section class="section">

      <div class="section-inner">

        <span class="label">
          RESEARCH CONNECTION
        </span>

        <h2>
          Research References
        </h2>

        <p class="section-description">
          從企業資料回到 Vol.01 Research。
        </p>

        <div class="reference-grid">

          {company.research.map((researchPage) => (

            <a
              href={`/research/${researchPage.toLowerCase()}/`}
              class="reference-card"
            >

              <span>
                RESEARCH
              </span>

              <strong>
                {researchPage}
              </strong>

              <small>
                View Research →
              </small>

            </a>

          ))}

        </div>

      </div>

    </section>


    <!-- INDUSTRY MAP -->

    <section class="section">

      <div class="section-inner">

        <span class="label">
          INDUSTRY MAP CONNECTION
        </span>

        <h2>
          Industry Maps
        </h2>

        <p class="section-description">
          此企業在產業地圖中的位置。
        </p>

        <div class="reference-grid">

          {company.maps.map((map) => (

            <a
              href={mapLinks[map] || "/maps/"}
              class="reference-card"
            >

              <span>
                INDUSTRY MAP
              </span>

              <strong>
                {map}
              </strong>

              <small>
                Open Map →
              </small>

            </a>

          ))}

        </div>

      </div>

    </section>


    <!-- EVIDENCE -->

    <section class="section evidence-section">

      <div class="section-inner">

        <span class="label">
          EVIDENCE STATUS
        </span>

        <h2>
          Evidence
        </h2>

        <div class="evidence-box">

          <span>
            SOURCE BASIS
          </span>

          <strong>
            {company.evidence}
          </strong>

          <p>
            本頁內容以公開資訊為基礎，
            不將尚未公開確認的市場推論視為既定事實。
          </p>

        </div>

      </div>

    </section>


    <!-- NAV -->

    <section class="navigation">

      <div class="navigation-inner">

        <a href="/companies/">
          ← Companies Database
        </a>

        <a href="/maps/">
          Industry Maps →
        </a>

      </div>

    </section>

  </main>


  <style>

    .company-page {
      min-height: 100vh;
    }

    .company-hero,
    .section,
    .navigation {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .hero-inner,
    .section-inner,
    .navigation-inner {
      width:
        min(1000px, calc(100% - 48px));

      margin: 0 auto;
    }

    .hero-inner {
      padding:
        80px 0 75px;
    }

    .hero-top {
      display: flex;

      justify-content: space-between;

      align-items: center;
    }

    .status {
      font-size: .55rem;

      font-weight: 850;

      letter-spacing: .13em;
    }

    .status.core {
      color: #c2ccd5;
    }

    .status.watch {
      color: #8997a5;
    }

    .status.research {
      color: #6f7d8a;
    }

    .ticker {
      color: #5e6b77;

      font-size: .6rem;

      font-weight: 700;
    }

    .category {
      display: block;

      margin-top: 28px;

      color: #718091;

      font-size: .63rem;
    }

    .hero-inner h1 {
      margin:
        12px 0 10px;

      font-size:
        clamp(3rem, 8vw, 6.5rem);

      line-height: .9;

      letter-spacing: -.065em;
    }

    .hero-inner h2 {
      margin:
        0 0 22px;

      color: #aab5bf;

      font-size:
        clamp(1rem, 2vw, 1.35rem);

      font-weight: 600;
    }

    .hero-inner p {
      max-width: 720px;

      margin: 0;

      color: #7c8996;

      font-size: .78rem;

      line-height: 1.9;
    }

    .section-inner {
      padding:
        62px 0;
    }

    .label {
      color: #718091;

      font-size: .61rem;

      font-weight: 800;

      letter-spacing: .14em;
    }

    .section h2 {
      margin:
        10px 0 26px;

      font-size:
        clamp(2rem, 5vw, 3.6rem);

      line-height: .95;

      letter-spacing: -.05em;
    }

    .role-box {
      padding:
        25px;

      border:
        1px solid rgba(255,255,255,.09);

      border-radius: 11px;

      background:
        rgba(255,255,255,.025);
    }

    .role-box span {
      display: block;

      color: #65727f;

      font-size: .55rem;

      font-weight: 800;

      letter-spacing: .1em;
    }

    .role-box strong {
      display: block;

      margin-top: 9px;

      color: #b8c2cb;

      font-size: .9rem;
    }

    .technology-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 10px;
    }

    .technology-card {
      min-height: 105px;

      padding: 20px;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      border:
        1px solid rgba(255,255,255,.08);

      border-radius: 10px;

      background:
        rgba(255,255,255,.025);
    }

    .technology-card span {
      color: #596673;

      font-size: .55rem;
    }

    .technology-card strong {
      color: #aeb8c2;

      font-size: .76rem;
    }

    .section-description {
      margin:
        -10px 0 25px;

      color: #788592;

      font-size: .68rem;
    }

    .reference-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 10px;
    }

    .reference-card {
      min-height: 125px;

      padding: 19px;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      border:
        1px solid rgba(255,255,255,.08);

      border-radius: 10px;

      background:
        rgba(255,255,255,.025);

      color: inherit;

      text-decoration: none;

      transition:
        border-color .2s ease,
        transform .2s ease;
    }

    .reference-card:hover {
      border-color:
        rgba(255,255,255,.22);

      transform:
        translateY(-2px);
    }

    .reference-card span {
      color: #626f7c;

      font-size: .53rem;

      font-weight: 800;

      letter-spacing: .1em;
    }

    .reference-card strong {
      color: #b4bec7;

      font-size: .82rem;
    }

    .reference-card small {
      color: #687582;

      font-size: .55rem;
    }

    .evidence-section {
      background:
        rgba(255,255,255,.012);
    }

    .evidence-box {
      padding:
        27px;

      border:
        1px solid rgba(255,255,255,.09);

      border-radius: 11px;
    }

    .evidence-box span {
      display: block;

      color: #65727f;

      font-size: .55rem;

      font-weight: 800;

      letter-spacing: .1em;
    }

    .evidence-box strong {
      display: block;

      margin-top: 10px;

      color: #b5c0ca;

      font-size: .75rem;

      line-height: 1.7;
    }

    .evidence-box p {
      margin:
        18px 0 0;

      color: #697683;

      font-size: .63rem;

      line-height: 1.8;
    }

    .navigation-inner {
      padding:
        25px 0;

      display: flex;

      justify-content: space-between;

      gap: 20px;
    }

    .navigation a {
      color: #7e8b98;

      font-size: .62rem;

      text-decoration: none;
    }

    .navigation a:hover {
      color: #c1cad2;
    }


    @media (max-width: 700px) {

      .hero-inner,
      .section-inner,
      .navigation-inner {
        width:
          min(100% - 32px, 1000px);
      }

      .technology-grid,
      .reference-grid {
        grid-template-columns:
          1fr;
      }

      .navigation-inner {
        flex-direction:
          column;
      }

    }

  </style>

</BaseLayout>
