---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { companies } from "../../data/companies";

export const getStaticPaths = (() => {
  return companies.map((company) => ({
    params: {
      slug: company.slug
    },
    props: {
      company
    }
  }));
}) satisfies GetStaticPaths;

const { company } = Astro.props;

const researchPages = company.researchRefs.map((ref, index) => ({
  ref,
  page: `P${index + 1}`
}));

const mapPages = company.mapRefs.map((ref) => ({
  ref,
  name: ref
    .replace("/maps/", "")
    .replaceAll("-", " ")
}));

const title = `${company.name}｜J 的世界 Research`;
const description =
  `${company.name}｜Company Layer · J 的世界 Research`;
---

<BaseLayout
  title={title}
  description={description}
>

  <main class="company-detail">

    <a
      href="/companies/"
      class="back"
    >
      ← COMPANY DATABASE
    </a>


    <!-- =========================
         HERO
    ========================= -->

    <header class="hero">

      <div class="hero-meta">

        <span
          class={`status status-${company.status.toLowerCase()}`}
        >
          {company.status}
        </span>

        {company.ticker && (
          <span class="ticker">
            {company.ticker}
          </span>
        )}

        <span class="category">
          {company.category}
        </span>

      </div>


      <h1>
        {company.name}
      </h1>


      <p class="role">
        {company.role}
      </p>

    </header>


    <!-- =========================
         COMPANY INTELLIGENCE
    ========================= -->

    <section class="intelligence">

      <div class="main-column">

        <section class="block">

          <span class="label">
            COMPANY INTELLIGENCE
          </span>

          <h2>
            Research Position
          </h2>

          <p>
            {company.description}
          </p>

        </section>


        <section class="block">

          <span class="label">
            TECHNOLOGY LAYER
          </span>

          <h2>
            Core Technology
          </h2>


          <div class="technology-grid">

            {company.technology.map((technology) => (
              <div class="technology">
                {technology}
              </div>
            ))}

          </div>

        </section>


        <section class="block">

          <span class="label">
            EVIDENCE
          </span>

          <h2>
            Evidence Status
          </h2>


          <div class="evidence-box">

            <div class="evidence-status">
              {company.evidence}
            </div>

            <p>
              本資料庫將公開資訊與研究推論分開管理。
              J Insight 用於標示基於公開證據形成的研究推論，
              不代表已確認的商業合作、量產或驗證結果。
            </p>

          </div>

        </section>

      </div>


      <!-- =========================
           CONNECTIONS
      ========================= -->

      <aside class="side-column">

        <section class="side-card">

          <span class="label">
            RESEARCH
          </span>

          <h3>
            Related Research
          </h3>


          <div class="research-list">

            {researchPages.map((item) => (
              <a href={item.ref}>

                <span class="page-id">
                  {item.page}
                </span>

                <span>
                  Research
                </span>

                <span>
                  →
                </span>

              </a>
            ))}

          </div>

        </section>


        <section class="side-card">

          <span class="label">
            INDUSTRY MAPS
          </span>

          <h3>
            Connected Maps
          </h3>


          <div class="research-list">

            {mapPages.map((item) => (
              <a href={item.ref}>

                <span class="page-id">
                  MAP
                </span>

                <span>
                  {item.name}
                </span>

                <span>
                  →
                </span>

              </a>
            ))}

          </div>

        </section>

      </aside>

    </section>


    <!-- =========================
         THREE-WAY CONNECTION
    ========================= -->

    <section class="three-way">

      <span class="label">
        THREE-WAY RESEARCH CONNECTION
      </span>

      <h2>
        Research ↔ Company ↔ Industry
      </h2>

      <p>
        同一研究主題可由 Research 進入企業資料，
        再由企業回到 Industry Map，
        建立可循環追蹤的研究資料結構。
      </p>


      <div class="connection-grid">

        <a
          href="/research/"
          class="connection"
        >

          <span class="number">
            01
          </span>

          <strong>
            Research
          </strong>

          <small>
            P1–P8 Evidence
          </small>

        </a>


        <div class="connection connector">
          →
        </div>


        <a
          href="/companies/"
          class="connection"
        >

          <span class="number">
            02
          </span>

          <strong>
            Company
          </strong>

          <small>
            Company Intelligence
          </small>

        </a>


        <div class="connection connector">
          →
        </div>


        <a
          href="/maps/"
          class="connection"
        >

          <span class="number">
            03
          </span>

          <strong>
            Industry Map
          </strong>

          <small>
            Supply Chain
          </small>

        </a>

      </div>

    </section>


    <!-- =========================
         RESEARCH RESOURCES
    ========================= -->

    <section class="resources">

      <span class="label">
        RESEARCH RESOURCES
      </span>

      <div class="resource-grid">

        <a href="/posters/">
          <strong>Posters</strong>
          <span>Visual Research</span>
        </a>

        <a href="/downloads/">
          <strong>First Printing</strong>
          <span>Research PDF</span>
        </a>

        <a href="/research/">
          <strong>Research Library</strong>
          <span>AI Platform Evolution</span>
        </a>

      </div>

    </section>

  </main>

</BaseLayout>


<style>

  .company-detail {
    max-width: 1100px;

    margin: 0 auto;

    padding:
      60px 24px 100px;
  }


  .back {
    display: inline-block;

    margin-bottom: 48px;

    color: #75818f;

    font-size: .68rem;
    font-weight: 700;

    letter-spacing: .08em;

    text-decoration: none;
  }

  .back:hover {
    color: #e0e5ea;
  }


  /* =========================
     HERO
  ========================= */

  .hero {
    padding-bottom: 52px;

    border-bottom:
      1px solid rgba(255,255,255,.1);
  }

  .hero-meta {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 12px;
  }

  .status {
    font-size: .68rem;
    font-weight: 800;

    letter-spacing: .1em;
  }

  .status-core {
    color: #d8e4ef;
  }

  .status-watch {
    color: #c3cbd4;
  }

  .status-research {
    color: #9da8b4;
  }

  .status-ecosystem {
    color: #b7c1cc;
  }

  .ticker,
  .category {
    color: #778391;

    font-size: .7rem;
  }

  .hero h1 {
    margin:
      24px 0 12px;

    font-size:
      clamp(3.2rem, 8vw, 6.5rem);

    line-height: .94;

    letter-spacing: -.06em;
  }

  .role {
    max-width: 720px;

    margin: 0;

    color: #aeb8c4;

    font-size: 1.15rem;

    line-height: 1.75;
  }


  /* =========================
     INTELLIGENCE
  ========================= */

  .intelligence {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr) 310px;

    gap: 60px;

    padding:
      60px 0;
  }

  .block {
    margin-bottom: 58px;
  }

  .label {
    color: #788595;

    font-size: .66rem;
    font-weight: 800;

    letter-spacing: .16em;
  }

  .block h2 {
    margin:
      10px 0 18px;

    font-size: 1.8rem;

    letter-spacing: -.035em;
  }

  .block > p {
    max-width: 700px;

    margin: 0;

    color: #9ba6b2;

    line-height: 1.9;
  }


  /* =========================
     TECHNOLOGY
  ========================= */

  .technology-grid {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 10px;
  }

  .technology {
    padding: 18px;

    border:
      1px solid rgba(255,255,255,.09);

    border-radius: 10px;

    background:
      rgba(255,255,255,.025);

    color: #c5ced7;

    font-size: .8rem;
  }


  /* =========================
     EVIDENCE
  ========================= */

  .evidence-box {
    padding: 24px;

    border-left:
      2px solid rgba(255,255,255,.3);

    background:
      rgba(255,255,255,.025);
  }

  .evidence-status {
    color: #d6dee6;

    font-size: .7rem;
    font-weight: 800;

    letter-spacing: .14em;
  }

  .evidence-box p {
    margin:
      14px 0 0;

    color: #87929f;

    font-size: .8rem;

    line-height: 1.85;
  }


  /* =========================
     SIDE CARDS
  ========================= */

  .side-card {
    margin-bottom: 16px;

    padding: 22px;

    border:
      1px solid rgba(255,255,255,.09);

    border-radius: 14px;

    background:
      rgba(255,255,255,.025);
  }

  .side-card h3 {
    margin:
      10px 0 16px;

    font-size: 1rem;
  }

  .research-list {
    display: flex;

    flex-direction: column;
  }

  .research-list a {
    display: grid;

    grid-template-columns:
      38px 1fr 18px;

    align-items: center;

    gap: 7px;

    padding:
      11px 0;

    border-top:
      1px solid rgba(255,255,255,.06);

    color: #919daa;

    font-size: .7rem;

    text-decoration: none;
  }

  .research-list a:hover {
    color: #e2e7eb;
  }

  .page-id {
    color: #626e7b;
  }


  /* =========================
     THREE WAY
  ========================= */

  .three-way {
    padding:
      55px 0;

    border-top:
      1px solid rgba(255,255,255,.1);
  }

  .three-way h2 {
    margin:
      10px 0 14px;

    font-size:
      clamp(2rem, 5vw, 3.8rem);

    letter-spacing: -.05em;
  }

  .three-way > p {
    max-width: 700px;

    margin: 0;

    color: #8e99a6;

    line-height: 1.85;
  }

  .connection-grid {
    display: grid;

    grid-template-columns:
      1fr 40px 1fr 40px 1fr;

    align-items: center;

    gap: 8px;

    margin-top: 30px;
  }

  .connection {
    display: flex;

    flex-direction: column;

    gap: 7px;

    min-height: 120px;

    padding: 20px;

    border:
      1px solid rgba(255,255,255,.1);

    border-radius: 12px;

    color: inherit;

    text-decoration: none;
  }

  .connection:hover {
    border-color:
      rgba(255,255,255,.25);
  }

  .connection .number {
    color: #626e7b;

    font-size: .65rem;
  }

  .connection strong {
    font-size: .95rem;
  }

  .connection small {
    color: #788492;

    font-size: .68rem;
  }

  .connector {
    min-height: auto;

    padding: 0;

    align-items: center;
    justify-content: center;

    border: 0;

    color: #65717e;

    font-size: .8rem;
  }


  /* =========================
     RESOURCES
  ========================= */

  .resources {
    padding:
      50px 0;

    border-top:
      1px solid rgba(255,255,255,.1);
  }

  .resource-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 10px;

    margin-top: 20px;
  }

  .resource-grid a {
    display: flex;

    flex-direction: column;

    gap: 6px;

    padding: 18px;

    border:
      1px solid rgba(255,255,255,.09);

    border-radius: 11px;

    color: inherit;

    text-decoration: none;
  }

  .resource-grid a:hover {
    border-color:
      rgba(255,255,255,.25);
  }

  .resource-grid strong {
    font-size: .8rem;
  }

  .resource-grid span {
    color: #707c89;

    font-size: .68rem;
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 800px) {

    .intelligence {
      grid-template-columns:
        1fr;
    }

    .connection-grid {
      grid-template-columns:
        1fr;
    }

    .connector {
      display: none;
    }

    .resource-grid {
      grid-template-columns:
        1fr;
    }

  }


  @media (max-width: 560px) {

    .company-detail {
      padding:
        40px 18px 70px;
    }

    .technology-grid {
      grid-template-columns:
        1fr;
    }

    .hero h1 {
      font-size: 3.5rem;
    }

  }

</style>
