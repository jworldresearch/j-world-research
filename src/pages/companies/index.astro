---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { companies } from "../../data/companies";
---

<BaseLayout
  title="Companies"
  description="J 的世界 Research｜Company Database"
>

  <main class="companies-page">

    <section class="hero">

      <div class="hero-inner">

        <span class="eyebrow">
          RESEARCH DATABASE
        </span>

        <h1>
          Companies
        </h1>

        <p>
          從研究事件、技術路徑與產業地圖，
          延伸至企業層級的 Research Database。
        </p>

      </div>

    </section>


    <section class="database">

      <div class="database-inner">

        <div class="database-header">

          <div>
            <span class="label">
              COMPANY LAYER
            </span>

            <h2>
              Research → Company
            </h2>
          </div>

          <p>
            每家公司不是單獨存在的資料，
            而是與 Research、Technology、
            Industry Maps 建立關聯。
          </p>

        </div>


        <div class="company-grid">

          {companies.map((company) => (

            <a
              href={`/companies/${company.slug}/`}
              class="company-card"
            >

              <div class="card-top">

                <span class={`status ${company.status.toLowerCase()}`}>
                  {company.status}
                </span>

                {company.ticker && (
                  <span class="ticker">
                    {company.ticker}
                  </span>
                )}

              </div>


              <div class="card-body">

                <h3>
                  {company.name}
                </h3>

                <span class="category">
                  {company.category}
                </span>

                <h4>
                  {company.title}
                </h4>

                <p>
                  {company.description}
                </p>

              </div>


              <div class="tag-row">

                {company.technologies.map((technology) => (
                  <span>
                    {technology}
                  </span>
                ))}

              </div>


              <div class="card-bottom">

                <span>
                  View Company
                </span>

                <strong>
                  →
                </strong>

              </div>

            </a>

          ))}

        </div>

      </div>

    </section>


    <section class="research-path">

      <div class="path-inner">

        <span class="label">
          DATABASE RELATIONSHIP
        </span>

        <div class="path">

          <span>RESEARCH</span>
          <b>→</b>

          <span>TECHNOLOGY</span>
          <b>→</b>

          <span>COMPANY</span>
          <b>→</b>

          <span>INDUSTRY MAP</span>
          <b>→</b>

          <span>VALIDATION</span>
          <b>→</b>

          <span>FUTURE WATCH</span>

        </div>

      </div>

    </section>

  </main>


  <style>

    .companies-page {
      min-height: 100vh;
    }

    .hero {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .hero-inner,
    .database-inner,
    .path-inner {
      width:
        min(1180px, calc(100% - 48px));

      margin:
        0 auto;
    }

    .hero-inner {
      padding:
        85px 0 70px;
    }

    .eyebrow,
    .label {
      color: #718091;

      font-size: .63rem;
      font-weight: 800;

      letter-spacing: .15em;
    }

    .hero h1 {
      margin:
        16px 0 20px;

      color: #edf2f6;

      font-size:
        clamp(3.5rem, 8vw, 7rem);

      line-height: .9;

      letter-spacing: -.065em;
    }

    .hero p {
      max-width: 650px;

      margin: 0;

      color: #7d8996;

      font-size: .82rem;

      line-height: 1.9;
    }

    .database {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .database-inner {
      padding:
        70px 0 80px;
    }

    .database-header {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 60px;

      align-items: end;

      margin-bottom: 32px;
    }

    .database-header h2 {
      margin:
        11px 0 0;

      font-size:
        clamp(2rem, 5vw, 4rem);

      line-height: .95;

      letter-spacing: -.055em;
    }

    .database-header p {
      max-width: 450px;

      margin: 0;

      color: #778491;

      font-size: .72rem;

      line-height: 1.9;
    }

    .company-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 12px;
    }

    .company-card {
      min-height: 350px;

      padding: 22px;

      display: flex;
      flex-direction: column;

      border:
        1px solid rgba(255,255,255,.09);

      border-radius: 13px;

      background:
        rgba(255,255,255,.025);

      color: inherit;

      text-decoration: none;

      transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease;
    }

    .company-card:hover {
      transform:
        translateY(-3px);

      border-color:
        rgba(255,255,255,.23);

      background:
        rgba(255,255,255,.035);
    }

    .card-top {
      display: flex;

      justify-content: space-between;

      align-items: center;
    }

    .status {
      font-size: .53rem;

      font-weight: 850;

      letter-spacing: .12em;
    }

    .status.core {
      color: #c2ccd5;
    }

    .status.watch {
      color: #8997a5;
    }

    .status.research {
      color: #6f7d8a;
    }

    .ticker {
      color: #596673;

      font-size: .58rem;
      font-weight: 700;
    }

    .card-body {
      margin-top: 32px;
    }

    .card-body h3 {
      margin: 0;

      font-size:
        clamp(1.5rem, 3vw, 2rem);

      line-height: 1;

      letter-spacing: -.04em;
    }

    .category {
      display: block;

      margin-top: 8px;

      color: #718091;

      font-size: .61rem;
    }

    .card-body h4 {
      margin:
        26px 0 9px;

      color: #b9c3cc;

      font-size: .85rem;
    }

    .card-body p {
      margin: 0;

      color: #778491;

      font-size: .67rem;

      line-height: 1.8;
    }

    .tag-row {
      display: flex;

      flex-wrap: wrap;

      gap: 6px;

      margin-top: auto;

      padding-top: 24px;
    }

    .tag-row span {
      padding:
        6px 8px;

      border-radius: 5px;

      background:
        rgba(255,255,255,.055);

      color: #7f8b98;

      font-size: .51rem;
    }

    .card-bottom {
      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-top: 20px;

      padding-top: 15px;

      border-top:
        1px solid rgba(255,255,255,.07);
    }

    .card-bottom span {
      color: #788592;

      font-size: .59rem;
    }

    .card-bottom strong {
      color: #9aa6b2;

      font-size: .72rem;
    }

    .research-path {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .path-inner {
      padding:
        38px 0 48px;
    }

    .path {
      display: flex;

      align-items: center;

      gap: 9px;

      margin-top: 16px;

      overflow-x: auto;

      white-space: nowrap;
    }

    .path span {
      color: #697683;

      font-size: .55rem;

      font-weight: 750;

      letter-spacing: .08em;
    }

    .path b {
      color: #4f5b67;

      font-size: .6rem;
    }


    @media (max-width: 950px) {

      .company-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .database-header {
        grid-template-columns:
          1fr;
        gap: 25px;
      }

    }


    @media (max-width: 620px) {

      .hero-inner,
      .database-inner,
      .path-inner {
        width:
          min(100% - 32px, 1180px);
      }

      .hero-inner {
        padding:
          65px 0 55px;
      }

      .database-inner {
        padding:
          55px 0 65px;
      }

      .company-grid {
        grid-template-columns:
          1fr;
      }

      .company-card {
        min-height: 320px;
      }

    }

  </style>

</BaseLayout>
