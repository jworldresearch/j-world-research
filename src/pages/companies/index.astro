---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { companies } from "../../data/companies";

const title = "Companies｜J 的世界 Research";
const description =
  "J 的世界 Research Company Layer｜AI、先進封裝、Glass Core、CPO 與高速互連企業研究資料庫。";
---

<BaseLayout title={title} description={description}>
  <main class="company-page">

    <section class="hero">
      <div class="eyebrow">COMPANY LAYER / RESEARCH DATABASE</div>

      <h1>Companies</h1>

      <p class="lead">
        從產業趨勢進一步拆解至企業、技術與供應鏈位置。
      </p>

      <div class="hero-line">
        <span>Facts First</span>
        <span>Evidence-Based Research</span>
        <span>Company Intelligence</span>
      </div>
    </section>


    <section class="database">

      <div class="section-heading">
        <div>
          <span class="label">RESEARCH DATABASE</span>
          <h2>Company Watchlist</h2>
        </div>

        <div class="count">
          {companies.length} Companies
        </div>
      </div>


      <div class="company-grid">

        {companies.map((company) => (
          <a
            class="company-card"
            href={`/companies/${company.slug}`}
          >

            <div class="card-top">
              <span class={`status status-${company.status.toLowerCase()}`}>
                {company.status}
              </span>

              {company.ticker && (
                <span class="ticker">
                  {company.ticker}
                </span>
              )}
            </div>

            <h3>{company.name}</h3>

            <p class="category">
              {company.category}
            </p>

            <p class="role">
              {company.role}
            </p>

            <div class="tech-list">
              {company.technology.slice(0, 4).map((tech) => (
                <span>{tech}</span>
              ))}
            </div>

            <div class="card-bottom">
              <span>View Research</span>
              <span>→</span>
            </div>

          </a>
        ))}

      </div>

    </section>


    <section class="research-links">

      <div>
        <span class="label">RESEARCH CONNECTIONS</span>
        <h2>Company → Technology → Industry</h2>
        <p>
          Company Layer 將企業資料與 Research、Industry Maps
          及 First Printing 串接，建立可持續更新的研究架構。
        </p>
      </div>

      <div class="link-grid">

        <a href="/research/">
          <strong>Research Library</strong>
          <span>P1–P8 Research</span>
        </a>

        <a href="/maps/">
          <strong>Industry Maps</strong>
          <span>AI / Glass Core / CPO</span>
        </a>

        <a href="/posters/">
          <strong>Posters</strong>
          <span>Visual Research</span>
        </a>

        <a href="/downloads/">
          <strong>First Printing</strong>
          <span>Research PDF</span>
        </a>

      </div>

    </section>

  </main>
</BaseLayout>


<style>
  .company-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 24px 100px;
  }

  .hero {
    padding: 48px 0 56px;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .eyebrow,
  .label {
    font-size: .72rem;
    letter-spacing: .18em;
    color: #8d9aaa;
    font-weight: 700;
  }

  h1 {
    margin: 18px 0 14px;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: .95;
    letter-spacing: -.055em;
  }

  .lead {
    max-width: 720px;
    color: #aeb8c4;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .hero-line {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero-line span {
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 999px;
    color: #dce2e8;
    font-size: .78rem;
  }

  .database {
    padding: 56px 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 26px;
  }

  h2 {
    margin: 8px 0 0;
    font-size: 2rem;
    letter-spacing: -.03em;
  }

  .count {
    color: #8793a2;
    font-size: .8rem;
    letter-spacing: .08em;
  }

  .company-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .company-card {
    display: flex;
    flex-direction: column;
    min-height: 290px;
    padding: 24px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 18px;
    background: rgba(255,255,255,.025);
    color: inherit;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .company-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,.25);
    background: rgba(255,255,255,.045);
  }

  .card-top,
  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status {
    font-size: .65rem;
    letter-spacing: .1em;
    font-weight: 800;
  }

  .status-core {
    color: #d8e4ef;
  }

  .status-watch {
    color: #c3cbd4;
  }

  .status-research {
    color: #9da8b4;
  }

  .status-ecosystem {
    color: #b7c1cc;
  }

  .ticker {
    color: #778391;
    font-size: .75rem;
  }

  h3 {
    margin: 28px 0 6px;
    font-size: 1.45rem;
    letter-spacing: -.025em;
  }

  .category {
    margin: 0;
    color: #8d9aaa;
    font-size: .75rem;
  }

  .role {
    margin: 18px 0;
    color: #c7d0da;
    line-height: 1.65;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .tech-list span {
    padding: 5px 8px;
    border-radius: 5px;
    background: rgba(255,255,255,.06);
    color: #aeb8c4;
    font-size: .68rem;
  }

  .card-bottom {
    margin-top: 22px;
    padding-top: 15px;
    border-top: 1px solid rgba(255,255,255,.08);
    color: #8f9aa7;
    font-size: .72rem;
  }

  .research-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 56px 0;
    border-top: 1px solid rgba(255,255,255,.1);
  }

  .research-links h2 {
    margin-bottom: 16px;
  }

  .research-links p {
    max-width: 540px;
    color: #929eab;
    line-height: 1.8;
  }

  .link-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .link-grid a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
  }

  .link-grid a:hover {
    border-color: rgba(255,255,255,.25);
  }

  .link-grid strong {
    font-size: .85rem;
  }

  .link-grid span {
    color: #7f8b99;
    font-size: .7rem;
  }

  @media (max-width: 900px) {
    .company-grid {
      grid-template-columns: 1fr 1fr;
    }

    .research-links {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .company-page {
      padding: 40px 18px 70px;
    }

    .company-grid,
    .link-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
