</section>


<style>

/* =========================================================
   HERO
========================================================= */

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 24px;
}

.hero-meta span {
  border: 1px solid #354457;
  background: rgba(18, 28, 40, .7);
  border-radius: 7px;
  padding: 5px 9px;
  color: #aebdcb;
  font-size: 11px;
  letter-spacing: .08em;
}


/* =========================================================
   ARTICLE NAV
========================================================= */

.research-nav-section {
  padding-top: 50px;
  padding-bottom: 45px;
}

.article-nav {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  gap: 8px;
}

.article-nav a {
  min-height: 78px;
  border: 1px solid #2b394a;
  border-radius: 10px;
  background: rgba(18, 27, 38, .72);
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: .2s ease;
}

.article-nav a:hover {
  border-color: #62758b;
  background: #172332;
}

.article-nav span {
  color: #6f87a0;
  font-size: 11px;
  font-weight: 800;
}

.article-nav strong {
  color: #dbe4ed;
  font-size: 12px;
}


/* =========================================================
   INTRO
========================================================= */

.research-intro {
  border: 1px solid #344457;
  border-radius: 20px;
  background:
    linear-gradient(
      135deg,
      rgba(25, 38, 53, .96),
      rgba(13, 20, 28, .96)
    );
  padding: 38px;
  display: grid;
  grid-template-columns: 1.4fr .6fr;
  gap: 50px;
}

.intro-main h3 {
  font-size: clamp(28px, 4vw, 42px);
  line-height: 1.25;
  margin: 16px 0 22px;
}

.intro-main p {
  color: #aeb9c6;
  max-width: 760px;
}

.intro-side {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.signal-box {
  border: 1px solid #304053;
  border-radius: 12px;
  padding: 16px;
  background: #101923;
}

.signal-box .number {
  display: block;
  font-size: 11px;
  margin-bottom: 8px;
}

.signal-box strong {
  display: block;
  font-size: 16px;
}

.signal-box small {
  color: #7f8d9d;
  font-size: 11px;
}


/* =========================================================
   SIGNAL GRID
========================================================= */

.signal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.signal-card {
  border: 1px solid #2d3c4e;
  border-radius: 16px;
  padding: 26px;
  background: rgba(18, 27, 38, .82);
  display: grid;
  grid-template-columns: 54px 1fr;
  gap: 20px;
}

.signal-number {
  font-size: 34px;
  line-height: 1;
  font-weight: 800;
  color: #7188a0;
}

.signal-card h3 {
  font-size: 21px;
  margin: 9px 0;
}

.signal-card p {
  color: #aeb9c6;
}


/* =========================================================
   TECHNOLOGY
========================================================= */

.technology-card {
  border: 1px solid #344457;
  border-radius: 18px;
  background: #101923;
  padding: 28px;
}

.technology-flow {
  display: flex;
  align-items: center;
  gap: 10px;
  overflow-x: auto;
  padding-bottom: 8px;
}

.tech-node {
  min-width: 145px;
  border: 1px solid #354457;
  border-radius: 10px;
  padding: 15px;
  background: #151f2b;
}

.tech-node span {
  display: block;
  color: #6f87a0;
  font-size: 11px;
  margin-bottom: 6px;
}

.tech-node strong {
  font-size: 13px;
}

.technology-flow > b {
  color: #65798e;
}

.technology-description {
  border-top: 1px solid #2b394a;
  margin-top: 22px;
  padding-top: 20px;
}

.technology-description p {
  color: #aeb9c6;
  margin: 0;
}


/* =========================================================
