---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="AI Platform Evolution｜J 的世界 Research">

<!-- =========================================================
     RESEARCH HERO
========================================================= -->

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">
      RESEARCH · VOL.01
    </div>

    <h1>
      AI Platform Evolution
    </h1>

    <p>
      從台積電 2026 China Technology Symposium 出發，
      追蹤 AI 平台如何由先進製程、先進封裝、光通訊、
      材料與設備共同演進。
    </p>

    <div class="research-meta">

      <span>VOL.01</span>
      <span>P1–P8</span>
      <span>Facts First</span>
      <span>Evidence-Based Research</span>

    </div>

  </div>

</section>


<!-- =========================================================
     RESEARCH NAVIGATION
========================================================= -->

<section class="section research-nav-section">

  <div class="section-head">

    <div>
      <div class="kicker">
        RESEARCH NAVIGATION
      </div>

      <h2>
        從研究出發，延伸至產業地圖與第一版印刷。
      </h2>
    </div>

  </div>


  <div class="research-nav-grid">

    <a class="research-nav-card" href="/maps">

      <span class="tag">
        INDUSTRY MAPS
      </span>

      <h3>
        查看產業地圖 →
      </h3>

      <p>
        將 Research 中的技術路徑，
        延伸至 AI、Glass Core 與 CPO
        三張核心產業地圖。
      </p>

    </a>


    <a class="research-nav-card" href="/posters">

      <span class="tag">
        POSTERS
      </span>

      <h3>
        查看研究海報 →
      </h3>

      <p>
        將複雜研究濃縮成一張圖，
        快速掌握核心技術與產業關係。
      </p>

    </a>


    <a class="research-nav-card" href="/downloads">

      <span class="tag">
        FIRST PRINTING
      </span>

      <h3>
        開啟 First Printing →
      </h3>

      <p>
        閱讀《J 的世界 Research Vol.01》
        印刷級 PDF 完整版本。
      </p>

    </a>

  </div>

</section>


<!-- =========================================================
     RESEARCH QUESTION
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">
        RESEARCH QUESTION
      </div>

      <h2>
        AI 的下一個瓶頸，已經不只是晶片。
      </h2>
    </div>

  </div>


  <article class="card">

    <p>
      當 AI 加速器持續提高運算密度，
      整個系統的限制開始從單一晶片，
      延伸到製程、封裝、互連、材料、散熱與電力。
    </p>

    <p>
      因此，本期研究不從「哪一檔股票會漲」開始，
      而是從一個產業事件開始，
      重新建立 AI Platform 的技術路徑。
    </p>

  </article>

</section>


<!-- =========================================================
     P1
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">
          P1 · STORY
        </div>

        <h2>
          從一場技術論壇開始
        </h2>
      </div>

      <p>
        2026.06.25
      </p>

    </div>


    <div class="grid">

      <article class="map-card">

        <div class="number">
          EVENT
        </div>

        <h3>
          TSMC 2026 China Technology Symposium
        </h3>

        <p>
          台積電於 2026 年 6 月 25 日在上海舉辦
          China Technology Symposium。
          官方議程涵蓋 HPC、先進邏輯製程、
          3DFabric、先進封裝、製造與
          Open Innovation Platform。
        </p>

      </article>


      <article class="map-card">

        <div class="number">
          RESEARCH START
        </div>

        <h3>
          為什麼這場論壇值得研究？
        </h3>

        <p>
          因為它不是單一製程節點的更新，
          而是從 transistor scaling 一路延伸到
          system integration 的完整技術路徑。
        </p>

      </article>

    </div>

  </div>

</section>


<!-- =========================================================
     P2
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">
        P2 · EVIDENCE
      </div>

      <h2>
        先把「事實」與「推論」分開
      </h2>
    </div>

  </div>


  <div class="grid">

    <article class="card">

      <span class="tag">
        FACT
      </span>

      <h3>
        先進製程持續演進
      </h3>

      <p>
        台積電官方 2026 Technology Symposium
        涵蓋 3nm、2nm、A16、A14 及後續技術。
      </p>

    </article>


    <article class="card">

      <span class="tag">
        FACT
      </span>

      <h3>
        3DFabric 持續擴展
      </h3>

      <p>
        官方議程涵蓋 SoIC、InFO、CoWoS
        與 SoW 等先進封裝技術。
      </p>

    </article>


    <article class="card">

      <span class="tag">
        INFERENCE
      </span>

      <h3>
        AI 平台的瓶頸正在系統化
      </h3>

      <p>
        當製程與封裝同步演進，
        互連、材料、散熱與電力的重要性
        也必須被放進同一個研究框架。
      </p>

    </article>

  </div>

</section>


<!-- =========================================================
     P3
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">
          P3 · AI PLATFORM EVOLUTION
        </div>

        <h2>
          四個訊號如何共同打造下一代 AI 平台？
        </h2>
      </div>

    </div>


    <div class="grid">

      <article class="map-card">

        <div class="number">
          01
        </div>

        <h3>
          Compute Scaling
        </h3>

        <p>
          先進製程持續推進，
          AI/HPC 對運算密度與能源效率的需求同步提高。
        </p>

      </article>


      <article class="map-card">

        <div class="number">
          02
        </div>

        <h3>
          Advanced Packaging
        </h3>

        <p>
          CoWoS、SoIC、SoW 等 3DFabric 技術，
          將晶片、記憶體與系統整合推向更高密度。
        </p>

      </article>


      <article class="map-card">

        <div class="number">
          03
        </div>

        <h3>
          Optical Interconnect
        </h3>

        <p>
          當電互連的頻寬、距離與功耗成為限制，
          光互連成為下一階段 AI 系統的重要研究方向。
        </p>

      </article>


      <article class="map-card">

        <div class="number">
          04
        </div>

        <h3>
          Materials & Infrastructure
        </h3>

        <p>
          製程、封裝與互連的升級，
          同時推動材料、設備、散熱與電力需求。
        </p>

      </article>

    </div>


    <div class="inline-link-row">

      <a href="/maps" class="button-outline">
        延伸閱讀：Industry Maps →
      </a>

    </div>

  </div>

</section>


<!-- =========================================================
     P4
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">
        P4 · TECHNOLOGY
      </div>

      <h2>
        從晶片走向系統
      </h2>
    </div>

  </div>


  <article class="card">

    <p>
      本研究將 AI Platform 拆成六個連續節點：
    </p>

    <p class="technology-chain">

      <strong>AI Compute</strong>
      →
      <strong>Advanced Process</strong>
      →
      <strong>Advanced Packaging</strong>
      →
      <strong>Optical Interconnect</strong>
      →
      <strong>Thermal / Power</strong>
      →
      <strong>System</strong>

    </p>

    <p>
      研究的目的不是預測單一技術何時取代另一項技術，
      而是觀察每一個節點何時從「技術可能性」
      進入「驗證、導入與量產」。
    </p>

  </article>

</section>


<!-- =========================================================
     P5
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">
          P5 · GLASS CORE
        </div>

        <h2>
          Glass Core：結果，而不是起點
        </h2>
      </div>

    </div>


    <article class="map-card">

      <p>
        Glass Core 不應被單獨理解成一項材料題材。
        它更值得放在 AI 封裝持續提高尺寸、
        密度與訊號完整性的背景下觀察。
      </p>

      <p>
        因此本研究將 Glass Core 放進：
      </p>

      <p class="technology-chain">

        <strong>Glass</strong>
        →
        <strong>TGV</strong>
        →
        <strong>Core Substrate</strong>
        →
        <strong>Advanced Packaging</strong>
        →
        <strong>AI Accelerator</strong>

      </p>

      <p>
        後續追蹤重點將放在技術驗證、
        製程整合、良率、量產時間與客戶導入，
        而不是只以市場題材判斷。
      </p>

    </article>


    <div class="inline-link-row">

      <a href="/maps" class="button-outline">
        延伸閱讀：Glass Core Ecosystem →
      </a>

      <a href="/posters" class="button-secondary">
        查看研究海報 →
      </a>

    </div>

  </div>

</section>


<!-- =========================================================
     P6
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">
        P6 · INVESTMENT MATRIX
      </div>

      <h2>
        技術節點，如何轉換成產業觀察？
      </h2>
    </div>

  </div>


  <div class="grid">

    <article class="card">

      <span class="tag">
        PROCESS
      </span>

      <h3>
        先進製程
      </h3>

      <p>
        觀察製程節點、產能、設備與材料需求。
      </p>

    </article>


    <article class="card">

      <span class="tag">
        PACKAGING
      </span>

      <h3>
        先進封裝
      </h3>

      <p>
        觀察 CoWoS、SoIC、Chiplet 與異質整合。
      </p>

    </article>


    <article class="card">

      <span class="tag">
        OPTICAL
      </span>

      <h3>
        光互連
      </h3>

      <p>
        觀察 CPO、光引擎、光纖與高速互連。
      </p>

    </article>


    <article class="card">

      <span class="tag">
        MATERIALS
      </span>

      <h3>
        材料與設備
      </h3>

      <p>
        尋找真正進入製程、驗證與量產的供應商。
      </p>

    </article>


    <article class="card">

      <span class="tag">
        INFRASTRUCTURE
      </span>

      <h3>
        電力與散熱
      </h3>

      <p>
        觀察 AI Server 與資料中心的基礎設施瓶頸。
      </p>

    </article>


    <article class="card">

      <span class="tag">
        SYSTEM
      </span>

      <h3>
        AI Platform
      </h3>

      <p>
        最後回到整個系統的效能、功耗與成本。
      </p>

    </article>

  </div>


  <div class="inline-link-row">

    <a href="/maps" class="button-outline">
      對照完整 Industry Maps →
    </a>

  </div>

</section>


<!-- =========================================================
     P7
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">
          P7 · FUTURE WATCH
        </div>

        <h2>
          下一個真正值得驗證的訊號
        </h2>

      </div>

    </div>


    <div class="grid">

      <article class="map-card">

        <span class="tag">
          WATCH 01
        </span>

        <h3>
          驗證
        </h3>

        <p>
          技術是否由研發進入客戶驗證？
        </p>

      </article>


      <article class="map-card">

        <span class="tag">
          WATCH 02
        </span>

        <h3>
          導入
        </h3>

        <p>
          是否進入實際製程或產品設計？
        </p>

      </article>


      <article class="map-card">

        <span class="tag">
          WATCH 03
        </span>

        <h3>
          量產
        </h3>

        <p>
          是否開始形成可觀察的產能與營收？
        </p>

      </article>


      <article class="map-card">

        <span class="tag">
          WATCH 04
        </span>

        <h3>
          擴散
        </h3>

        <p>
          是否由單一客戶擴展至更多 AI 平台？
        </p>

      </article>

    </div>

  </div>

</section>


<!-- =========================================================
     P8
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">
        P8 · REFERENCE & METHODOLOGY
      </div>

      <h2>
        研究方法
      </h2>
    </div>

  </div>


  <article class="card">

    <h3>
      Facts First
    </h3>

    <p>
      公開資訊、公司揭露與官方技術資料優先。
    </p>


    <h3>
      Evidence-Based Research
    </h3>

    <p>
      技術路徑、供應鏈、驗證與量產進度交叉檢視。
    </p>


    <h3>
      J Insight
    </h3>

    <p>
      尚未被公司正式公告、但值得追蹤的內容，
      明確標示為「產業推論（Inference）」。
    </p>


    <h3>
      免責聲明
    </h3>

    <p>
      本網站資料僅供資訊分享及學習，
      不作為投資進出場之依據。
    </p>


    <p class="source-note">
      主要事件來源：
      TSMC 2026 Technology Symposium
    </p>

  </article>


  <div class="inline-link-row">

    <a href="/about" class="button-outline">
      完整研究方法：About →
    </a>

    <a href="/downloads" class="button-secondary">
      First Printing PDF →
    </a>

  </div>

</section>


<!-- =========================================================
     FINAL RESEARCH CTA
========================================================= -->

<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">
        RESEARCH VOL.01 · NEXT
      </div>

      <h2>
        從 Research，繼續走向產業地圖。
      </h2>

      <p>
        Research 是起點。
        Industry Maps、Posters 與 First Printing
        將同一套研究轉換成不同閱讀方式。
      </p>

    </div>


    <div class="cta-actions">

      <a class="button" href="/maps">
        Industry Maps →
      </a>

      <a class="button-secondary" href="/posters">
        Posters
      </a>

      <a class="button-secondary" href="/downloads">
        First Printing PDF
      </a>

    </div>

  </div>

</section>


<!-- =========================================================
     PAGE STYLES
========================================================= -->

<style>

  .research-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .research-meta span {
    border: 1px solid #354457;
    border-radius: 7px;
    padding: 5px 9px;
    color: #b9c6d4;
    font-size: 12px;
  }


  /* Research Navigation */

  .research-nav-section {
    padding-bottom: 48px;
  }

  .research-nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .research-nav-card {
    display: block;
    border: 1px solid #2b394a;
    background: rgba(18,27,38,.82);
    border-radius: 18px;
    padding: 26px;
    transition:
      transform .2s ease,
      border-color .2s ease,
      background .2s ease;
  }

  .research-nav-card:hover {
    transform: translateY(-3px);
    border-color: #53677e;
    background: rgba(23,34,47,.92);
  }

  .research-nav-card h3 {
    margin: 12px 0 6px;
    font-size: 21px;
  }

  .research-nav-card p {
    color: #aeb9c6;
    margin-bottom: 0;
  }


  /* Technology */

  .technology-chain {
    padding: 18px;
    border: 1px solid #2b394a;
    border-radius: 12px;
    background: #0b1119;
    line-height: 2;
  }

  .technology-chain strong {
    color: #dbe5ef;
  }


  /* Inline Navigation */

  .inline-link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .button-outline {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 9px;
    border: 1px solid #647184;
    color: #eef2f7;
    font-weight: 800;
    font-size: 14px;
    transition: .2s ease;
  }

  .button-outline:hover {
    border-color: #aeb9c6;
    background: rgba(255,255,255,.04);
  }

  .button-secondary {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 9px;
    border: 1px solid #3c4b5d;
    color: #dce5ee;
    font-weight: 800;
    font-size: 14px;
    transition: .2s ease;
  }

  .button-secondary:hover {
    border-color: #647184;
    background: rgba(255,255,255,.04);
  }


  /* Source */

  .source-note {
    padding-top: 18px;
    border-top: 1px solid #2b394a;
    color: #8491a1 !important;
    font-size: 13px;
  }


  /* CTA */

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }


  /* Mobile */

  @media(max-width:800px) {

    .research-nav-grid {
      grid-template-columns: 1fr;
    }

    .research-nav-section {
      padding-bottom: 40px;
    }

    .technology-chain {
      font-size: 13px;
      line-height: 2.2;
    }

    .inline-link-row {
      display: grid;
      grid-template-columns: 1fr;
    }

    .inline-link-row a {
      text-align: center;
    }

    .cta-actions {
      justify-content: flex-start;
      margin-top: 20px;
    }

    .cta-actions .button,
    .cta-actions .button-secondary {
      text-align: center;
    }

  }

</style>


</BaseLayout>
