---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="J 的世界 Research"
  description="Facts First · Evidence-Based Research"
>

  <main class="home">

    <!-- =================================
         HERO
    ================================= -->

    <section class="hero">

      <div class="hero-inner">

        <div class="eyebrow">
          J WORLD RESEARCH
        </div>

        <h1>
          J 的世界<br />
          <span>Research</span>
        </h1>

        <p class="hero-subtitle">
          Facts First · Evidence-Based Research
        </p>

        <p class="hero-description">
          從產業事件出發，追蹤技術演進、供應鏈、
          驗證進度與企業價值，建立可持續更新的研究資料庫。
        </p>

        <div class="hero-actions">

          <a
            href="/research/"
            class="primary-button"
          >
            Explore Research →
          </a>

          <a
            href="/companies/"
            class="secondary-button"
          >
            Companies Database
          </a>

        </div>

      </div>

    </section>


    <!-- =================================
         CURRENT RESEARCH
    ================================= -->

    <section class="section">

      <div class="section-inner">

        <div class="section-heading">

          <div>
            <span class="section-label">
              CURRENT RESEARCH
            </span>

            <h2>
              Vol.01 · AI Platform Evolution
            </h2>
          </div>

          <a
            href="/research/"
            class="section-link"
          >
            View Research →
          </a>

        </div>


        <div class="research-feature">

          <div class="feature-main">

            <span class="feature-number">
              VOL.01
            </span>

            <h3>
              AI Platform Evolution
            </h3>

            <p>
              從 2026 China Technology Symposium 出發，
              追蹤 AI 平台從先進製程、先進封裝、
              光通訊、材料到設備的完整技術路徑。
            </p>

            <div class="tag-row">

              <span>Advanced Process</span>
              <span>CoWoS</span>
              <span>SoIC</span>
              <span>CPO</span>
              <span>Glass Core</span>

            </div>

            <a
              href="/research/"
              class="card-link"
            >
              Read Vol.01 →
            </a>

          </div>


          <div class="feature-side">

            <div class="signal-card">

              <span>
                RESEARCH SIGNAL
              </span>

              <strong>
                AI 的下一個瓶頸，
                已經不只是晶片。
              </strong>

            </div>


            <div class="signal-card">

              <span>
                RESEARCH METHOD
              </span>

              <strong>
                Event → Evidence → Technology
                → Supply Chain → Validation
              </strong>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =================================
         RESEARCH DATABASE
    ================================= -->

    <section class="section database-section">

      <div class="section-inner">

        <div class="section-heading">

          <div>

            <span class="section-label">
              RESEARCH DATABASE
            </span>

            <h2>
              From Research<br />
              to Intelligence
            </h2>

          </div>

          <p>
            將研究內容進一步連接至企業、
            技術與產業鏈。
          </p>

        </div>


        <div class="database-grid">

          <!-- Companies -->

          <a
            href="/companies/"
            class="database-card"
          >

            <span class="card-index">
              01
            </span>

            <div class="card-content">

              <span class="card-category">
                COMPANY DATABASE
              </span>

              <h3>
                Companies
              </h3>

              <p>
                追蹤企業核心技術、
                產品、產業位置與研究關聯。
              </p>

            </div>

            <span class="arrow">
              →
            </span>

          </a>


          <!-- Industry Maps -->

          <a
            href="/maps/"
            class="database-card"
          >

            <span class="card-index">
              02
            </span>

            <div class="card-content">

              <span class="card-category">
                SUPPLY CHAIN
              </span>

              <h3>
                Industry Maps
              </h3>

              <p>
                將 AI、Glass Core、
                CPO 等技術拆解為完整產業鏈。
              </p>

            </div>

            <span class="arrow">
              →
            </span>

          </a>


          <!-- Posters -->

          <a
            href="/posters/"
            class="database-card"
          >

            <span class="card-index">
              03
            </span>

            <div class="card-content">

              <span class="card-category">
                VISUAL RESEARCH
              </span>

              <h3>
                Posters
              </h3>

              <p>
                將複雜研究內容濃縮為
                可快速理解的視覺研究圖表。
              </p>

            </div>

            <span class="arrow">
              →
            </span>

          </a>


          <!-- Downloads -->

          <a
            href="/downloads/"
            class="database-card"
          >

            <span class="card-index">
              04
            </span>

            <div class="card-content">

              <span class="card-category">
                PUBLICATION
              </span>

              <h3>
                Downloads
              </h3>

              <p>
                First Printing 與正式研究出版品。
              </p>

            </div>

            <span class="arrow">
              →
            </span>

          </a>

        </div>

      </div>

    </section>


    <!-- =================================
         RESEARCH PRINCIPLES
    ================================= -->

    <section class="section principles-section">

      <div class="section-inner">

        <div class="principles-grid">

          <div>

            <span class="section-label">
              RESEARCH PRINCIPLES
            </span>

            <h2>
              Facts First.
            </h2>

            <p class="principle-lead">
              不從市場傳聞開始，
              而從可以驗證的事件與證據開始。
            </p>

          </div>


          <div class="principle-list">

            <div class="principle">

              <span>
                01
              </span>

              <div>

                <strong>
                  Facts First
                </strong>

                <p>
                  優先使用公開、可驗證的資訊。
                </p>

              </div>

            </div>


            <div class="principle">

              <span>
                02
              </span>

              <div>

                <strong>
                  Evidence-Based
                </strong>

                <p>
                  技術與產業推論建立在證據鏈上。
                </p>

              </div>

            </div>


            <div class="principle">

              <span>
                03
              </span>

              <div>

                <strong>
                  J Insight
                </strong>

                <p>
                  市場尚未公開確認的推論，
                  明確與公開事實區隔。
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =================================
         RESEARCH PATH
    ================================= -->

    <section class="path-section">

      <div class="section-inner">

        <span class="section-label">
          RESEARCH PATH
        </span>

        <div class="path">

          <span>EVENT</span>

          <b>→</b>

          <span>EVIDENCE</span>

          <b>→</b>

          <span>TECHNOLOGY</span>

          <b>→</b>

          <span>COMPANY</span>

          <b>→</b>

          <span>SUPPLY CHAIN</span>

          <b>→</b>

          <span>VALIDATION</span>

          <b>→</b>

          <span>PRODUCTION</span>

          <b>→</b>

          <span>FUTURE WATCH</span>

        </div>

      </div>

    </section>

  </main>


  <style>

    .home {
      width: 100%;
    }

    .hero {
      border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .hero-inner,
    .section-inner {
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
    }

    .hero-inner {
      padding: 105px 0 90px;
    }

    .eyebrow,
    .section-label {
      color: #718091;
      font-size: .65rem;
      font-weight: 800;
      letter-spacing: .16em;
    }

    .hero h1 {
      margin: 18px 0 0;

      color: #edf2f6;

      font-size: clamp(4rem, 9vw, 8rem);
      line-height: .86;
      letter-spacing: -.065em;
    }

    .hero h1 span {
      color: #9ca8b5;
    }

    .hero-subtitle {
      margin: 28px 0 0;

      color: #c1cad3;

      font-size: .9rem;
      font-weight: 650;
      letter-spacing: .04em;
    }

    .hero-description {
      max-width: 670px;

      margin: 18px 0 0;

      color: #788592;

      font-size: .82rem;
      line-height: 1.9;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;

      margin-top: 32px;
    }

    .primary-button,
    .secondary-button {
      padding: 11px 17px;

      border-radius: 7px;

      text-decoration: none;

      font-size: .68rem;
      font-weight: 750;
    }

    .primary-button {
      color: #0b1017;
      background: #e8edf2;
    }

    .secondary-button {
      color: #aeb8c2;

      border:
        1px solid rgba(255,255,255,.13);
    }

    .section {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .section-inner {
      padding: 75px 0;
    }

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 28px;
    }

    .section-heading h2 {
      margin: 10px 0 0;

      color: #e8edf2;

      font-size: clamp(1.8rem, 4vw, 3.2rem);
      line-height: 1;
      letter-spacing: -.045em;
    }

    .section-heading > p {
      max-width: 360px;

      margin: 0;

      color: #73808d;

      font-size: .72rem;
      line-height: 1.8;
    }

    .section-link {
      color: #8996a4;

      font-size: .65rem;
      text-decoration: none;

      white-space: nowrap;
    }

    .research-feature {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 12px;
    }

    .feature-main,
    .signal-card {
      border:
        1px solid rgba(255,255,255,.09);

      border-radius: 12px;

      background:
        rgba(255,255,255,.025);
    }

    .feature-main {
      padding: 32px;
    }

    .feature-number {
      color: #64717e;

      font-size: .58rem;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .feature-main h3 {
      margin: 14px 0 12px;

      font-size: clamp(2rem, 4vw, 3.5rem);

      line-height: 1;
      letter-spacing: -.05em;
    }

    .feature-main p {
      max-width: 650px;

      color: #82909d;

      font-size: .76rem;
      line-height: 1.9;
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;

      margin-top: 25px;
    }

    .tag-row span {
      padding: 6px 8px;

      border-radius: 5px;

      background:
        rgba(255,255,255,.055);

      color: #84909c;

      font-size: .55rem;
    }

    .card-link {
      display: inline-block;

      margin-top: 30px;

      color: #b4bec8;

      font-size: .66rem;
      font-weight: 700;

      text-decoration: none;
    }

    .feature-side {
      display: grid;
      gap: 12px;
    }

    .signal-card {
      min-height: 150px;

      padding: 25px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .signal-card span {
      color: #65727f;

      font-size: .55rem;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .signal-card strong {
      color: #b8c2cc;

      font-size: .88rem;
      line-height: 1.55;
    }

    .database-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 12px;
    }

    .database-card {
      position: relative;

      min-height: 225px;

      padding: 25px;

      display: flex;
      flex-direction: column;

      border:
        1px solid rgba(255,255,255,.09);

      border-radius: 12px;

      background:
        rgba(255,255,255,.025);

      text-decoration: none;

      transition:
        transform .2s ease,
        border-color .2s ease;
    }

    .database-card:hover {
      border-color:
        rgba(255,255,255,.23);

      transform:
        translateY(-3px);
    }

    .card-index {
      color: #586572;

      font-size: .58rem;
      font-weight: 800;
    }

    .card-content {
      margin-top: auto;
    }

    .card-category {
      color: #687583;

      font-size: .55rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .database-card h3 {
      margin: 7px 0 8px;

      font-size: 1.45rem;
      letter-spacing: -.035em;
    }

    .database-card p {
      max-width: 390px;

      margin: 0;

      color: #788592;

      font-size: .68rem;
      line-height: 1.75;
    }

    .arrow {
      position: absolute;

      right: 25px;
      top: 25px;

      color: #71808d;

      font-size: .9rem;
    }

    .principles-grid {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 80px;
    }

    .principles-grid h2 {
      margin: 12px 0 18px;

      font-size: clamp(2.4rem, 5vw, 4.5rem);

      line-height: .95;
      letter-spacing: -.055em;
    }

    .principle-lead {
      max-width: 450px;

      color: #84909d;

      font-size: .78rem;
      line-height: 1.9;
    }

    .principle-list {
      border-top:
        1px solid rgba(255,255,255,.08);
    }

    .principle {
      display: grid;

      grid-template-columns: 50px 1fr;

      gap: 15px;

      padding: 20px 0;

      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .principle > span {
      color: #5e6b78;

      font-size: .58rem;
      font-weight: 800;
    }

    .principle strong {
      font-size: .78rem;
    }

    .principle p {
      margin: 5px 0 0;

      color: #778491;

      font-size: .65rem;
    }

    .path-section {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .path-section .section-inner {
      padding: 42px 0;
    }

    .path {
      display: flex;

      align-items: center;

      gap: 10px;

      margin-top: 18px;

      overflow-x: auto;

      white-space: nowrap;
    }

    .path span {
      color: #6e7b88;

      font-size: .55rem;
      font-weight: 750;
      letter-spacing: .07em;
    }

    .path b {
      color: #4d5965;

      font-size: .6rem;
    }


    @media (max-width: 850px) {

      .research-feature {
        grid-template-columns: 1fr;
      }

      .principles-grid {
        grid-template-columns: 1fr;
        gap: 45px;
      }

    }


    @media (max-width: 650px) {

      .hero-inner,
      .section-inner {
        width:
          min(100% - 32px, 1180px);
      }

      .hero-inner {
        padding:
          70px 0 65px;
      }

      .hero h1 {
        font-size:
          clamp(3.2rem, 18vw, 5rem);
      }

      .section-inner {
        padding:
          55px 0;
      }

      .section-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .database-grid {
        grid-template-columns: 1fr;
      }

      .feature-main {
        padding: 25px;
      }

    }

  </style>

</BaseLayout>
