---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Downloads｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">DOWNLOADS · RESEARCH LIBRARY · V1.1-10-D</div>

    <h1>研究資料庫</h1>

    <p>
      從 Research、Industry Maps、Posters 到 First Printing，
      將《J 的世界 Research》的研究內容集中保存，
      建立可以閱讀、下載與持續追蹤的研究資料庫。
    </p>

  </div>

</section>


<!-- =========================================================
     FEATURED EDITION
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">FEATURED EDITION</div>
      <h2>Research Vol.01</h2>
    </div>

    <p>AI Platform Evolution · P1–P8</p>

  </div>


  <div class="library-card">

    <div class="library-main">

      <span class="tag">VOL.01 · FIRST PRINTING</span>

      <h3>AI Platform Evolution</h3>

      <p>
        從台積電 2026 China Technology Symposium 出發，
        拆解 AI Platform 從先進製程、先進封裝、
        光互連、Glass Core、材料設備，
        一路延伸至 AI Infrastructure 的完整技術路徑。
      </p>


      <div class="edition-meta">

        <span>P1–P8</span>
        <span>Facts First</span>
        <span>Evidence-Based Research</span>
        <span>First Printing</span>

      </div>

    </div>


    <div class="edition-actions">

      <a
        class="button"
        href="/research"
      >
        閱讀 Research →
      </a>

      <a
        class="button-secondary"
        href="/maps"
      >
        Industry Maps
      </a>

      <a
        class="button-secondary"
        href="/posters"
      >
        Posters Gallery
      </a>

      <a
        class="button-secondary"
        href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
        target="_blank"
        rel="noopener"
      >
        開啟 First Printing PDF ↗
      </a>

    </div>

  </div>

</section>


<!-- =========================================================
     FIRST PRINTING
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">FIRST PRINTING</div>
        <h2>Research Vol.01 · 印刷級版本</h2>
      </div>

      <p>Digital Archive</p>

    </div>


    <div class="printing-card">

      <div class="printing-cover">

        <div class="cover-label">
          J 的世界 Research
        </div>

        <div class="cover-vol">
          VOL.01
        </div>

        <div class="cover-title">
          AI Platform
          <br />
          Evolution
        </div>

        <div class="cover-subtitle">
          Facts First · Evidence-Based Research
        </div>

        <div class="cover-date">
          2026
        </div>

      </div>


      <div class="printing-content">

        <span class="tag">FIRST PRINTING · PDF</span>

        <h3>《J 的世界 Research Vol.01》</h3>

        <p>
          第一版完整研究出版品。
          收錄 P1–P8 研究架構，
          從事件、Evidence、Technology，
          到 Glass Core、Investment Matrix
          與 Future Watch。
        </p>


        <div class="printing-points">

          <div>
            <strong>P1–P2</strong>
            <span>Story · Evidence</span>
          </div>

          <div>
            <strong>P3–P5</strong>
            <span>AI Platform · Technology</span>
          </div>

          <div>
            <strong>P6–P8</strong>
            <span>Investment Matrix · Methodology</span>
          </div>

        </div>


        <a
          class="button"
          href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
          target="_blank"
          rel="noopener"
        >
          開啟 First Printing →
        </a>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     RESEARCH NAVIGATION
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">RESEARCH NAVIGATION</div>
      <h2>從 PDF 回到研究</h2>
    </div>

    <p>Research → Maps → Posters</p>

  </div>


  <div class="grid">


    <article class="card">

      <span class="tag">01 · RESEARCH</span>

      <h3>完整研究文章</h3>

      <p>
        閱讀 Research Vol.01 完整內容，
        了解 AI Platform Evolution
        的研究邏輯與技術路徑。
      </p>

      <a
        class="button-secondary"
        href="/research"
      >
        Open Research →
      </a>

    </article>


    <article class="card">

      <span class="tag">02 · INDUSTRY MAPS</span>

      <h3>產業地圖</h3>

      <p>
        將研究中的技術節點重新整理成
        AI Ecosystem、Glass Core
        與 CPO 三張核心產業地圖。
      </p>

      <a
        class="button-secondary"
        href="/maps"
      >
        Open Industry Maps →
      </a>

    </article>


    <article class="card">

      <span class="tag">03 · POSTERS</span>

      <h3>研究海報</h3>

      <p>
        將複雜研究濃縮成一頁式視覺內容，
        適合快速理解研究主題與產業關係。
      </p>

      <a
        class="button-secondary"
        href="/posters"
      >
        Open Posters →
      </a>

    </article>


  </div>

</section>


<!-- =========================================================
     EDITION STRUCTURE
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">EDITION STRUCTURE</div>
        <h2>Research Vol.01 的四種閱讀方式</h2>
      </div>

    </div>


    <div class="grid">


      <article class="card edition-card">

        <div class="edition-number">
          01
        </div>

        <span class="tag">READ</span>

        <h3>Research</h3>

        <p>
          以文章形式完整閱讀研究內容，
          理解事件、證據與技術推論。
        </p>

        <a href="/research">
          進入 Research →
        </a>

      </article>


      <article class="card edition-card">

        <div class="edition-number">
          02
        </div>

        <span class="tag">MAP</span>

        <h3>Industry Maps</h3>

        <p>
          用產業鏈視角快速理解
          技術節點與供應鏈位置。
        </p>

        <a href="/maps">
          進入 Industry Maps →
        </a>

      </article>


      <article class="card edition-card">

        <div class="edition-number">
          03
        </div>

        <span class="tag">VISUAL</span>

        <h3>Posters</h3>

        <p>
          用視覺化方式快速掌握
          一個研究主題的核心訊號。
        </p>

        <a href="/posters">
          進入 Posters →
        </a>

      </article>


      <article class="card edition-card">

        <div class="edition-number">
          04
        </div>

        <span class="tag">PRINT</span>

        <h3>First Printing</h3>

        <p>
          將完整研究保存成正式
          印刷級 PDF 出版版本。
        </p>

        <a
          href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
          target="_blank"
          rel="noopener"
        >
          開啟 PDF →
        </a>

      </article>


    </div>

  </div>

</section>


<!-- =========================================================
     RESEARCH STATUS
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">RESEARCH STATUS</div>
      <h2>Evidence Framework</h2>
    </div>

    <p>Facts First</p>

  </div>


  <div class="status-card">

    <div class="status-item">

      <span class="status-index">01</span>

      <div>
        <strong>FACT</strong>
        <h3>公開資訊</h3>
        <p>
          公司公告、官方技術資料、
          公開文件與可驗證資訊。
        </p>
      </div>

    </div>


    <div class="status-item">

      <span class="status-index">02</span>

      <div>
        <strong>EVIDENCE</strong>
        <h3>驗證與導入</h3>
        <p>
          技術驗證、客戶導入、
          製程整合與量產進度。
        </p>
      </div>

    </div>


    <div class="status-item">

      <span class="status-index">03</span>

      <div>
        <strong>INFERENCE</strong>
        <h3>產業推論</h3>
        <p>
          尚未正式公告，但值得持續追蹤的
          技術與供應鏈研究假設。
        </p>
      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">J 的世界 RESEARCH</div>

      <h2>
        從一份 PDF，
        建立一套可以持續更新的研究系統。
      </h2>

      <p>
        Research 是內容，
        Industry Maps 是結構，
        Posters 是視覺，
        First Printing 則是完整保存。
      </p>

    </div>


    <a
      class="button"
      href="/research"
    >
      回到 Research →
    </a>

  </div>

</section>


<style>

  .library-card {
    border: 1px solid #344457;
    background:
      linear-gradient(
        135deg,
        rgba(28, 42, 58, 0.96),
        rgba(14, 21, 30, 0.98)
      );
    border-radius: 20px;
    padding: 36px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 42px;
    align-items: center;
  }

  .library-card h3 {
    font-size: 30px;
    margin: 10px 0;
  }

  .library-card p {
    color: #aeb9c6;
    max-width: 760px;
  }


  .edition-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .edition-meta span {
    border: 1px solid #354457;
    border-radius: 7px;
    padding: 5px 9px;
    color: #b9c6d4;
    font-size: 12px;
  }


  .edition-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 190px;
  }

  .edition-actions .button-secondary {
    text-align: center;
  }


  /* FIRST PRINTING */

  .printing-card {
    display: grid;
    grid-template-columns: 330px 1fr;
    gap: 46px;
    align-items: stretch;
  }

  .printing-cover {
    min-height: 430px;
    border: 1px solid #354457;
    border-radius: 18px;
    padding: 30px;
    background:
      radial-gradient(
        circle at 80% 15%,
        #263b53 0,
        transparent 42%
      ),
      linear-gradient(
        160deg,
        #101a26,
        #0b1017
      );
    display: flex;
    flex-direction: column;
  }

  .cover-label {
    color: #91a7bd;
    font-size: 11px;
    letter-spacing: .16em;
    font-weight: 800;
  }

  .cover-vol {
    margin-top: 60px;
    font-size: 14px;
    color: #7188a0;
    letter-spacing: .2em;
    font-weight: 800;
  }

  .cover-title {
    margin-top: 18px;
    font-size: 38px;
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -.04em;
  }

  .cover-subtitle {
    margin-top: auto;
    color: #8e9aaa;
    font-size: 12px;
    line-height: 1.6;
  }

  .cover-date {
    margin-top: 18px;
    font-size: 12px;
    color: #6f8092;
  }


  .printing-content {
    padding: 18px 0;
  }

  .printing-content h3 {
    font-size: 30px;
    margin: 12px 0;
  }

  .printing-content p {
    max-width: 720px;
    color: #aeb9c6;
  }


  .printing-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 28px 0;
  }

  .printing-points div {
    border: 1px solid #2b394a;
    border-radius: 12px;
    padding: 15px;
    background: #0d141d;
  }

  .printing-points strong {
    display: block;
    color: #dce5ee;
    font-size: 14px;
  }

  .printing-points span {
    display: block;
    margin-top: 5px;
    color: #7f8d9d;
    font-size: 12px;
  }


  /* EDITION */

  .edition-card {
    position: relative;
    min-height: 260px;
  }

  .edition-number {
    font-size: 36px;
    font-weight: 800;
    color: #344457;
    line-height: 1;
    margin-bottom: 22px;
  }

  .edition-card a {
    display: inline-block;
    margin-top: 12px;
    color: #d7e2ed;
    font-size: 13px;
    font-weight: 800;
  }


  /* STATUS */

  .status-card {
    border: 1px solid #2b394a;
    border-radius: 18px;
    overflow: hidden;
    background: #0e151e;
  }

  .status-item {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 22px;
    padding: 25px 28px;
    border-bottom: 1px solid #263242;
  }

  .status-item:last-child {
    border-bottom: 0;
  }

  .status-index {
    font-size: 22px;
    font-weight: 800;
    color: #526981;
  }

  .status-item strong {
    font-size: 11px;
    letter-spacing: .14em;
    color: #8fa6bf;
  }

  .status-item h3 {
    margin: 5px 0;
    font-size: 20px;
  }

  .status-item p {
    margin: 0;
    color: #8795a5;
  }


  @media(max-width:800px) {

    .library-card {
      grid-template-columns: 1fr;
      padding: 26px;
      gap: 25px;
    }

    .library-card h3 {
      font-size: 26px;
    }

    .edition-actions {
      min-width: 0;
    }

    .edition-actions .button,
    .edition-actions .button-secondary {
      text-align: center;
    }


    .printing-card {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .printing-cover {
      min-height: 380px;
    }

    .printing-points {
      grid-template-columns: 1fr;
    }

    .printing-content h3 {
      font-size: 25px;
    }


    .status-item {
      grid-template-columns: 45px 1fr;
      padding: 22px;
      gap: 12px;
    }

  }

</style>

</BaseLayout>
