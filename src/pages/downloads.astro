---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Downloads｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">DOWNLOADS · RESEARCH LIBRARY</div>

    <h1>研究資料庫</h1>

    <p>
      集中整理《J 的世界 Research》的研究報告、
      印刷級出版品、研究海報與產業地圖。
    </p>

  </div>

</section>


<!-- =========================================================
     FIRST PRINTING
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">FIRST PRINTING · VOL.01</div>
      <h2>Research Vol.01</h2>
    </div>

    <p>AI Platform Evolution · P1–P8</p>

  </div>


  <div class="library-card">

    <div>

      <span class="tag">FIRST PRINTING · 2026</span>

      <h3>AI Platform Evolution</h3>

      <p>
        從台積電 2026 China Technology Symposium 出發，
        拆解 AI Platform 從先進製程、先進封裝、
        光互連、材料，到 AI Infrastructure 的演進。
      </p>

      <p>
        本版本為《J 的世界 Research Vol.01》
        First Printing 正式出版版本。
      </p>


      <div class="edition-meta">

        <span>P1–P8</span>
        <span>Facts First</span>
        <span>Evidence-Based Research</span>
        <span>First Printing</span>

      </div>

    </div>


    <div class="edition-actions">

      <a
        class="button primary-button"
        href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
        target="_blank"
        rel="noopener"
      >
        Open First Printing PDF →
      </a>

      <a class="button-secondary" href="/research">
        Read Research
      </a>

      <a class="button-secondary" href="/maps">
        Industry Maps
      </a>

      <a class="button-secondary" href="/posters">
        Posters
      </a>

    </div>

  </div>

</section>


<!-- =========================================================
     RESEARCH MATERIALS
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">RESEARCH MATERIALS</div>
        <h2>研究資料</h2>
      </div>

      <p>Research Library</p>

    </div>


    <div class="grid">


      <!-- RESEARCH -->

      <article class="card">

        <span class="tag">RESEARCH</span>

        <h3>AI Platform Evolution</h3>

        <p>
          完整研究內容 P1–P8。
          從事件、證據、技術路徑一路延伸至
          Glass Core、AI Infrastructure 與 Future Watch。
        </p>

        <a class="button-secondary" href="/research">
          Open Research →
        </a>

      </article>


      <!-- MAPS -->

      <article class="card">

        <span class="tag">INDUSTRY MAPS</span>

        <h3>Technology Maps</h3>

        <p>
          以技術節點、供應鏈位置與 Evidence Level
          建立 AI 產業鏈研究框架。
        </p>

        <a class="button-secondary" href="/maps">
          Open Maps →
        </a>

      </article>


      <!-- POSTERS -->

      <article class="card">

        <span class="tag">POSTERS</span>

        <h3>Industry Posters</h3>

        <p>
          將 AI、Glass Core 與 CPO 等研究內容
          濃縮成一頁式視覺化研究。
        </p>

        <a class="button-secondary" href="/posters">
          Open Posters →
        </a>

      </article>


    </div>

  </div>

</section>


<!-- =========================================================
     PUBLICATION STATUS
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>

      <div class="kicker">PUBLICATION STATUS</div>

      <h2>Research Editions</h2>

    </div>

    <p>Publication Roadmap</p>

  </div>


  <div class="grid">


    <article class="card publication-card">

      <span class="tag">VOL.01</span>

      <h3>AI Platform Evolution</h3>

      <p>
        First Printing 已正式完成，
        Research Vol.01 P1–P8
        已建立完整研究架構。
      </p>

      <div class="status">
        ● FIRST PRINTING
      </div>

    </article>


    <article class="card publication-card">

      <span class="tag">POSTER EDITION</span>

      <h3>Research Posters</h3>

      <p>
        將 Research Vol.01 的核心研究內容
        轉化為適合簡報、分享與快速閱讀的
        視覺化研究海報。
      </p>

      <div class="status pending">
        ● IN PROGRESS
      </div>

    </article>


    <article class="card publication-card">

      <span class="tag">DIGITAL EDITION</span>

      <h3>Digital Research Library</h3>

      <p>
        後續逐步建立數位閱讀版、
        研究附件與產業地圖資料庫。
      </p>

      <div class="status pending">
        ● BUILDING
      </div>

    </article>


  </div>

</section>


<!-- =========================================================
     RESEARCH PHILOSOPHY
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">RESEARCH PHILOSOPHY</div>
        <h2>Facts First · Evidence-Based Research</h2>
      </div>

    </div>


    <article class="card philosophy-card">

      <p>
        《J 的世界 Research》不以預測股價為研究起點，
        而是從技術、產業鏈與公開證據出發，
        觀察一項技術如何從研發、驗證，
        最終進入量產與產業擴散。
      </p>

      <p>
        對於尚未被公司正式公告、
        但具有研究價值的市場訊號，
        將明確標示為
        <strong>J Insight · Inference</strong>，
        並與 Fact 分開。
      </p>

      <p class="muted">
        本網站資料僅供資訊分享及研究學習用途，
        不作為投資進出場之依據。
      </p>

    </article>

  </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">RESEARCH VOL.01</div>

      <h2>從 First Printing，進入研究本身。</h2>

      <p>
        閱讀完整 Research Vol.01，
        或從 Industry Maps / Posters
        探索 AI Platform 的技術路徑。
      </p>

    </div>


    <div class="cta-actions">

      <a
        class="button"
        href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
        target="_blank"
        rel="noopener"
      >
        Open PDF →
      </a>

      <a class="button-secondary" href="/research">
        Read Research
      </a>

    </div>

  </div>

</section>


<style>

  .library-card {
    border: 1px solid #344457;
    background:
      linear-gradient(
        135deg,
        rgba(28, 42, 58, 0.95),
        rgba(14, 21, 30, 0.96)
      );
    border-radius: 20px;
    padding: 34px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: center;
  }


  .library-card h3 {
    font-size: 30px;
    margin: 10px 0;
  }


  .library-card p {
    color: #aeb9c6;
    max-width: 720px;
  }


  .edition-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }


  .edition-meta span {
    border: 1px solid #354457;
    border-radius: 7px;
    padding: 5px 9px;
    color: #b9c6d4;
    font-size: 12px;
  }


  .edition-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 210px;
  }


  .edition-actions .button,
  .edition-actions .button-secondary {
    text-align: center;
    white-space: nowrap;
  }


  .primary-button {
    box-shadow:
      0 8px 24px rgba(0,0,0,.25);
  }


  .card .button-secondary {
    display: inline-block;
    margin-top: 16px;
  }


  .publication-card {
    min-height: 250px;
    display: flex;
    flex-direction: column;
  }


  .publication-card p {
    flex: 1;
  }


  .status {
    margin-top: 18px;
    color: #c9d5e2;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
  }


  .status.pending {
    color: #7f8d9d;
  }


  .philosophy-card {
    max-width: 900px;
  }


  .philosophy-card strong {
    color: #dce6f0;
  }


  .muted {
    color: #7f8d9d !important;
    font-size: 12px;
  }


  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 180px;
  }


  .cta-actions .button,
  .cta-actions .button-secondary {
    text-align: center;
  }


  @media(max-width:800px) {

    .library-card {
      grid-template-columns: 1fr;
      padding: 26px;
      gap: 24px;
    }


    .library-card h3 {
      font-size: 26px;
    }


    .edition-actions {
      min-width: 0;
    }


    .edition-actions .button,
    .edition-actions .button-secondary {
      text-align: center;
    }


    .cta-actions {
      margin-top: 24px;
      min-width: 0;
    }

  }

</style>

</BaseLayout>
