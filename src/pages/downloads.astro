---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Downloads｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">DOWNLOADS · RESEARCH LIBRARY</div>

    <h1>研究資料庫</h1>

    <p>
      集中整理《J 的世界 Research》的研究報告、
      印刷級 PDF、研究海報與產業地圖。
    </p>

  </div>

</section>


<!-- =========================================================
     FIRST PRINTING
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">RESEARCH EDITION · FIRST PRINTING</div>
      <h2>Research Vol.01</h2>
    </div>

    <p>AI Platform Evolution · P1–P8</p>

  </div>


  <div class="library-card first-printing">

    <div class="edition-cover">

      <div class="cover-kicker">
        J 的世界 RESEARCH
      </div>

      <div class="cover-title">
        AI Platform<br />
        Evolution
      </div>

      <div class="cover-subtitle">
        Research Vol.01
      </div>

      <div class="cover-line"></div>

      <div class="cover-description">
        From Advanced Process to<br />
        Advanced Packaging · Optical Interconnect<br />
        Materials · Infrastructure
      </div>

      <div class="cover-edition">
        FIRST PRINTING · 2026
      </div>

    </div>


    <div class="edition-content">

      <span class="tag">VOL.01 · FIRST PRINTING</span>

      <h3>
        AI Platform Evolution
      </h3>

      <p class="edition-lead">
        從台積電 2026 China Technology Symposium 出發，
        建立 AI Platform 的完整研究路徑。
      </p>

      <p>
        本期研究從先進製程、先進封裝開始，
        延伸至光互連、Glass Core、材料、
        散熱、電力與 AI Infrastructure。
      </p>


      <div class="edition-meta">

        <span>P1–P8</span>
        <span>First Printing</span>
        <span>Print Ready PDF</span>
        <span>Facts First</span>
        <span>Evidence-Based Research</span>

      </div>


      <div class="edition-actions">

        <a
          class="button primary-download"
          href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
          target="_blank"
          rel="noopener"
        >
          Download First Printing PDF ↓
        </a>

        <a
          class="button-secondary"
          href="/research"
        >
          Read Research →
        </a>

        <a
          class="button-secondary"
          href="/maps"
        >
          Industry Maps →
        </a>

        <a
          class="button-secondary"
          href="/posters"
        >
          Research Posters →
        </a>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     RESEARCH LIBRARY
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">RESEARCH MATERIALS</div>
        <h2>研究資料</h2>
      </div>

      <p>Research Library</p>

    </div>


    <div class="grid">


      <!-- RESEARCH -->

      <article class="card library-item">

        <span class="tag">RESEARCH</span>

        <div class="library-number">
          01
        </div>

        <h3>AI Platform Evolution</h3>

        <p>
          完整 Research Vol.01，
          從產業事件、證據與技術路徑，
          一路延伸至 Glass Core、
          AI Infrastructure 與 Future Watch。
        </p>

        <a
          class="button-secondary"
          href="/research"
        >
          Open Research →
        </a>

      </article>


      <!-- MAPS -->

      <article class="card library-item">

        <span class="tag">INDUSTRY MAPS</span>

        <div class="library-number">
          02
        </div>

        <h3>Technology Maps</h3>

        <p>
          以技術節點、供應鏈位置與
          Evidence Level 建立 AI
          產業鏈研究框架。
        </p>

        <a
          class="button-secondary"
          href="/maps"
        >
          Open Industry Maps →
        </a>

      </article>


      <!-- POSTERS -->

      <article class="card library-item">

        <span class="tag">POSTERS</span>

        <div class="library-number">
          03
        </div>

        <h3>Research Posters</h3>

        <p>
          將 AI、Glass Core、CPO 等研究內容
          濃縮成一頁式視覺化研究，
          用於快速理解產業結構。
        </p>

        <a
          class="button-secondary"
          href="/posters"
        >
          Open Posters →
        </a>

      </article>


    </div>

  </div>

</section>


<!-- =========================================================
     FIRST PRINTING CONTENT
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">VOL.01 · CONTENT</div>
      <h2>本期研究內容</h2>
    </div>

    <p>Eight Research Sections</p>

  </div>


  <div class="content-index">


    <a href="/research#p1" class="content-row">
      <span>P1</span>
      <strong>Story</strong>
      <em>從一場技術論壇開始</em>
    </a>


    <a href="/research#p2" class="content-row">
      <span>P2</span>
      <strong>Evidence</strong>
      <em>先把「事實」與「推論」分開</em>
    </a>


    <a href="/research#p3" class="content-row">
      <span>P3</span>
      <strong>AI Platform Evolution</strong>
      <em>四個訊號如何共同打造下一代 AI 平台？</em>
    </a>


    <a href="/research#p4" class="content-row">
      <span>P4</span>
      <strong>Technology</strong>
      <em>從晶片走向系統</em>
    </a>


    <a href="/research#p5" class="content-row">
      <span>P5</span>
      <strong>Glass Core</strong>
      <em>Glass Core：結果，而不是起點</em>
    </a>


    <a href="/research#p6" class="content-row">
      <span>P6</span>
      <strong>Investment Matrix</strong>
      <em>技術節點，如何轉換成產業觀察？</em>
    </a>


    <a href="/research#p7" class="content-row">
      <span>P7</span>
      <strong>Future Watch</strong>
      <em>下一個真正值得驗證的訊號</em>
    </a>


    <a href="/research#p8" class="content-row">
      <span>P8</span>
      <strong>Reference & Methodology</strong>
      <em>研究方法</em>
    </a>


  </div>

</section>


<!-- =========================================================
     RESEARCH PHILOSOPHY
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">RESEARCH PHILOSOPHY</div>
        <h2>Facts First · Evidence-Based Research</h2>
      </div>

    </div>


    <div class="grid">

      <article class="card">

        <span class="tag">FACTS FIRST</span>

        <h3>事實優先</h3>

        <p>
          公開資訊、公司揭露與官方技術資料優先，
          避免將市場推測寫成已確認結果。
        </p>

      </article>


      <article class="card">

        <span class="tag">EVIDENCE</span>

        <h3>證據導向</h3>

        <p>
          技術路徑、供應鏈、驗證與量產進度
          交叉檢視，建立可追蹤的研究框架。
        </p>

      </article>


      <article class="card">

        <span class="tag">J INSIGHT</span>

        <h3>產業推論</h3>

        <p>
          尚未被正式公告、但值得追蹤的內容，
          明確標示為 Inference，
          與公開事實分開。
        </p>

      </article>

    </div>

  </div>

</section>


<!-- =========================================================
     CTA
========================================================= -->

<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">RESEARCH VOL.01</div>

      <h2>
        從 PDF，回到研究本身。
      </h2>

      <p>
        閱讀完整 Research Vol.01，
        或透過 Industry Maps 與 Posters
        從不同角度探索 AI Platform。
      </p>

    </div>


    <div class="cta-actions">

      <a
        class="button"
        href="/research"
      >
        Read Research →
      </a>

      <a
        class="button-secondary"
        href="/maps"
      >
        Industry Maps
      </a>

    </div>

  </div>

</section>


<style>

  /* =====================================================
     FIRST PRINTING
  ===================================================== */

  .first-printing {
    border: 1px solid #40536a;
    background:
      linear-gradient(
        135deg,
        rgba(28, 42, 58, 0.98),
        rgba(10, 16, 23, 0.98)
      );
    border-radius: 22px;
    padding: 34px;
    display: grid;
    grid-template-columns: 330px 1fr;
    gap: 44px;
    align-items: stretch;
    box-shadow: 0 18px 50px rgba(0,0,0,.22);
  }


  /* =====================================================
     PDF COVER
  ===================================================== */

  .edition-cover {
    min-height: 430px;
    border: 1px solid #3a4b5e;
    border-radius: 14px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    background:
      radial-gradient(
        circle at 85% 15%,
        rgba(88,112,140,.32),
        transparent 35%
      ),
      linear-gradient(
        145deg,
        #172331,
        #080d13
      );
  }


  .cover-kicker {
    font-size: 11px;
    letter-spacing: .18em;
    font-weight: 800;
    color: #9aafc3;
  }


  .cover-title {
    font-size: 38px;
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -.04em;
  }


  .cover-subtitle {
    color: #aab8c6;
    font-size: 15px;
    margin-top: 8px;
  }


  .cover-line {
    width: 55px;
    height: 2px;
    background: #879caf;
    margin: 24px 0;
  }


  .cover-description {
    color: #8f9dac;
    font-size: 12px;
    line-height: 1.8;
  }


  .cover-edition {
    color: #71869b;
    font-size: 10px;
    letter-spacing: .16em;
    font-weight: 800;
  }


  /* =====================================================
     EDITION CONTENT
  ===================================================== */

  .edition-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }


  .edition-content h3 {
    font-size: 34px;
    margin: 12px 0;
  }


  .edition-content p {
    color: #aeb9c6;
    max-width: 760px;
  }


  .edition-lead {
    font-size: 17px;
    color: #d2dbe5 !important;
  }


  .edition-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 24px;
  }


  .edition-meta span {
    border: 1px solid #354457;
    border-radius: 7px;
    padding: 5px 9px;
    color: #b9c6d4;
    font-size: 12px;
  }


  /* =====================================================
     ACTIONS
  ===================================================== */

  .edition-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }


  .primary-download {
    padding: 13px 18px;
    font-size: 14px;
  }


  .button-secondary {
    display: inline-block;
    border: 1px solid #3b4c5f;
    background: rgba(18,27,38,.7);
    color: #c5d0dc;
    padding: 9px 14px;
    border-radius: 9px;
    font-weight: 700;
    font-size: 13px;
    transition: .2s ease;
  }


  .button-secondary:hover {
    border-color: #71869b;
    color: #fff;
    background: rgba(32,45,60,.9);
  }


  /* =====================================================
     LIBRARY
  ===================================================== */

  .library-item {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }


  .library-number {
    margin-top: 18px;
    font-size: 12px;
    color: #667d94;
    letter-spacing: .12em;
    font-weight: 800;
  }


  .library-item h3 {
    margin-top: 5px;
  }


  .library-item p {
    flex: 1;
  }


  /* =====================================================
     CONTENT INDEX
  ===================================================== */

  .content-index {
    border-top: 1px solid #2b394a;
  }


  .content-row {
    display: grid;
    grid-template-columns: 70px 260px 1fr;
    align-items: center;
    gap: 20px;
    padding: 18px 4px;
    border-bottom: 1px solid #263242;
    transition: .2s ease;
  }


  .content-row:hover {
    padding-left: 10px;
    background: rgba(255,255,255,.025);
  }


  .content-row span {
    color: #7188a0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .1em;
  }


  .content-row strong {
    color: #d8e1ea;
    font-size: 14px;
  }


  .content-row em {
    color: #8997a6;
    font-style: normal;
    font-size: 14px;
  }


  /* =====================================================
     CTA
  ===================================================== */

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }


  /* =====================================================
     MOBILE
  ===================================================== */

  @media(max-width:800px) {

    .first-printing {
      grid-template-columns: 1fr;
      padding: 20px;
      gap: 26px;
    }


    .edition-cover {
      min-height: 380px;
    }


    .cover-title {
      font-size: 34px;
    }


    .edition-content h3 {
      font-size: 28px;
    }


    .edition-actions {
      flex-direction: column;
      align-items: stretch;
    }


    .edition-actions .button,
    .edition-actions .button-secondary {
      width: 100%;
      text-align: center;
    }


    .content-row {
      grid-template-columns: 48px 1fr;
      gap: 10px;
    }


    .content-row em {
      grid-column: 2;
      font-size: 13px;
    }


    .cta-actions {
      margin-top: 24px;
      flex-direction: column;
      align-items: stretch;
    }


    .cta-actions .button,
    .cta-actions .button-secondary {
      width: 100%;
      text-align: center;
    }

  }

</style>

</BaseLayout>
