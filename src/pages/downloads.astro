---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Research Library｜J 的世界 Research">

<section class="page-hero">
  <div class="page-hero-inner">
    <div class="kicker">RESEARCH LIBRARY · V1.1</div>
    <h1>研究資料庫</h1>
    <p>
      集中收錄 J 的世界 Research 的研究報告、產業地圖、
      Research Posters 與研究方法論。
    </p>
  </div>
</section>

<!-- 01 · RESEARCH REPORTS -->
<section class="section">
  <div class="section-head">
    <div>
      <div class="kicker">01 · RESEARCH REPORTS</div>
      <h2>研究報告</h2>
    </div>
    <p>Facts First · Evidence-Based Research</p>
  </div>

  <div class="grid">

    <article class="card">
      <span class="tag">VOL.01 · AVAILABLE</span>
      <h3>AI Platform Evolution</h3>
      <p>
        從台積電技術論壇的關鍵訊號出發，
        拆解下一代 AI Platform 的技術演進、
        先進封裝、光通訊、材料與電力。
      </p>
      <a class="button" href="/research">閱讀 Research →</a>
    </article>

    <article class="card">
      <span class="tag">VOL.02 · FUTURE</span>
      <h3>Next Research Edition</h3>
      <p>
        下一期研究將持續追蹤 AI、半導體、
        先進封裝與關鍵材料的產業變化。
      </p>
      <span class="status">COMING SOON</span>
    </article>

    <article class="card">
      <span class="tag">SPECIAL EDITION</span>
      <h3>Special Research</h3>
      <p>
        針對重大產業事件與技術突破，
        不定期推出專題研究。
      </p>
      <span class="status">COMING SOON</span>
    </article>

  </div>
</section>


<!-- 02 · INDUSTRY MAPS -->
<section class="feature">
  <div class="section">

    <div class="section-head">
      <div>
        <div class="kicker">02 · INDUSTRY MAPS</div>
        <h2>產業地圖</h2>
      </div>
      <a class="button" href="/maps">查看全部地圖 →</a>
    </div>

    <div class="grid">

      <article class="map-card">
        <span class="tag">AI ECOSYSTEM</span>
        <h3>AI 全產業鏈</h3>
        <p>
          AI Chip → Advanced Packaging →
          Optical → Server → Power → Cooling
        </p>
        <a href="/maps" class="text-link">查看地圖 →</a>
      </article>

      <article class="map-card">
        <span class="tag">GLASS CORE</span>
        <h3>Glass Core Ecosystem</h3>
        <p>
          Glass → TGV → Core Substrate →
          Advanced Packaging → AI Accelerator
        </p>
        <a href="/maps" class="text-link">查看地圖 →</a>
      </article>

      <article class="map-card">
        <span class="tag">CPO</span>
        <h3>CPO Ecosystem</h3>
        <p>
          Switch → Optical Engine → Fiber →
          Packaging → Thermal → Power
        </p>
        <a href="/maps" class="text-link">查看地圖 →</a>
      </article>

    </div>

  </div>
</section>


<!-- 03 · RESEARCH POSTERS -->
<section class="section">

  <div class="section-head">
    <div>
      <div class="kicker">03 · RESEARCH POSTERS</div>
      <h2>研究海報</h2>
    </div>
    <p>Visual Research · Supply Chain Maps</p>
  </div>

  <div class="grid">

    <article class="card">
      <span class="tag">AI PLATFORM</span>
      <h3>AI Platform Evolution</h3>
      <p>
        將 AI Chip、Advanced Packaging、
        Optical、Server、Power 與 Cooling
        串成完整產業鏈。
      </p>
      <span class="status">COMING SOON</span>
    </article>

    <article class="card">
      <span class="tag">GLASS CORE</span>
      <h3>Glass Core</h3>
      <p>
        從玻璃材料、TGV、Core Substrate
        到先進封裝的技術路徑。
      </p>
      <span class="status">COMING SOON</span>
    </article>

    <article class="card">
      <span class="tag">CPO</span>
      <h3>CPO Ecosystem</h3>
      <p>
        從交換器、光引擎、光纖到封裝、
        散熱與電力的完整架構。
      </p>
      <span class="status">COMING SOON</span>
    </article>

  </div>

</section>


<!-- 04 · METHODOLOGY -->
<section class="feature">

  <div class="section">

    <div class="section-head">
      <div>
        <div class="kicker">04 · METHODOLOGY</div>
        <h2>研究方法論</h2>
      </div>
      <p>Research Principles</p>
    </div>

    <div class="grid">

      <article class="map-card">
        <span class="tag">FACTS FIRST</span>
        <h3>公開資訊優先</h3>
        <p>
          以公司公告、技術文件、法說會、
          公開研究資料與產業資訊作為研究基礎。
        </p>
      </article>

      <article class="map-card">
        <span class="tag">EVIDENCE</span>
        <h3>證據導向</h3>
        <p>
          透過技術、製程、材料、設備與供應鏈
          關係進行交叉驗證。
        </p>
      </article>

      <article class="map-card">
        <span class="tag">INFERENCE</span>
        <h3>推論明確標示</h3>
        <p>
          尚未公告但具有研究價值的市場推論，
          不與已確認事實混為一談。
        </p>
      </article>

    </div>

  </div>

</section>


<!-- 05 · J INSIGHT -->
<section class="section">

  <div class="section-head">
    <div>
      <div class="kicker">05 · J INSIGHT</div>
      <h2>產業推論</h2>
    </div>
    <p>Future Watch</p>
  </div>

  <div class="card">
    <span class="tag">J INSIGHT</span>
    <h3>從證據，到下一個可能發生的事情</h3>
    <p>
      J Insight 用來收錄尚未被公開資訊完全確認，
      但具有技術邏輯、產業關係或供應鏈訊號支持的
      潛在發展方向。
    </p>
    <p>
      所有此類內容均會與已確認資訊清楚區分，
      並持續追蹤後續驗證進度。
    </p>
  </div>

</section>


<!-- 06 · DISCLAIMER -->
<section class="cta">

  <div class="cta-inner">

    <div>
      <div class="kicker">RESEARCH DISCLAIMER</div>
      <h2>研究，是持續驗證的過程。</h2>
      <p>
        本網站內容僅供資訊分享、研究與學習用途，
        不構成投資建議，亦不作為任何投資進出場依據。
      </p>
    </div>

    <a class="button" href="/research">
      開始閱讀 → 
    </a>

  </div>

</section>

</BaseLayout>
