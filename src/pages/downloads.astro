---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Downloads｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">DOWNLOADS · RESEARCH LIBRARY · V1.1-10-D</div>

    <h1>研究資料庫</h1>

    <p>
      集中整理《J 的世界 Research》的研究文章、
      印刷級 PDF、研究海報與相關研究資料。
    </p>

  </div>

</section>


<!-- =========================================================
     FEATURED PUBLICATION
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">FEATURED PUBLICATION</div>
      <h2>Research Vol.01</h2>
    </div>

    <p>First Printing · 2026</p>

  </div>


  <article class="publication-card">

    <div class="publication-cover">

      <div class="cover-kicker">
        J 的世界 Research
      </div>

      <div class="cover-title">
        AI Platform
        <br />
        Evolution
      </div>

      <div class="cover-subtitle">
        Research Vol.01
      </div>

      <div class="cover-line"></div>

      <div class="cover-footer">
        FACTS FIRST · EVIDENCE-BASED RESEARCH
      </div>

    </div>


    <div class="publication-info">

      <span class="tag">FIRST PRINTING · VOL.01</span>

      <h3>AI Platform Evolution</h3>

      <p class="publication-lead">
        從台積電 2026 China Technology Symposium
        出發，追蹤 AI Platform 從先進製程、
        先進封裝、光互連、材料到
        AI Infrastructure 的演進。
      </p>


      <div class="publication-meta">

        <div>
          <span>PAGES</span>
          <strong>P1–P8</strong>
        </div>

        <div>
          <span>EDITION</span>
          <strong>First Printing</strong>
        </div>

        <div>
          <span>FORMAT</span>
          <strong>PDF</strong>
        </div>

      </div>


      <div class="publication-actions">

        <a
          class="button"
          href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
          target="_blank"
          rel="noopener"
        >
          Open First Printing PDF →
        </a>

        <a
          class="button-secondary"
          href="/research"
        >
          Read Research
        </a>

      </div>

    </div>

  </article>

</section>


<!-- =========================================================
     RESEARCH CONNECTION
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">PUBLICATION STRUCTURE</div>
        <h2>一份研究，四種閱讀方式</h2>
      </div>

      <p>Research → Maps → Posters → PDF</p>

    </div>


    <div class="grid">


      <article class="card library-node">

        <span class="tag">01 · RESEARCH</span>

        <h3>完整研究</h3>

        <p>
          閱讀 Research Vol.01 的完整研究內容，
          從事件背景、證據、技術路徑一路看到
          Future Watch。
        </p>

        <a class="button-secondary" href="/research">
          Open Research →
        </a>

      </article>


      <article class="card library-node">

        <span class="tag">02 · INDUSTRY MAPS</span>

        <h3>產業地圖</h3>

        <p>
          將研究中的技術節點轉換成
          AI Ecosystem、Glass Core 與 CPO
          等產業鏈地圖。
        </p>

        <a class="button-secondary" href="/maps">
          Open Industry Maps →
        </a>

      </article>


      <article class="card library-node">

        <span class="tag">03 · POSTERS</span>

        <h3>研究海報</h3>

        <p>
          將複雜研究濃縮成一頁式視覺化內容，
          適合快速閱讀與簡報使用。
        </p>

        <a class="button-secondary" href="/posters">
          Open Posters →
        </a>

      </article>


    </div>

  </div>

</section>


<!-- =========================================================
     PDF ARCHIVE
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">PDF ARCHIVE</div>
      <h2>正式出版版本</h2>
    </div>

    <p>Publication Archive</p>

  </div>


  <article class="archive-card">

    <div class="archive-main">

      <span class="tag">RESEARCH VOL.01</span>

      <h3>AI Platform Evolution</h3>

      <p>
        First Printing｜P1–P8
      </p>

    </div>


    <div class="archive-status">

      <span class="status-dot"></span>

      <div>
        <strong>AVAILABLE</strong>
        <small>正式出版版本</small>
      </div>

    </div>


    <a
      class="button"
      href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
      target="_blank"
      rel="noopener"
    >
      Open PDF →
    </a>

  </article>


  <p class="archive-note">
    ※ 本 PDF 為《J 的世界 Research Vol.01》First Printing 正式版本。
  </p>

</section>


<!-- =========================================================
     RESEARCH PHILOSOPHY
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">RESEARCH PHILOSOPHY</div>
        <h2>出版的不只是結論，而是研究過程。</h2>
      </div>

    </div>


    <div class="grid">


      <article class="card">

        <span class="tag">FACTS FIRST</span>

        <h3>先建立事實</h3>

        <p>
          公開資訊、公司揭露與官方技術資料
          優先於市場傳聞。
        </p>

      </article>


      <article class="card">

        <span class="tag">EVIDENCE</span>

        <h3>再確認證據</h3>

        <p>
          從技術路徑、供應鏈位置、
          驗證進度到量產狀態交叉檢視。
        </p>

      </article>


      <article class="card">

        <span class="tag">J INSIGHT</span>

        <h3>最後才是推論</h3>

        <p>
          對尚未正式公告但值得追蹤的訊號，
          明確標示為 Inference。
        </p>

      </article>


    </div>

  </div>

</section>


<!-- =========================================================
     FINAL NAVIGATION
========================================================= -->

<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">RESEARCH VOL.01</div>

      <h2>從網頁研究，到正式出版。</h2>

      <p>
        Research 提供完整內容，
        Maps 建立產業結構，
        Posters 濃縮核心訊號，
        First Printing 則保存完整研究成果。
      </p>

    </div>


    <div class="cta-actions">

      <a class="button" href="/research">
        Read Research →
      </a>

      <a class="button-secondary" href="/maps">
        Industry Maps
      </a>

      <a class="button-secondary" href="/posters">
        Posters
      </a>

    </div>

  </div>

</section>


<style>

  /* =====================================================
     PUBLICATION CARD
  ===================================================== */

  .publication-card {

    border: 1px solid #344457;

    background:
      linear-gradient(
        135deg,
        rgba(28, 42, 58, 0.96),
        rgba(14, 21, 30, 0.98)
      );

    border-radius: 22px;

    padding: 38px;

    display: grid;

    grid-template-columns: 280px 1fr;

    gap: 46px;

    align-items: center;
  }


  /* =====================================================
     PDF COVER
  ===================================================== */

  .publication-cover {

    aspect-ratio: 0.707;

    border: 1px solid #4a5b70;

    border-radius: 8px;

    background:
      linear-gradient(
        160deg,
        #172331 0%,
        #0d141d 58%,
        #0a1017 100%
      );

    padding: 28px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    box-shadow:
      0 20px 45px rgba(0,0,0,.35);
  }


  .cover-kicker {

    font-size: 10px;

    letter-spacing: .14em;

    color: #91a7bc;

    font-weight: 800;
  }


  .cover-title {

    font-size: 34px;

    line-height: 1.08;

    font-weight: 800;

    letter-spacing: -.04em;

    color: #eef2f7;
  }


  .cover-subtitle {

    color: #9eafc1;

    font-size: 14px;
  }


  .cover-line {

    height: 1px;

    background: #415368;

    margin: 18px 0;
  }


  .cover-footer {

    font-size: 8px;

    letter-spacing: .12em;

    color: #718499;
  }


  /* =====================================================
     PUBLICATION INFO
  ===================================================== */

  .publication-info h3 {

    font-size: 36px;

    margin: 12px 0;
  }


  .publication-lead {

    color: #aeb9c6;

    max-width: 720px;

    font-size: 16px;
  }


  .publication-meta {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 26px;
  }


  .publication-meta div {

    border: 1px solid #354457;

    border-radius: 9px;

    padding: 10px 14px;

    min-width: 110px;

    background: rgba(10,16,23,.42);
  }


  .publication-meta span {

    display: block;

    color: #71859a;

    font-size: 9px;

    letter-spacing: .12em;

    font-weight: 800;
  }


  .publication-meta strong {

    display: block;

    color: #dce5ee;

    font-size: 13px;

    margin-top: 3px;
  }


  .publication-actions {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 28px;
  }


  .publication-actions .button-secondary {

    display: inline-flex;

    align-items: center;
  }


  /* =====================================================
     LIBRARY
  ===================================================== */

  .library-node {

    min-height: 100%;
  }


  .library-node .button-secondary {

    display: inline-block;

    margin-top: 14px;
  }


  /* =====================================================
     ARCHIVE
  ===================================================== */

  .archive-card {

    border: 1px solid #344457;

    border-radius: 16px;

    background: #101923;

    padding: 24px 26px;

    display: grid;

    grid-template-columns: 1fr auto auto;

    gap: 24px;

    align-items: center;
  }


  .archive-main h3 {

    margin: 8px 0 4px;

    font-size: 22px;
  }


  .archive-main p {

    margin: 0;

    color: #8493a4;

    font-size: 13px;
  }


  .archive-status {

    display: flex;

    align-items: center;

    gap: 9px;
  }


  .status-dot {

    width: 8px;

    height: 8px;

    border-radius: 50%;

    background: #7f9bb7;

    box-shadow: 0 0 10px rgba(127,155,183,.55);
  }


  .archive-status strong {

    display: block;

    font-size: 11px;

    letter-spacing: .1em;
  }


  .archive-status small {

    display: block;

    color: #718294;

    font-size: 10px;
  }


  .archive-note {

    margin-top: 12px;

    color: #68788a;

    font-size: 11px;
  }


  /* =====================================================
     CTA
  ===================================================== */

  .cta-actions {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    align-items: center;
  }


  .cta-actions .button-secondary {

    display: inline-block;
  }


  /* =====================================================
     MOBILE
  ===================================================== */

  @media(max-width:800px) {

    .publication-card {

      grid-template-columns: 1fr;

      padding: 26px;

      gap: 30px;
    }


    .publication-cover {

      width: min(100%, 280px);

      margin: auto;
    }


    .publication-info h3 {

      font-size: 28px;
    }


    .publication-actions {

      flex-direction: column;
    }


    .publication-actions .button,
    .publication-actions .button-secondary {

      width: 100%;

      text-align: center;

      justify-content: center;
    }


    .archive-card {

      grid-template-columns: 1fr;

      gap: 18px;
    }


    .archive-card .button {

      text-align: center;

      width: 100%;
    }


    .cta-actions {

      margin-top: 22px;

      flex-direction: column;

      align-items: stretch;
    }


    .cta-actions .button,
    .cta-actions .button-secondary {

      width: 100%;

      text-align: center;
    }

  }

</style>

</BaseLayout>
