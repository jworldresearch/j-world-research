---
import BaseLayout from "../layouts/BaseLayout.astro";
import { companies } from "../data/companies";

const maps = [
  {
    id: "ai-ecosystem",
    name: "AI Ecosystem",
    title: "AI 半導體製造與先進封裝平台",
    description:
      "從 AI Compute、先進製程、先進封裝一路延伸至系統整合，觀察 AI 平台的核心技術鏈。",
    layers: [
      "AI Compute",
      "Advanced Process",
      "CoWoS",
      "SoIC",
      "Advanced Packaging"
    ]
  },
  {
    id: "glass-core-ecosystem",
    name: "Glass Core Ecosystem",
    title: "玻璃核心與下一代封裝材料",
    description:
      "追蹤玻璃材料、玻璃基板、光學與先進封裝之間的技術連結。",
    layers: [
      "Glass",
      "Glass Substrate",
      "Glass Processing",
      "Advanced Packaging",
      "Optical"
    ]
  },
  {
    id: "cpo-ecosystem",
    name: "CPO Ecosystem",
    title: "Co-Packaged Optics 與高速互連",
    description:
      "從 AI Networking、Switch ASIC、Optical DSP 到光纖與高速互連，建立 CPO 技術路徑。",
    layers: [
      "Switch ASIC",
      "Networking",
      "Optical DSP",
      "Optical Fiber",
      "High-Speed Connectivity"
    ]
  }
];

function getCompaniesForMap(mapName: string) {
  return companies.filter((company) =>
    company.maps.includes(mapName)
  );
}
---

<BaseLayout
  title="Industry Maps"
  description="J 的世界 Research｜Industry Maps"
>

  <main class="maps-page">

    <!-- HERO -->

    <section class="hero">

      <div class="hero-inner">

        <span class="eyebrow">
          INDUSTRY RESEARCH
        </span>

        <h1>
          Industry Maps
        </h1>

        <p>
          將 Research 的技術路徑，
          延伸成可追蹤的產業地圖，
          再連結至企業層級資料。
        </p>

      </div>

    </section>


    <!-- MAPS -->

    <section class="maps-section">

      <div class="maps-inner">

        <div class="section-header">

          <div>
            <span class="label">
              TECHNOLOGY → INDUSTRY → COMPANY
            </span>

            <h2>
              Three Core Ecosystems
            </h2>
          </div>

          <p>
            每一張 Industry Map 都與 Companies Database
            建立雙向關聯。
          </p>

        </div>


        <div class="map-list">

          {maps.map((map, index) => {

            const mapCompanies =
              getCompaniesForMap(map.name);

            return (

              <article
                id={map.id}
                class="map-card"
              >

                <div class="map-number">
                  {String(index + 1).padStart(2, "0")}
                </div>


                <div class="map-main">

                  <div class="map-heading">

                    <span class="map-name">
                      {map.name}
                    </span>

                    <h3>
                      {map.title}
                    </h3>

                    <p>
                      {map.description}
                    </p>

                  </div>


                  <!-- TECHNOLOGY LAYERS -->

                  <div class="layer-section">

                    <span class="sub-label">
                      TECHNOLOGY LAYERS
                    </span>

                    <div class="layer-row">

                      {map.layers.map((layer) => (
                        <span class="layer">
                          {layer}
                        </span>
                      ))}

                    </div>

                  </div>


                  <!-- COMPANIES -->

                  <div class="company-section">

                    <div class="company-section-header">

                      <span class="sub-label">
                        CONNECTED COMPANIES
                      </span>

                      <span class="company-count">
                        {mapCompanies.length}
                      </span>

                    </div>


                    <div class="company-grid">

                      {mapCompanies.map((company) => (

                        <a
                          href={`/companies/${company.slug}/`}
                          class="company-link"
                        >

                          <div>

                            <strong>
                              {company.name}
                            </strong>

                            <span>
                              {company.category}
                            </span>

                          </div>

                          <b>
                            →
                          </b>

                        </a>

                      ))}

                    </div>

                  </div>

                </div>

              </article>

            );

          })}

        </div>

      </div>

    </section>


    <!-- RESEARCH CONNECTION -->

    <section class="connection-section">

      <div class="connection-inner">

        <span class="label">
          RESEARCH CONNECTION
        </span>

        <h2>
          Research → Map → Company
        </h2>

        <p>
          Industry Maps 不只是靜態產業圖，
          而是把研究內容與企業資料建立可追蹤的關係。
        </p>


        <div class="flow">

          <span>
            RESEARCH
          </span>

          <b>→</b>

          <span>
            TECHNOLOGY
          </span>

          <b>→</b>

          <span>
            INDUSTRY MAP
          </span>

          <b>→</b>

          <span>
            COMPANY
          </span>

          <b>→</b>

          <span>
            FUTURE WATCH
          </span>

        </div>

      </div>

    </section>


    <!-- NAV -->

    <section class="bottom-nav">

      <div class="bottom-nav-inner">

        <a href="/research/">
          ← Research Library
        </a>

        <a href="/companies/">
          Companies Database →
        </a>

      </div>

    </section>

  </main>


  <style>

    .maps-page {
      min-height: 100vh;
    }

    .hero,
    .maps-section,
    .connection-section,
    .bottom-nav {
      border-bottom:
        1px solid rgba(255,255,255,.08);
    }

    .hero-inner,
    .maps-inner,
    .connection-inner,
    .bottom-nav-inner {
      width:
        min(1120px, calc(100% - 48px));

      margin: 0 auto;
    }

    .hero-inner {
      padding:
        82px 0 72px;
    }

    .eyebrow,
    .label,
    .sub-label {
      color: #718091;

      font-size: .61rem;

      font-weight: 800;

      letter-spacing: .14em;
    }

    .hero h1 {
      margin:
        15px 0 20px;

      color: #edf2f6;

      font-size:
        clamp(3.2rem, 8vw, 6.5rem);

      line-height: .9;

      letter-spacing: -.065em;
    }

    .hero p {
      max-width: 650px;

      margin: 0;

      color: #7d8996;

      font-size: .78rem;

      line-height: 1.9;
    }

    .maps-inner {
      padding:
        70px 0 80px;
    }

    .section-header {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 60px;

      align-items: end;

      margin-bottom: 34px;
    }

    .section-header h2 {
      margin:
        11px 0 0;

      font-size:
        clamp(2rem, 5vw, 3.8rem);

      line-height: .95;

      letter-spacing: -.055em;
    }

    .section-header p {
      max-width: 440px;

      margin: 0;

      color: #778491;

      font-size: .68rem;

      line-height: 1.9;
    }

    .map-list {
      display: flex;

      flex-direction: column;

      gap: 12px;
    }

    .map-card {
      display: grid;

      grid-template-columns: 80px 1fr;

      overflow: hidden;

      border:
        1px solid rgba(255,255,255,.09);

      border-radius: 13px;

      background:
        rgba(255,255,255,.025);
    }

    .map-number {
      padding: 25px;

      color: #46525e;

      font-size: .65rem;

      font-weight: 800;

      border-right:
        1px solid rgba(255,255,255,.07);
    }

    .map-main {
      padding: 28px 30px 30px;
    }

    .map-name {
      color: #718091;

      font-size: .58rem;

      font-weight: 800;

      letter-spacing: .12em;
    }

    .map-heading h3 {
      margin:
        10px 0 12px;

      color: #dce3e9;

      font-size:
        clamp(1.35rem, 3vw, 2rem);

      letter-spacing: -.035em;
    }

    .map-heading p {
      max-width: 760px;

      margin: 0;

      color: #778491;

      font-size: .68rem;

      line-height: 1.8;
    }

    .layer-section {
      margin-top: 28px;

      padding-top: 23px;

      border-top:
        1px solid rgba(255,255,255,.07);
    }

    .layer-row {
      display: flex;

      flex-wrap: wrap;

      gap: 6px;

      margin-top: 12px;
    }

    .layer {
      padding:
        7px 9px;

      border-radius: 5px;

      background:
        rgba(255,255,255,.055);

      color: #7f8b98;

      font-size: .51rem;
    }

    .company-section {
      margin-top: 27px;

      padding-top: 23px;

      border-top:
        1px solid rgba(255,255,255,.07);
    }

    .company-section-header {
      display: flex;

      justify-content: space-between;

      align-items: center;
    }

    .company-count {
      color: #56636f;

      font-size: .55rem;
    }

    .company-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 8px;

      margin-top: 13px;
    }

    .company-link {
      display: flex;

      justify-content: space-between;

      align-items: center;

      min-height: 70px;

      padding: 13px;

      border:
        1px solid rgba(255,255,255,.07);

      border-radius: 8px;

      background:
        rgba(255,255,255,.018);

      color: inherit;

      text-decoration: none;

      transition:
        border-color .2s ease,
        background .2s ease;
    }

    .company-link:hover {
      border-color:
        rgba(255,255,255,.2);

      background:
        rgba(255,255,255,.035);
    }

    .company-link strong {
      display: block;

      color: #aeb8c2;

      font-size: .7rem;
    }

    .company-link span {
      display: block;

      margin-top: 4px;

      color: #667380;

      font-size: .5rem;
    }

    .company-link b {
      color: #667380;

      font-size: .7rem;
    }

    .connection-inner {
      padding:
        60px 0 65px;
    }

    .connection-inner h2 {
      margin:
        10px 0 13px;

      font-size:
        clamp(2rem, 5vw, 3.7rem);

      line-height: .95;

      letter-spacing: -.055em;
    }

    .connection-inner > p {
      max-width: 650px;

      margin: 0;

      color: #778491;

      font-size: .68rem;

      line-height: 1.9;
    }

    .flow {
      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 10px;

      margin-top: 30px;
    }

    .flow span {
      color: #707d89;

      font-size: .53rem;

      font-weight: 800;

      letter-spacing: .08em;
    }

    .flow b {
      color: #4f5b67;

      font-size: .6rem;
    }

    .bottom-nav-inner {
      padding:
        25px 0;

      display: flex;

      justify-content: space-between;
    }

    .bottom-nav a {
      color: #7e8b98;

      font-size: .61rem;

      text-decoration: none;
    }

    .bottom-nav a:hover {
      color: #c0cad3;
    }


    @media (max-width: 850px) {

      .section-header {
        grid-template-columns:
          1fr;

        gap: 22px;
      }

      .company-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }


    @media (max-width: 620px) {

      .hero-inner,
      .maps-inner,
      .connection-inner,
      .bottom-nav-inner {
        width:
          min(100% - 32px, 1120px);
      }

      .hero-inner {
        padding:
          60px 0 55px;
      }

      .maps-inner {
        padding:
          55px 0 60px;
      }

      .map-card {
        grid-template-columns:
          1fr;
      }

      .map-number {
        border-right: none;

        border-bottom:
          1px solid rgba(255,255,255,.07);
      }

      .map-main {
        padding:
          23px;
      }

      .company-grid {
        grid-template-columns:
          1fr;
      }

      .bottom-nav-inner {
        flex-direction:
          column;

        gap: 13px;
      }

    }

  </style>

</BaseLayout>
