---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="P1｜Editorial｜J 的世界 Research">
  <main class="poster-page">
    <img class="poster" src="/research-assets/P1-editorial-vertical.png" alt="J 的世界 Research P1 Editorial" />
    <nav class="page-nav" aria-label="Research navigation">
      <a class="muted" href="/">← Home</a>
      <a href="/research/p2">P2 →</a>
    </nav>
  </main>
</BaseLayout>

<style is:global>
  html, body { background:#fbfbfa !important; }
  .poster-page {
    width:100vw !important;
    max-width:none !important;
    margin-left:calc(50% - 50vw) !important;
    margin-right:calc(50% - 50vw) !important;
    padding:0 !important;
    background:#fbfbfa;
  }
  .poster { display:block; width:100% !important; max-width:none !important; height:auto; margin:0 !important; }
  .page-nav { display:flex; justify-content:space-between; padding:18px 3vw 26px; background:#fbfbfa; border-top:1px solid #e3e3e0; }
  .page-nav a { color:#10233f; text-decoration:none; font-weight:700; }
  .page-nav .muted { color:#6d7278; }
</style>
