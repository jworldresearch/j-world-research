---
import ResearchLayout from "../../layouts/ResearchLayout.astro";
---
<ResearchLayout title="P1｜Cover｜J 的世界 Research" page="P1" section="COVER">

<div class="cover-page">
  <div class="kicker">J 的世界 Research · VOL.01 · 創刊號</div>
  <h1>AI NEXT<br/>PLATFORM</h1>
  <div class="cover-subtitle">AI 基礎建設的下一個十年</div>
  <p class="lead">以台積電 2026 技術論壇為研究起點，解析下一代 AI Platform 的形成。</p>
  <div class="visual cover-visual"><img src="/research-assets/cover.png" alt="AI NEXT PLATFORM 封面"></div>
  <div class="cover-note"><strong>Facts First.</strong><br/>Evidence Before Conclusion.</div>
</div>
<style>.cover-page{background:#071a33;color:#fff;margin:-42px -58px -46px;padding:54px 58px 58px;min-height:780px;position:relative;overflow:hidden}.cover-page h1{color:#d6a84e;font-family:Georgia,serif;font-size:clamp(3rem,7vw,6rem);line-height:.92;margin:12px 0}.cover-page .lead{color:#dfe8f1;max-width:620px}.cover-page .kicker{color:#d6a84e}.cover-subtitle{font-size:1.5rem;margin:18px 0 0}.cover-visual{margin:28px 0 0;border:0}.cover-visual img{width:100%;display:block}.cover-note{position:absolute;right:58px;bottom:58px;border:1px solid #d6a84e;padding:12px 18px;text-align:center;color:#d6a84e;font-size:.82rem}@media(max-width:560px){.cover-page{margin:-24px -16px -28px;padding:34px 18px;min-height:650px}.cover-note{position:static;display:inline-block;margin-top:20px}.cover-page h1{font-size:3rem}}</style>

</ResearchLayout>
