---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="P1｜Cover｜J 的世界 Research">
  <main class="research-page">
    <div class="research-page-head">
      <a href="/research/">← Research Library</a>
      <span>VOL.01 · P1 · COVER</span>
      <a href="/research/p2/">P2 →</a>
    </div>
    <div class="poster-frame">
      <img class="poster" src="/research-assets/P1-cover-v3.png" alt="J 的世界 Research Vol.01 P1 Cover" />
    </div>
    <nav class="page-nav" aria-label="Research page navigation">
      <a class="disabled" aria-disabled="true">← PREVIOUS</a>
      <a href="/research/">VOL.01 · Research Library</a>
      <a href="/research/p2/">NEXT → P2</a>
    </nav>
  </main>
</BaseLayout>

<style is="global">
.research-page{width:100%;background:#f4f5f6;padding-bottom:0}
.research-page-head{max-width:1180px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:18px;background:#f4f5f6;color:#5d6875;font-size:.7rem;font-weight:700;letter-spacing:.08em}
.research-page-head a{color:#30435a;text-decoration:none}
.poster-frame{width:100%;display:flex;justify-content:center;background:#07172d}
.poster{display:block;width:min(100%,800px);height:auto;margin:0}
.page-nav{display:grid;grid-template-columns:1fr 1fr 1fr;max-width:800px;margin:0 auto;background:#f4f5f6;border-top:1px solid #d7dbe0}
.page-nav a{min-height:76px;padding:18px 24px;display:flex;align-items:center;text-decoration:none;color:#10233f;font-weight:700;font-size:.78rem;letter-spacing:.04em;border-right:1px solid #d7dbe0}
.page-nav a:nth-child(2){justify-content:center}
.page-nav a:last-child{justify-content:flex-end;border-right:0}
.page-nav .disabled{color:#9aa2aa}
@media(max-width:768px){
  .research-page-head{padding:12px 16px;font-size:.62rem}
  .research-page-head span{display:none}
  .poster{width:calc(100% - 24px)}
  .page-nav{grid-template-columns:1fr 1fr;max-width:none}
  .page-nav a{min-height:62px;padding:14px 16px}
  .page-nav a:nth-child(2){display:none}
  .page-nav a:last-child{grid-column:2}
}
</style>
