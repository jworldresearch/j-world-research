---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { researchVol01 } from "../../data/research-vol01";
---

<BaseLayout title="Research Library｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">
      RESEARCH LIBRARY · VOL.01
    </div>

    <h1>{researchVol01.title}</h1>

    <p>
      {researchVol01.subtitle}
    </p>

  </div>

</section>


<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">RESEARCH EDITION</div>
      <h2>AI Platform Evolution</h2>
    </div>

    <p>P1–P8</p>

  </div>


  <div class="research-intro">

    <p>
      從台積電 2026 China Technology Symposium 出發，
      追蹤 AI Platform 如何由先進製程、先進封裝、
      光互連、材料與 AI Infrastructure 共同演進。
    </p>

    <div class="intro-actions">

      <a
        class="button"
        href={researchVol01.pdf}
        target="_blank"
      >
        First Printing PDF →
      </a>

      <a
        class="button-secondary"
        href="/maps"
      >
        Industry Maps
      </a>

      <a
        class="button-secondary"
        href="/posters"
      >
        Posters
      </a>

    </div>

  </div>

</section>


<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">P1–P8</div>
        <h2>Research Chapters</h2>
      </div>

      <p>
        Read independently
      </p>

    </div>


    <div class="chapter-grid">

      {
        researchVol01.pages.map((page) => (

          <a
            class="chapter-card"
            href={`/research/${page.id}`}
          >

            <div class="number">
              {page.label}
            </div>

            <div class="tag">
              {page.type}
            </div>

            <h3>
              {page.title}
            </h3>

            <p>
              {page.summary}
            </p>

            <span class="read-link">
              Read Chapter →
            </span>

          </a>

        ))
      }

    </div>

  </div>

</section>


<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">RESEARCH ECOSYSTEM</div>
      <h2>繼續探索</h2>
    </div>

  </div>


  <div class="grid">

    <a class="card ecosystem-card" href="/maps">
      <span class="tag">INDUSTRY MAPS</span>
      <h3>產業地圖 →</h3>
      <p>
        從技術節點與供應鏈位置繼續探索。
      </p>
    </a>

    <a class="card ecosystem-card" href="/posters">
      <span class="tag">POSTERS</span>
      <h3>研究海報 →</h3>
      <p>
        將研究內容濃縮成一頁式視覺化研究。
      </p>
    </a>

    <a
      class="card ecosystem-card"
      href={researchVol01.pdf}
      target="_blank"
    >
      <span class="tag">FIRST PRINTING</span>
      <h3>印刷級 PDF →</h3>
      <p>
        開啟 Research Vol.01 First Printing。
      </p>
    </a>

  </div>

</section>


<style>

  .research-intro {
    border: 1px solid #344457;
    background:
      linear-gradient(
        135deg,
        rgba(28,42,58,.95),
        rgba(14,21,30,.96)
      );
    border-radius: 20px;
    padding: 34px;
  }

  .research-intro p {
    max-width: 850px;
    color: #aeb9c6;
    font-size: 16px;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .button-secondary {
    display: inline-block;
    border: 1px solid #354457;
    border-radius: 9px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 800;
  }

  .chapter-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0,1fr));
    gap: 18px;
  }

  .chapter-card {
    border: 1px solid #2b394a;
    background: rgba(18,27,38,.82);
    border-radius: 18px;
    padding: 26px;
    transition: .2s ease;
  }

  .chapter-card:hover {
    border-color: #647184;
    transform: translateY(-2px);
  }

  .chapter-card .number {
    font-size: 13px;
    color: #7f9bb7;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .chapter-card .tag {
    display: inline-block;
    margin-top: 12px;
  }

  .chapter-card h3 {
    margin: 12px 0 8px;
    font-size: 22px;
  }

  .chapter-card p {
    color: #9eabb9;
  }

  .read-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 800;
  }

  .ecosystem-card {
    display: block;
    transition: .2s ease;
  }

  .ecosystem-card:hover {
    border-color: #647184;
    transform: translateY(-2px);
  }

  @media(max-width:800px) {

    .chapter-grid {
      grid-template-columns: 1fr;
    }

    .research-intro {
      padding: 26px;
    }

    .intro-actions {
      flex-direction: column;
    }

    .intro-actions a {
      text-align: center;
    }

  }

</style>

</BaseLayout>
