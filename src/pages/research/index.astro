---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Research Library｜J 的世界 Research";
const description =
  "J 的世界 Research｜Research Library · Evidence-Based Research";
---

<BaseLayout title={title} description={description}>

  <main class="research-index">

    <section class="hero">

      <div class="eyebrow">
        RESEARCH LIBRARY
      </div>

      <h1>
        AI Platform<br />
        Evolution
      </h1>

      <p class="lead">
        從事件、證據、技術、供應鏈、驗證到未來觀察，
        建立可持續更新的研究架構。
      </p>

      <div class="hero-tags">
        <span>FACTS FIRST</span>
        <span>EVIDENCE-BASED RESEARCH</span>
        <span>J INSIGHT</span>
      </div>

    </section>


    <section class="research-architecture">

      <div class="section-label">
        RESEARCH ARCHITECTURE
      </div>

      <div class="architecture">

        <a href="/research/p1/" class="node">
          <strong>P1</strong>
          <span>Story</span>
          <small>EVENT</small>
        </a>

        <div class="arrow">→</div>

        <a href="/research/p2/" class="node">
          <strong>P2</strong>
          <span>Evidence</span>
          <small>EVIDENCE</small>
        </a>

        <div class="arrow">→</div>

        <a href="/research/p3/" class="node">
          <strong>P3</strong>
          <span>AI Platform</span>
          <small>EVOLUTION</small>
        </a>

        <div class="arrow">→</div>

        <a href="/research/p4/" class="node">
          <strong>P4</strong>
          <span>Technology</span>
          <small>TECHNOLOGY</small>
        </a>

      </div>

      <div class="architecture second-row">

        <a href="/research/p5/" class="node">
          <strong>P5</strong>
          <span>Glass Core</span>
          <small>SUPPLY CHAIN</small>
        </a>

        <div class="arrow">→</div>

        <a href="/research/p6/" class="node">
          <strong>P6</strong>
          <span>Investment Matrix</span>
          <small>VALIDATION</small>
        </a>

        <div class="arrow">→</div>

        <a href="/research/p7/" class="node">
          <strong>P7</strong>
          <span>Future Watch</span>
          <small>FUTURE</small>
        </a>

        <div class="arrow">→</div>

        <a href="/research/p8/" class="node">
          <strong>P8</strong>
          <span>Methodology</span>
          <small>REFERENCE</small>
        </a>

      </div>

    </section>


    <!-- =========================
         RESEARCH DATABASE
    ========================= -->

    <section class="database">

      <div class="section-label">
        RESEARCH DATABASE
      </div>

      <div class="database-grid">

        <a href="/companies/" class="database-card">

          <div class="card-number">
            01
          </div>

          <div>
            <h2>Companies</h2>

            <p>
              從研究主題進一步拆解至企業、
              技術角色與供應鏈位置。
            </p>
          </div>

          <span class="card-link">
            COMPANY DATABASE →
          </span>

        </a>


        <a href="/maps/" class="database-card">

          <div class="card-number">
            02
          </div>

          <div>
            <h2>Industry Maps</h2>

            <p>
              將 AI、Glass Core、CPO
              與高速互連產業鏈視覺化。
            </p>
          </div>

          <span class="card-link">
            INDUSTRY MAPS →
          </span>

        </a>


        <a href="/posters/" class="database-card">

          <div class="card-number">
            03
          </div>

          <div>
            <h2>Posters</h2>

            <p>
              將研究內容轉化為
              可快速閱讀的視覺研究資料。
            </p>
          </div>

          <span class="card-link">
            VISUAL RESEARCH →
          </span>

        </a>


        <a href="/downloads/" class="database-card">

          <div class="card-number">
            04
          </div>

          <div>
            <h2>First Printing</h2>

            <p>
              Research Vol.01
              出版級 PDF 研究版本。
            </p>
          </div>

          <span class="card-link">
            DOWNLOAD PDF →
          </span>

        </a>

      </div>

    </section>


    <!-- =========================
         RESEARCH FLOW
    ========================= -->

    <section class="research-flow">

      <div class="section-label">
        RESEARCH FLOW
      </div>

      <h2>
        From Evidence<br />
        to Intelligence
      </h2>

      <div class="flow">

        <div>
          <strong>EVENT</strong>
          <span>事件</span>
        </div>

        <b>→</b>

        <div>
          <strong>EVIDENCE</strong>
          <span>證據</span>
        </div>

        <b>→</b>

        <div>
          <strong>TECHNOLOGY</strong>
          <span>技術</span>
        </div>

        <b>→</b>

        <div>
          <strong>COMPANY</strong>
          <span>企業</span>
        </div>

        <b>→</b>

        <div>
          <strong>SUPPLY CHAIN</strong>
          <span>供應鏈</span>
        </div>

        <b>→</b>

        <div>
          <strong>VALIDATION</strong>
          <span>驗證</span>
        </div>

        <b>→</b>

        <div>
          <strong>FUTURE WATCH</strong>
          <span>未來</span>
        </div>

      </div>

    </section>


    <section class="methodology">

      <div>

        <span class="section-label">
          RESEARCH PRINCIPLE
        </span>

        <h2>
          Facts First.
        </h2>

      </div>

      <p>
        公開資訊、研究推論與市場觀察分開呈現。
        J Insight 僅用於標示基於公開證據形成的研究推論，
        不將推論視為已確認事實。
      </p>

    </section>

  </main>

</BaseLayout>


<style>

  .research-index {
    max-width: 1180px;

    margin: 0 auto;

    padding:
      70px 24px 100px;
  }


  .hero {
    padding:
      45px 0 70px;

    border-bottom:
      1px solid rgba(255,255,255,.1);
  }

  .eyebrow,
  .section-label {
    color: #788595;

    font-size: .68rem;
    font-weight: 800;

    letter-spacing: .16em;
  }

  .hero h1 {
    margin:
      20px 0;

    font-size:
      clamp(3.2rem, 8vw, 6.8rem);

    line-height: .92;

    letter-spacing: -.06em;
  }

  .lead {
    max-width: 700px;

    color: #a6b0bc;

    font-size: 1.1rem;

    line-height: 1.85;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-top: 28px;
  }

  .hero-tags span {
    padding:
      7px 10px;

    border:
      1px solid rgba(255,255,255,.1);

    border-radius: 999px;

    color: #aeb8c4;

    font-size: .65rem;
  }


  /* =========================
     ARCHITECTURE
  ========================= */

  .research-architecture {
    padding:
      55px 0;
  }

  .architecture {
    display: grid;

    grid-template-columns:
      1fr 35px 1fr 35px 1fr 35px 1fr;

    align-items: stretch;

    gap: 8px;

    margin-top: 20px;
  }

  .architecture.second-row {
    margin-top: 8px;
  }

  .node {
    min-height: 110px;

    padding: 18px;

    border:
      1px solid rgba(255,255,255,.1);

    border-radius: 12px;

    background:
      rgba(255,255,255,.025);

    color: inherit;

    text-decoration: none;
  }

  .node:hover {
    border-color:
      rgba(255,255,255,.25);
  }

  .node strong {
    display: block;

    margin-bottom: 8px;

    color: #dfe5eb;

    font-size: .72rem;
  }

  .node span {
    display: block;

    color: #aeb8c4;

    font-size: .82rem;
  }

  .node small {
    display: block;

    margin-top: 14px;

    color: #687482;

    font-size: .58rem;

    letter-spacing: .1em;
  }

  .arrow {
    display: flex;

    align-items: center;
    justify-content: center;

    color: #5d6875;

    font-size: .8rem;
  }


  /* =========================
     DATABASE
  ========================= */

  .database {
    padding:
      55px 0;

    border-top:
      1px solid rgba(255,255,255,.1);
  }

  .database-grid {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 12px;

    margin-top: 20px;
  }

  .database-card {
    position: relative;

    min-height: 220px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: 28px;

    border:
      1px solid rgba(255,255,255,.1);

    border-radius: 16px;

    background:
      rgba(255,255,255,.025);

    color: inherit;

    text-decoration: none;

    transition:
      transform .2s ease,
      border-color .2s ease;
  }

  .database-card:hover {
    transform: translateY(-3px);

    border-color:
      rgba(255,255,255,.25);
  }

  .card-number {
    color: #65717f;

    font-size: .7rem;
    font-weight: 700;

    letter-spacing: .1em;
  }

  .database-card h2 {
    margin:
      25px 0 8px;

    font-size: 1.7rem;

    letter-spacing: -.035em;
  }

  .database-card p {
    max-width: 440px;

    margin: 0;

    color: #8f9aa7;

    line-height: 1.75;

    font-size: .82rem;
  }

  .card-link {
    margin-top: 25px;

    color: #8d99a7;

    font-size: .65rem;
    font-weight: 700;

    letter-spacing: .08em;
  }


  /* =========================
     FLOW
  ========================= */

  .research-flow {
    padding:
      55px 0;

    border-top:
      1px solid rgba(255,255,255,.1);
  }

  .research-flow h2 {
    margin:
      12px 0 35px;

    font-size:
      clamp(2rem, 5vw, 4rem);

    line-height: 1;

    letter-spacing: -.05em;
  }

  .flow {
    display: flex;

    align-items: center;

    gap: 12px;

    overflow-x: auto;

    padding-bottom: 8px;
  }

  .flow div {
    min-width: 125px;

    padding: 15px;

    border:
      1px solid rgba(255,255,255,.09);

    border-radius: 10px;
  }

  .flow strong {
    display: block;

    color: #cfd7df;

    font-size: .62rem;

    letter-spacing: .08em;
  }

  .flow span {
    display: block;

    margin-top: 5px;

    color: #707c89;

    font-size: .68rem;
  }

  .flow b {
    color: #5c6875;

    font-size: .75rem;
  }


  /* =========================
     METHODOLOGY
  ========================= */

  .methodology {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 60px;

    padding:
      55px 0;

    border-top:
      1px solid rgba(255,255,255,.1);
  }

  .methodology h2 {
    margin-top: 12px;

    font-size: 2.4rem;

    letter-spacing: -.045em;
  }

  .methodology p {
    margin: 0;

    color: #8f9aa7;

    line-height: 1.9;

    font-size: .86rem;
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 900px) {

    .architecture {
      grid-template-columns:
        1fr 25px 1fr;
    }

    .architecture .node:nth-of-type(4) {
      display: none;
    }

  }


  @media (max-width: 650px) {

    .research-index {
      padding:
        40px 18px 70px;
    }

    .architecture {
      grid-template-columns:
        1fr;
    }

    .architecture .arrow {
      display: none;
    }

    .architecture .node:nth-of-type(4) {
      display: block;
    }

    .database-grid {
      grid-template-columns:
        1fr;
    }

    .methodology {
      grid-template-columns:
        1fr;

      gap: 25px;
    }

  }

</style>
