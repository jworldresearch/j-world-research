---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Research Library｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">RESEARCH LIBRARY · V1.2-01</div>

    <h1>Research Library</h1>

    <p>
      以研究事件為起點，整理技術、供應鏈、
      Evidence 與產業推論。
      每一份研究都將成為《J 的世界 Research》的長期研究資產。
    </p>

  </div>

</section>


<!-- =========================================================
     FEATURED RESEARCH
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">FEATURED RESEARCH</div>
      <h2>本期研究</h2>
    </div>

    <p>Research Edition · Vol.01</p>

  </div>


  <article class="featured-card">

    <div class="featured-main">

      <span class="tag">VOL.01 · RESEARCH</span>

      <h3>AI Platform Evolution</h3>

      <p class="featured-description">
        從台積電 2026 China Technology Symposium 出發，
        追蹤 AI Platform 如何由先進製程、先進封裝、
        光互連、Glass Core、材料設備，
        一路演進至 AI Infrastructure。
      </p>


      <div class="research-meta">

        <span>VOL.01</span>
        <span>P1–P8</span>
        <span>Facts First</span>
        <span>Evidence-Based Research</span>

      </div>


      <div class="featured-actions">

        <a
          class="button"
          href="/research/ai-platform-evolution"
        >
          閱讀完整研究 →
        </a>

        <a
          class="button-secondary"
          href="/maps"
        >
          Industry Maps
        </a>

        <a
          class="button-secondary"
          href="/posters"
        >
          Posters
        </a>

      </div>

    </div>


    <div class="featured-index">

      <div class="index-label">
        RESEARCH STRUCTURE
      </div>

      <div class="index-row">
        <span>P1</span>
        <strong>Story</strong>
      </div>

      <div class="index-row">
        <span>P2</span>
        <strong>Evidence</strong>
      </div>

      <div class="index-row">
        <span>P3</span>
        <strong>AI Platform</strong>
      </div>

      <div class="index-row">
        <span>P4</span>
        <strong>Technology</strong>
      </div>

      <div class="index-row">
        <span>P5</span>
        <strong>Glass Core</strong>
      </div>

      <div class="index-row">
        <span>P6</span>
        <strong>Investment Matrix</strong>
      </div>

      <div class="index-row">
        <span>P7</span>
        <strong>Future Watch</strong>
      </div>

      <div class="index-row">
        <span>P8</span>
        <strong>Methodology</strong>
      </div>

    </div>

  </article>

</section>


<!-- =========================================================
     RESEARCH EDITIONS
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">RESEARCH EDITIONS</div>
        <h2>Research Editions</h2>
      </div>

      <p>Published Research</p>

    </div>


    <div class="grid">


      <article class="card research-card">

        <div class="card-topline">
          <span class="tag">VOL.01</span>
          <span class="status">PUBLISHED</span>
        </div>

        <h3>AI Platform Evolution</h3>

        <p>
          從技術論壇出發，
          建立下一代 AI Platform 的研究框架，
          並拆解先進製程、封裝、光互連、
          Glass Core 與 Infrastructure。
        </p>

        <div class="card-tags">
          <span>AI</span>
          <span>Advanced Packaging</span>
          <span>CPO</span>
          <span>Glass Core</span>
        </div>

        <a
          class="button-secondary"
          href="/research/ai-platform-evolution"
        >
          Open Research →
        </a>

      </article>


      <article class="card research-card upcoming">

        <div class="card-topline">
          <span class="tag">VOL.02</span>
          <span class="status">NEXT</span>
        </div>

        <h3>Next Research Edition</h3>

        <p>
          下一份 Research Edition
          將延續 Facts First、
          Evidence-Based Research
          的研究方法。
        </p>

        <div class="card-tags">
          <span>Research</span>
          <span>Technology</span>
          <span>Supply Chain</span>
        </div>

        <span class="coming">
          COMING NEXT
        </span>

      </article>


    </div>

  </div>

</section>


<!-- =========================================================
     TECHNOLOGY BRIEFS
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">TECHNOLOGY BRIEFS</div>
      <h2>Technology Briefs</h2>
    </div>

    <p>Short-form Research</p>

  </div>


  <div class="grid">


    <article class="card brief-card">

      <span class="tag">ADVANCED PACKAGING</span>

      <h3>CoWoS / SoIC</h3>

      <p>
        追蹤 AI 加速器持續提高運算密度後，
        先進封裝在系統整合中的角色。
      </p>

      <span class="brief-status">
        RESEARCH TRACK
      </span>

    </article>


    <article class="card brief-card">

      <span class="tag">OPTICAL</span>

      <h3>CPO Commercialization</h3>

      <p>
        從 Optical Engine、
        Switch 到 Fiber，
        觀察 CPO 商業化的技術與供應鏈條件。
      </p>

      <span class="brief-status">
        RESEARCH TRACK
      </span>

    </article>


    <article class="card brief-card">

      <span class="tag">GLASS CORE</span>

      <h3>Glass Core Ecosystem</h3>

      <p>
        從 Glass、TGV、Metallization
        到 Advanced Packaging，
        建立 Glass Core 技術路徑。
      </p>

      <span class="brief-status">
        RESEARCH TRACK
      </span>

    </article>


  </div>

</section>


<!-- =========================================================
     SPECIAL REPORTS
========================================================= -->

<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">SPECIAL REPORTS</div>
        <h2>Special Reports</h2>
      </div>

      <p>Deep Research</p>

    </div>


    <article class="special-card">

      <div>

        <span class="tag">SPECIAL REPORT</span>

        <h3>
          深度產業研究將於此發布
        </h3>

        <p>
          未來針對重要產業事件、
          技術突破與供應鏈結構，
          將以 Special Report 形式發布。
        </p>

      </div>

      <div class="special-note">

        <strong>RESEARCH STANDARD</strong>

        <p>
          Facts First<br />
          Evidence-Based Research<br />
          Inference Clearly Marked
        </p>

      </div>

    </article>

  </div>

</section>


<!-- =========================================================
     RESEARCH NAVIGATION
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">RESEARCH ASSETS</div>
      <h2>研究資產</h2>
    </div>

    <p>Read · Map · Visualize · Print</p>

  </div>


  <div class="grid">


    <article class="card asset-card">

      <span class="tag">01 · READ</span>

      <h3>Research</h3>

      <p>
        完整閱讀研究文章與研究方法。
      </p>

      <a
        class="button-secondary"
        href="/research/ai-platform-evolution"
      >
        Read Research →
      </a>

    </article>


    <article class="card asset-card">

      <span class="tag">02 · MAP</span>

      <h3>Industry Maps</h3>

      <p>
        將研究轉換成技術與供應鏈地圖。
      </p>

      <a
        class="button-secondary"
        href="/maps"
      >
        Explore Maps →
      </a>

    </article>


    <article class="card asset-card">

      <span class="tag">03 · VISUAL</span>

      <h3>Posters</h3>

      <p>
        以一頁式視覺化方式快速掌握研究。
      </p>

      <a
        class="button-secondary"
        href="/posters"
      >
        Explore Posters →
      </a>

    </article>


    <article class="card asset-card">

      <span class="tag">04 · PRINT</span>

      <h3>First Printing</h3>

      <p>
        保存完整 Research Edition
        的印刷級 PDF。
      </p>

      <a
        class="button-secondary"
        href="/downloads"
      >
        Open Downloads →
      </a>

    </article>


  </div>

</section>


<!-- =========================================================
     EDITORIAL STANDARD
========================================================= -->

<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">EDITORIAL STANDARD</div>
      <h2>研究方法不變</h2>
    </div>

  </div>


  <article class="standard-card">

    <div class="standard-item">

      <span>01</span>

      <div>
        <strong>FACTS FIRST</strong>

        <p>
          公開資訊、官方資料與公司揭露優先。
        </p>
      </div>

    </div>


    <div class="standard-item">

      <span>02</span>

      <div>
        <strong>EVIDENCE-BASED</strong>

        <p>
          技術、供應鏈、驗證與量產進度交叉檢視。
        </p>
      </div>

    </div>


    <div class="standard-item">

      <span>03</span>

      <div>
        <strong>INFERENCE</strong>

        <p>
          尚未確認的內容明確標示為產業推論。
        </p>
      </div>

    </div>

  </article>

</section>


<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">RESEARCH LIBRARY</div>

      <h2>研究，不只是一次閱讀。</h2>

      <p>
        每一份 Research、Map、Poster 與 PDF，
        都將成為可以持續更新與交叉驗證的研究資產。
      </p>

    </div>

    <a
      class="button"
      href="/research/ai-platform-evolution"
    >
      開始閱讀 Vol.01 →
    </a>

  </div>

</section>


<style>

  .featured-card {
    display: grid;
    grid-template-columns: 1fr 330px;
    gap: 40px;
    border: 1px solid #344457;
    border-radius: 20px;
    padding: 36px;
    background:
      linear-gradient(
        135deg,
        rgba(28,42,58,.96),
        rgba(14,21,30,.98)
      );
  }

  .featured-main h3 {
    font-size: 38px;
    margin: 12px 0;
  }

  .featured-description {
    color: #aeb9c6;
    max-width: 760px;
  }

  .research-meta,
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .research-meta span,
  .card-tags span {
    border: 1px solid #354457;
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 12px;
    color: #aebdcb;
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }


  .featured-index {
    border: 1px solid #2b394a;
    border-radius: 14px;
    background: #0b1119;
    padding: 20px;
  }

  .index-label {
    font-size: 11px;
    color: #7188a0;
    letter-spacing: .14em;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .index-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 10px 0;
    border-bottom: 1px solid #202d3b;
    font-size: 13px;
  }

  .index-row:last-child {
    border-bottom: 0;
  }

  .index-row span {
    color: #64778b;
  }

  .index-row strong {
    color: #d2dce6;
    font-weight: 600;
  }


  .research-card {
    min-height: 330px;
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .status {
    font-size: 10px;
    letter-spacing: .12em;
    color: #7892ab;
    font-weight: 800;
  }

  .research-card h3 {
    font-size: 24px;
    margin-top: 18px;
  }

  .research-card .button-secondary {
    display: inline-block;
    margin-top: 20px;
  }

  .upcoming {
    opacity: .72;
  }

  .coming {
    display: inline-block;
    margin-top: 22px;
    color: #65788b;
    font-size: 11px;
    letter-spacing: .14em;
    font-weight: 800;
  }


  .brief-card {
    min-height: 260px;
  }

  .brief-card h3 {
    font-size: 22px;
    margin: 13px 0 8px;
  }

  .brief-card p {
    color: #aeb9c6;
  }

  .brief-status {
    display: inline-block;
    margin-top: 20px;
    color: #7188a0;
    font-size: 10px;
    letter-spacing: .12em;
    font-weight: 800;
  }


  .special-card {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 40px;
    border: 1px solid #2b394a;
    border-radius: 18px;
    padding: 30px;
    background: #0e151e;
  }

  .special-card h3 {
    font-size: 25px;
    margin: 12px 0;
  }

  .special-card p {
    color: #aeb9c6;
  }

  .special-note {
    border-left: 1px solid #2b394a;
    padding-left: 28px;
  }

  .special-note strong {
    color: #8fa6bf;
    font-size: 11px;
    letter-spacing: .12em;
  }


  .asset-card {
    min-height: 230px;
  }

  .asset-card h3 {
    margin-top: 14px;
  }

  .asset-card .button-secondary {
    display: inline-block;
    margin-top: 16px;
  }


  .standard-card {
    border: 1px solid #2b394a;
    border-radius: 18px;
    background: #0e151e;
    overflow: hidden;
  }

  .standard-item {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 20px;
    padding: 24px 28px;
    border-bottom: 1px solid #263242;
  }

  .standard-item:last-child {
    border-bottom: 0;
  }

  .standard-item > span {
    font-size: 20px;
    color: #526981;
    font-weight: 800;
  }

  .standard-item strong {
    color: #dce5ee;
    font-size: 12px;
    letter-spacing: .12em;
  }

  .standard-item p {
    margin: 5px 0 0;
    color: #8795a5;
  }


  @media(max-width:800px) {

    .featured-card {
      grid-template-columns: 1fr;
      padding: 26px;
    }

    .featured-main h3 {
      font-size: 30px;
    }

    .featured-actions {
      flex-direction: column;
    }

    .featured-actions .button,
    .featured-actions .button-secondary {
      text-align: center;
    }

    .special-card {
      grid-template-columns: 1fr;
    }

    .special-note {
      border-left: 0;
      border-top: 1px solid #2b394a;
      padding-left: 0;
      padding-top: 20px;
    }

    .standard-item {
      grid-template-columns: 45px 1fr;
      padding: 22px;
      gap: 12px;
    }

  }

</style>

</BaseLayout>
