<style>
.research-card,.warning-card{border:1px solid #344457;background:rgba(18,27,38,.82);border-radius:18px;padding:34px}
.research-card li{margin:10px 0;color:#aeb9c6}
.warning-card{border-color:#40536a}
.warning-card h2{font-size:31px;margin:12px 0 20px}
.warning-card p{color:#aeb9c6;max-width:850px}
.completion-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.completion-grid a{border:1px solid #354457;border-radius:10px;background:#121c28;padding:16px;color:#d9e2ec;font-weight:700;display:flex;flex-direction:column;gap:5px}
.completion-grid span{font-size:11px;color:#7f9bb7}
.research-nav{max-width:1180px;margin:auto;padding:0 24px 70px;display:flex;justify-content:space-between;gap:20px}
.research-nav a{color:#b8c8d9;font-weight:700}
@media(max-width:800px){.research-card,.warning-card{padding:25px}.completion-grid{grid-template-columns:repeat(2,1fr)}.research-nav{flex-wrap:wrap}}
</style>
