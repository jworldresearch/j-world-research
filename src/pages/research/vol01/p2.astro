---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="P2｜Evidence">

<section class="page-hero">
  <div class="page-hero-inner">
    <div class="kicker">VOL.01 · P2 · EVIDENCE</div>
    <h1>先把事實與推論分開</h1>
    <p>Facts First · Evidence-Based Research</p>
  </div>
</section>

<section class="section">
  <div class="grid">

    <article class="card reading">
      <span class="tag">FACT</span>
      <h2>先進製程</h2>
      <p>
        台積電持續推進 3nm、2nm、A16、A14
        等先進製程技術。
      </p>
    </article>

    <article class="card reading">
      <span class="tag">FACT</span>
      <h2>3DFabric</h2>
      <p>
        SoIC、InFO、CoWoS 與 SoW
        構成先進封裝與異質整合的重要技術路徑。
      </p>
    </article>

    <article class="card reading">
      <span class="tag">INFERENCE</span>
      <h2>系統瓶頸</h2>
      <p>
        當製程與封裝同步升級，
        互連、材料、散熱與電力的重要性同步提升。
      </p>
    </article>

  </div>
</section>

<section class="page-nav">
  <a href="/research/vol01/p1">← P1</a>
  <a href="/research/vol01">Vol.01 Index</a>
  <a href="/research/vol01/p3">P3 →</a>
</section>

</BaseLayout>
