---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Research Vol.01｜J 的世界 Research">

<section class="page-hero">
  <div class="page-hero-inner">
    <div class="kicker">RESEARCH LIBRARY · VOL.01</div>
    <h1>AI Platform Evolution</h1>
    <p>
      從台積電 2026 China Technology Symposium 出發，
      拆解下一代 AI Platform 的技術演進與產業鏈。
    </p>
  </div>
</section>

<section class="section">

  <div class="section-head">
    <div>
      <div class="kicker">VOL.01 · P1–P8</div>
      <h2>研究目錄</h2>
    </div>
    <a class="button" href="/downloads">
      First Printing PDF →
    </a>
  </div>

  <div class="grid">

    <a class="card page-card" href="/research/vol01/p1">
      <span class="tag">P1 · STORY</span>
      <h3>從一場技術論壇開始</h3>
      <p>2026.06.25 TSMC China Technology Symposium。</p>
      <span class="read">Read P1 →</span>
    </a>

    <a class="card page-card" href="/research/vol01/p2">
      <span class="tag">P2 · EVIDENCE</span>
      <h3>先把事實與推論分開</h3>
      <p>建立 Facts First 的研究框架。</p>
      <span class="read">Read P2 →</span>
    </a>

    <a class="card page-card" href="/research/vol01/p3">
      <span class="tag">P3 · AI PLATFORM</span>
      <h3>四個訊號如何共同打造下一代 AI 平台？</h3>
      <p>Compute、Packaging、Optical、Infrastructure。</p>
      <span class="read">Read P3 →</span>
    </a>

    <a class="card page-card" href="/research/vol01/p4">
      <span class="tag">P4 · TECHNOLOGY</span>
      <h3>從晶片走向系統</h3>
      <p>AI Compute → Process → Packaging → Optical → Power → System。</p>
      <span class="read">Read P4 →</span>
    </a>

    <a class="card page-card" href="/research/vol01/p5">
      <span class="tag">P5 · GLASS CORE</span>
      <h3>Glass Core：結果，而不是起點</h3>
      <p>Glass、TGV、Core Substrate 與先進封裝。</p>
      <span class="read">Read P5 →</span>
    </a>

    <a class="card page-card" href="/research/vol01/p6">
      <span class="tag">P6 · INVESTMENT MATRIX</span>
      <h3>技術節點如何轉換成產業觀察？</h3>
      <p>Process、Packaging、Optical、Materials、Infrastructure、System。</p>
      <span class="read">Read P6 →</span>
    </a>

    <a class="card page-card" href="/research/vol01/p7">
      <span class="tag">P7 · FUTURE WATCH</span>
      <h3>下一個真正值得驗證的訊號</h3>
      <p>驗證、導入、量產與擴散。</p>
      <span class="read">Read P7 →</span>
    </a>

    <a class="card page-card" href="/research/vol01/p8">
      <span class="tag">P8 · METHODOLOGY</span>
      <h3>Reference & Methodology</h3>
      <p>研究方法、Evidence Framework 與免責聲明。</p>
      <span class="read">Read P8 →</span>
    </a>

  </div>

</section>

<section class="feature">
  <div class="section">

    <div class="section-head">
      <div>
        <div class="kicker">CONNECTED RESEARCH</div>
        <h2>延伸閱讀</h2>
      </div>
    </div>

    <div class="grid">

      <a class="card" href="/maps">
        <span class="tag">INDUSTRY MAPS</span>
        <h3>產業地圖</h3>
        <p>將 Research Vol.01 的技術路徑延伸至 AI、Glass Core 與 CPO。</p>
        <span class="read">Explore Maps →</span>
      </a>

      <a class="card" href="/posters">
        <span class="tag">POSTERS</span>
        <h3>研究海報</h3>
        <p>將研究內容濃縮成一頁式視覺化研究。</p>
        <span class="read">Explore Posters →</span>
      </a>

      <a class="card" href="/downloads">
        <span class="tag">FIRST PRINTING</span>
        <h3>印刷級 PDF</h3>
        <p>閱讀完整 Research Vol.01 First Printing。</p>
        <span class="read">Open PDF Library →</span>
      </a>

    </div>

  </div>
</section>

<style>
  .page-card {
    display: block;
    transition: transform .2s ease, border-color .2s ease;
  }

  .page-card:hover {
    transform: translateY(-4px);
    border-color: #52677e;
  }

  .read {
    display: inline-block;
    margin-top: 12px;
    color: #c7d5e4;
    font-size: 13px;
    font-weight: 700;
  }

  .card h3 {
    line-height: 1.35;
  }
</style>

</BaseLayout>
