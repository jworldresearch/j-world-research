---
import ResearchLayout from "../../layouts/ResearchLayout.astro";
---
<ResearchLayout title="P2｜Editor's Note｜J 的世界 Research" page="P2" section="EDITOR'S NOTE">
  <article class="poster-page" aria-label="J 的世界 Research P2｜Editor's Note">
    <div class="poster-wrap">
      <img
        src="/research-assets/P2-editorial-poster.png"
        alt="J 的世界 Research｜EDITORIAL｜為什麼想聊台積電 6/25 技術論壇？"
        class="poster"
      />

      <!-- 保留網站導覽：左上角品牌可回首頁 -->
      <a class="brand-link" href="/" aria-label="回到 J 的世界 Research 首頁"></a>

      <!-- 網站頁碼以 P2 為準；海報原稿左下角 P1 在網頁版覆蓋為 P2 -->
      <div class="page-number" aria-label="Page 2">P2</div>
    </div>
  </article>
</ResearchLayout>

<style>
  .poster-page {
    width: 100%;
    margin: 0;
  }

  .poster-wrap {
    position: relative;
    width: 100%;
    line-height: 0;
    background: #fff;
    overflow: hidden;
  }

  .poster {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    image-rendering: auto;
  }

  /* 左上角「J 的世界 Research」保持為真正可點擊的網站連結 */
  .brand-link {
    position: absolute;
    left: 2.7%;
    top: 1.25%;
    width: 14.5%;
    height: 3.3%;
    display: block;
    z-index: 5;
  }

  /* 僅修正網頁頁碼，不改動海報本身 */
  .page-number {
    position: absolute;
    left: 2.05%;
    bottom: 2.65%;
    width: 2.65%;
    aspect-ratio: 1.42 / 1;
    min-width: 28px;
    min-height: 20px;
    display: grid;
    place-items: center;
    background: #0b2747;
    color: #fff;
    font: 700 clamp(9px, 0.95vw, 18px)/1 Arial, Helvetica, sans-serif;
    letter-spacing: .02em;
    z-index: 6;
  }

  @media (max-width: 700px) {
    .brand-link {
      left: 2.5%;
      top: 1.1%;
      width: 18%;
      height: 4%;
    }

    .page-number {
      left: 2%;
      bottom: 2.35%;
      width: 4.4%;
      min-width: 24px;
      min-height: 18px;
      font-size: 9px;
    }
  }
</style>
