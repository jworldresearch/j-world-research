---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Posters｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">
      POSTER GALLERY · RESEARCH VISUALIZATION
    </div>

    <h1>研究海報</h1>

    <p>
      將複雜研究濃縮成一張圖，
      並讓每一張海報都能回到完整研究。
    </p>

  </div>

</section>


<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">VOL.01 · VISUAL RESEARCH</div>
      <h2>Research Posters</h2>
    </div>

    <p>AI Platform Evolution</p>

  </div>


  <div class="poster-grid">


    <!-- AI PLATFORM -->

    <article class="poster-card">

      <div class="poster-visual ai-platform">

        <span class="poster-kicker">
          J 的世界 RESEARCH · VOL.01
        </span>

        <strong>
          AI PLATFORM
        </strong>

        <span>
          EVOLUTION
        </span>

      </div>


      <div class="poster-body">

        <span class="tag">
          AI PLATFORM
        </span>

        <h3>
          AI Platform Evolution
        </h3>

        <p>
          從 Compute、Advanced Packaging、
          Optical Interconnect 到 Materials
          與 Infrastructure。
        </p>


        <div class="poster-links">

          <a
            class="button"
            href="/research/p3"
          >
            Read Research →
          </a>

          <a
            class="button-secondary"
            href="/maps"
          >
            Industry Maps
          </a>

        </div>

      </div>

    </article>


    <!-- GLASS CORE -->

    <article class="poster-card">

      <div class="poster-visual glass-core">

        <span class="poster-kicker">
          J 的世界 RESEARCH
        </span>

        <strong>
          GLASS
        </strong>

        <span>
          CORE
        </span>

      </div>


      <div class="poster-body">

        <span class="tag">
          GLASS CORE
        </span>

        <h3>
          Glass Core Ecosystem
        </h3>

        <p>
          Glass → TGV → Core Substrate
          → Advanced Packaging
          → AI Accelerator。
        </p>


        <div class="poster-links">

          <a
            class="button"
            href="/research/p5"
          >
            Read P5 →
          </a>

          <a
            class="button-secondary"
            href="/maps"
          >
            Industry Maps
          </a>

        </div>

      </div>

    </article>


    <!-- CPO -->

    <article class="poster-card">

      <div class="poster-visual cpo">

        <span class="poster-kicker">
          J 的世界 RESEARCH
        </span>

        <strong>
          CPO
        </strong>

        <span>
          ECOSYSTEM
        </span>

      </div>


      <div class="poster-body">

        <span class="tag">
          CPO
        </span>

        <h3>
          CPO Ecosystem
        </h3>

        <p>
          Switch → Optical Engine → CPO
          → Fiber → Data Center。
        </p>


        <div class="poster-links">

          <a
            class="button"
            href="/research/p3"
          >
            Read Research →
          </a>

          <a
            class="button-secondary"
            href="/maps"
          >
            Industry Maps
          </a>

        </div>

      </div>

    </article>

  </div>

</section>


<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">
          FIRST PRINTING
        </div>

        <h2>
          Research Vol.01
        </h2>

      </div>

      <p>
        P1–P8
      </p>

    </div>


    <div class="printing-card">

      <div>

        <span class="tag">
          PRINT EDITION
        </span>

        <h3>
          AI Platform Evolution
        </h3>

        <p>
          完整 Research Vol.01 印刷級版本，
          收錄 P1–P8 研究內容。
        </p>

      </div>


      <div class="printing-actions">

        <a
          class="button"
          href="/downloads/J的世界_Research_Vol01_First_Printing.pdf"
          target="_blank"
        >
          Open First Printing PDF →
        </a>

        <a
          class="button-secondary"
          href="/research"
        >
          Read Online Research
        </a>

      </div>

    </div>

  </div>

</section>


<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">
        RESEARCH ECOSYSTEM
      </div>

      <h2>
        三種方式，閱讀同一份研究
      </h2>

    </div>

  </div>


  <div class="grid">

    <a
      class="card ecosystem-card"
      href="/research"
    >

      <span class="tag">
        RESEARCH
      </span>

      <h3>
        深度閱讀 →
      </h3>

      <p>
        P1–P8 獨立閱讀架構。
      </p>

    </a>


    <a
      class="card ecosystem-card"
      href="/maps"
    >

      <span class="tag">
        INDUSTRY MAPS
      </span>

      <h3>
        結構化閱讀 →
      </h3>

      <p>
        從技術與供應鏈位置理解產業。
      </p>

    </a>


    <a
      class="card ecosystem-card"
      href="/downloads"
    >

      <span class="tag">
        DOWNLOADS
      </span>

      <h3>
        出版級閱讀 →
      </h3>

      <p>
        開啟 First Printing 完整 PDF。
      </p>

    </a>

  </div>

</section>


<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">
        RESEARCH VOL.01
      </div>

      <h2>
        一張海報，是研究的入口。
      </h2>

      <p>
        真正完整的答案，仍然回到 Research。
      </p>

    </div>


    <a
      class="button"
      href="/research"
    >
      Enter Research →
    </a>

  </div>

</section>


<style>

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .poster-card {
    overflow: hidden;
    border: 1px solid #2b394a;
    background: rgba(18,27,38,.82);
    border-radius: 18px;
  }

  .poster-visual {
    aspect-ratio: 3 / 4;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3px;

    border-bottom: 1px solid #2b394a;

    background:
      radial-gradient(
        circle at 70% 20%,
        #334a63,
        #0b1119 58%
      );
  }

  .poster-visual.glass-core {
    background:
      radial-gradient(
        circle at 30% 25%,
        #52687c,
        #0b1119 58%
      );
  }

  .poster-visual.cpo {
    background:
      radial-gradient(
        circle at 65% 65%,
        #40566d,
        #0b1119 58%
      );
  }

  .poster-kicker {
    font-size: 10px;
    letter-spacing: .13em;
    color: #9fb0c1;
  }

  .poster-visual strong {
    font-size: clamp(32px, 4vw, 48px);
    line-height: .95;
    letter-spacing: -.04em;
  }

  .poster-visual > span:last-child {
    font-size: 18px;
    letter-spacing: .12em;
    color: #b9c6d4;
  }

  .poster-body {
    padding: 24px;
  }

  .poster-body h3 {
    font-size: 21px;
    margin: 10px 0 8px;
  }

  .poster-body p {
    color: #9eabb9;
    font-size: 14px;
  }

  .poster-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .button-secondary {
    display: inline-block;
    border: 1px solid #354457;
    border-radius: 9px;
    padding: 9px 13px;
    font-size: 13px;
    font-weight: 800;
  }

  .printing-card {
    border: 1px solid #344457;
    background:
      linear-gradient(
        135deg,
        rgba(28,42,58,.95),
        rgba(14,21,30,.96)
      );
    border-radius: 20px;
    padding: 32px;

    display: grid;
    grid-template-columns: 1fr auto;
    gap: 35px;
    align-items: center;
  }

  .printing-card h3 {
    font-size: 28px;
    margin: 10px 0;
  }

  .printing-card p {
    color: #aeb9c6;
  }

  .printing-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 210px;
  }

  .printing-actions .button-secondary {
    text-align: center;
  }

  .ecosystem-card {
    display: block;
    transition: .2s ease;
  }

  .ecosystem-card:hover {
    border-color: #647184;
    transform: translateY(-2px);
  }

  @media(max-width:800px) {

    .poster-grid {
      grid-template-columns: 1fr;
    }

    .printing-card {
      grid-template-columns: 1fr;
      padding: 26px;
    }

    .printing-actions {
      min-width: 0;
    }

    .printing-actions a {
      text-align: center;
    }

    .poster-links {
      flex-direction: column;
    }

    .poster-links a {
      text-align: center;
    }

  }

</style>

</BaseLayout>
