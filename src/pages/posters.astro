---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Posters｜J 的世界 Research">

<section class="page-hero">

  <div class="page-hero-inner">

    <div class="kicker">POSTER GALLERY · VISUAL RESEARCH</div>

    <h1>研究海報</h1>

    <p>
      將複雜研究濃縮成一張圖。
      從 Research、Industry Maps 到一頁式視覺化研究。
    </p>

  </div>

</section>


<section class="section">

  <div class="section-head">

    <div>
      <div class="kicker">RESEARCH VOL.01</div>
      <h2>AI Platform Evolution</h2>
    </div>

    <p>Visual Research</p>

  </div>


  <div class="poster-grid">


    <!-- AI PLATFORM -->

    <article class="poster-item">

      <div class="poster-placeholder">

        <span class="poster-kicker">
          RESEARCH VOL.01
        </span>

        <strong>AI PLATFORM</strong>

        <span class="poster-subtitle">
          AI Platform Evolution
        </span>

      </div>

      <div class="poster-info">

        <span class="tag">01 · AI PLATFORM</span>

        <h3>AI Platform Evolution</h3>

        <p>
          從先進製程、先進封裝，
          延伸至光互連、材料、電力與散熱，
          建立下一代 AI Platform 的完整技術路徑。
        </p>

        <div class="poster-actions">

          <a class="button-secondary" href="/research">
            Read Full Research →
          </a>

          <a class="button-secondary" href="/maps">
            Industry Maps →
          </a>

        </div>

      </div>

    </article>


    <!-- GLASS CORE -->

    <article class="poster-item">

      <div class="poster-placeholder">

        <span class="poster-kicker">
          ADVANCED PACKAGING
        </span>

        <strong>GLASS CORE</strong>

        <span class="poster-subtitle">
          Glass Core Ecosystem
        </span>

      </div>

      <div class="poster-info">

        <span class="tag">02 · GLASS CORE</span>

        <h3>Glass Core Ecosystem</h3>

        <p>
          從 Glass、TGV、Metallization、
          Core Substrate 到 Advanced Packaging，
          追蹤 Glass Core 的技術與供應鏈位置。
        </p>

        <div class="poster-actions">

          <a class="button-secondary" href="/research">
            Read Research →
          </a>

          <a class="button-secondary" href="/maps">
            Explore Map →
          </a>

        </div>

      </div>

    </article>


    <!-- CPO -->

    <article class="poster-item">

      <div class="poster-placeholder">

        <span class="poster-kicker">
          OPTICAL INTERCONNECT
        </span>

        <strong>CPO</strong>

        <span class="poster-subtitle">
          CPO Ecosystem
        </span>

      </div>

      <div class="poster-info">

        <span class="tag">03 · CPO</span>

        <h3>CPO Commercialization</h3>

        <p>
          從 AI Compute、Switch、
          Optical Engine 到 Fiber 與 Data Center，
          觀察 CPO 從技術走向商業化的關鍵節點。
        </p>

        <div class="poster-actions">

          <a class="button-secondary" href="/research">
            Read Research →
          </a>

          <a class="button-secondary" href="/maps">
            Explore Map →
          </a>

        </div>

      </div>

    </article>


  </div>

</section>


<section class="feature">

  <div class="section">

    <div class="section-head">

      <div>
        <div class="kicker">HOW TO USE</div>
        <h2>海報不是研究的終點</h2>
      </div>

      <p>Visual → Research → Evidence</p>

    </div>


    <div class="grid">


      <article class="card">

        <span class="tag">01 · VISUAL</span>

        <h3>先看全貌</h3>

        <p>
          用一張海報快速掌握技術路徑、
          產業鏈與主要研究問題。
        </p>

      </article>


      <article class="card">

        <span class="tag">02 · RESEARCH</span>

        <h3>再讀完整研究</h3>

        <p>
          回到 Research 閱讀完整的 P1–P8
          研究內容與方法論。
        </p>

      </article>


      <article class="card">

        <span class="tag">03 · EVIDENCE</span>

        <h3>最後檢視證據</h3>

        <p>
          透過 Industry Maps 與 Evidence Framework，
          區分量產、驗證、開發與 Inference。
        </p>

      </article>


    </div>

  </div>

</section>


<section class="cta">

  <div class="cta-inner">

    <div>

      <div class="kicker">RESEARCH LIBRARY</div>

      <h2>想深入研究？</h2>

      <p>
        從視覺化海報回到完整 Research，
        或直接查看研究資料庫。
      </p>

    </div>


    <div class="cta-actions">

      <a class="button" href="/research">
        Read Research →
      </a>

      <a class="button-secondary" href="/downloads">
        Downloads
      </a>

    </div>

  </div>

</section>


<style>

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .poster-item {
    border: 1px solid #2b394a;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(18, 27, 38, 0.82);
  }

  .poster-placeholder {
    aspect-ratio: 3 / 4;
    padding: 26px;
    background:
      radial-gradient(
        circle at 75% 20%,
        #2b425b 0,
        transparent 36%
      ),
      linear-gradient(
        145deg,
        #101a25,
        #0a1017
      );
    border-bottom: 1px solid #2b394a;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .poster-placeholder strong {
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .poster-kicker {
    color: #8fa6bf;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .poster-subtitle {
    color: #9eacbb;
    font-size: 13px;
  }

  .poster-info {
    padding: 24px;
  }

  .poster-info h3 {
    font-size: 21px;
    margin: 9px 0 7px;
  }

  .poster-info p {
    color: #aeb9c6;
    font-size: 14px;
  }

  .poster-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 18px;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media(max-width:900px) {

    .poster-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media(max-width:800px) {

    .poster-grid {
      grid-template-columns: 1fr;
    }

    .poster-placeholder {
      aspect-ratio: 16 / 10;
    }

    .poster-placeholder strong {
      font-size: 34px;
    }

    .poster-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .poster-actions .button-secondary {
      text-align: center;
    }

    .cta-actions {
      margin-top: 20px;
    }

  }

</style>

</BaseLayout>
